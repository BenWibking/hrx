// Independent runtime predicates select other predicates before materializing
// bytes. Partial output stores preserve the surrounding tile sentinel.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @predicate_select_full() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_rank, @select_full_predicates
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x16x256xi8>>
  %input_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %input_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %input_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_partition = partition.sender %input_sender, %input_partition_offset, %input_partition_rank, %input_partition_count : reg<aie2p.array.sender : tile<256xi8>>
  %worker_receiver_0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<256xi8>>
  %input_partition_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_channel_records = constant.u32 16 : reg<aie2p.array.scalar : index>
  %input_partition_channel = channel %input_partition, %worker_receiver_0, %input_partition_channel_capacity, %input_partition_channel_records : reg<aie2p.array.channel : tile<256xi8>>
  %worker_sender_1 = sender %worker, 1 : reg<aie2p.array.sender : tile<128xi8>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1x16x128xi8>>
  %output_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %output_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %output_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_partition = partition.receiver %output_receiver, %output_partition_offset, %output_partition_rank, %output_partition_count : reg<aie2p.array.receiver : tile<128xi8>>
  %worker_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_1_channel_records = constant.u32 16 : reg<aie2p.array.scalar : index>
  %worker_1_channel = channel %worker_sender_1, %output_partition, %worker_1_channel_capacity, %worker_1_channel_records : reg<aie2p.array.channel : tile<128xi8>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @select_full_predicates(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %true_origin = index.constant 64 : offset
  %false_origin = index.constant 128 : offset
  %mask_view = buffer.view %source[%origin] : buffer -> view<64xi8>
  %true_view = buffer.view %source[%true_origin] : buffer -> view<64xi8>
  %false_view = buffer.view %source[%false_origin] : buffer -> view<64xi8>
  %output_view = buffer.view %destination[%origin] : buffer -> view<128xi8>
  %result_view = buffer.view %destination[%origin] : buffer -> view<64xi8>
  %sentinel = vector.constant -91 : vector<64xi8>
  vector.store %sentinel, %output_view[0] : vector<64xi8>, view<128xi8>
  vector.store %sentinel, %output_view[64] : vector<64xi8>, view<128xi8>
  %mask_bytes = vector.load %mask_view[0] : view<64xi8> -> vector<64xi8>
  %true_bytes = vector.load %true_view[0] : view<64xi8> -> vector<64xi8>
  %false_bytes = vector.load %false_view[0] : view<64xi8> -> vector<64xi8>
  %zero = vector.constant 0 : vector<64xi8>
  %one = vector.constant 1 : vector<64xi8>
  %mask = vector.cmpi ne, %mask_bytes, %zero : vector<64xi8> -> vector<64xi1>
  %true_value = vector.cmpi ne, %true_bytes, %zero : vector<64xi8> -> vector<64xi1>
  %false_value = vector.cmpi ne, %false_bytes, %zero : vector<64xi8> -> vector<64xi1>
  %selected = vector.select %mask, %true_value, %false_value : vector<64xi1>
  %bytes = vector.select %selected, %one, %zero : vector<64xi8>
  vector.store %bytes, %result_view[0] : vector<64xi8>, view<64xi8>
  func.return
}

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @predicate_select_partial() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_rank, @select_partial_predicates
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x16x256xi8>>
  %input_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %input_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %input_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_partition = partition.sender %input_sender, %input_partition_offset, %input_partition_rank, %input_partition_count : reg<aie2p.array.sender : tile<256xi8>>
  %worker_receiver_0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<256xi8>>
  %input_partition_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_channel_records = constant.u32 16 : reg<aie2p.array.scalar : index>
  %input_partition_channel = channel %input_partition, %worker_receiver_0, %input_partition_channel_capacity, %input_partition_channel_records : reg<aie2p.array.channel : tile<256xi8>>
  %worker_sender_1 = sender %worker, 1 : reg<aie2p.array.sender : tile<128xi8>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1x16x128xi8>>
  %output_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %output_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %output_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_partition = partition.receiver %output_receiver, %output_partition_offset, %output_partition_rank, %output_partition_count : reg<aie2p.array.receiver : tile<128xi8>>
  %worker_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_1_channel_records = constant.u32 16 : reg<aie2p.array.scalar : index>
  %worker_1_channel = channel %worker_sender_1, %output_partition, %worker_1_channel_capacity, %worker_1_channel_records : reg<aie2p.array.channel : tile<128xi8>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @select_partial_predicates(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %true_origin = index.constant 64 : offset
  %false_origin = index.constant 128 : offset
  %mask_view = buffer.view %source[%origin] : buffer -> view<3x3xi8>
  %true_view = buffer.view %source[%true_origin] : buffer -> view<3x3xi8>
  %false_view = buffer.view %source[%false_origin] : buffer -> view<3x3xi8>
  %output_view = buffer.view %destination[%origin] : buffer -> view<128xi8>
  %result_view = buffer.view %destination[%origin] : buffer -> view<3x3xi8>
  %sentinel = vector.constant -91 : vector<64xi8>
  vector.store %sentinel, %output_view[0] : vector<64xi8>, view<128xi8>
  vector.store %sentinel, %output_view[64] : vector<64xi8>, view<128xi8>
  %mask_bytes = vector.load %mask_view[0, 0] : view<3x3xi8> -> vector<3x3xi8>
  %true_bytes = vector.load %true_view[0, 0] : view<3x3xi8> -> vector<3x3xi8>
  %false_bytes = vector.load %false_view[0, 0] : view<3x3xi8> -> vector<3x3xi8>
  %zero = vector.constant 0 : vector<3x3xi8>
  %one = vector.constant 1 : vector<3x3xi8>
  %mask = vector.cmpi ne, %mask_bytes, %zero : vector<3x3xi8> -> vector<3x3xi1>
  %true_value = vector.cmpi ne, %true_bytes, %zero : vector<3x3xi8> -> vector<3x3xi1>
  %false_value = vector.cmpi ne, %false_bytes, %zero : vector<3x3xi8> -> vector<3x3xi1>
  %selected = vector.select %mask, %true_value, %false_value : vector<3x3xi1>
  %bytes = vector.select %selected, %one, %zero : vector<3x3xi8>
  vector.store %bytes, %result_view[0, 0] : vector<3x3xi8>, view<3x3xi8>
  func.return
}
