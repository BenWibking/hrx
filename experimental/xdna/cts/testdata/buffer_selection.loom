aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @select_packets() asm {
  %worker_count = constant.u32 2 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_0_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_0 = worker %workers, %worker_0_rank, @select_entry
  %worker_1_rank = constant.u32 1 : reg<aie2p.array.scalar : index>
  %worker_1 = worker %workers, %worker_1_rank, @select_entry
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<2x5x256xi32>>
  %input_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %input_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %input_partition_count = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition = partition.sender %input_sender, %input_partition_offset, %input_partition_rank, %input_partition_count : reg<aie2p.array.sender : tile<256xi32>>
  %worker_0_receiver_0 = receiver %worker_0, 0 : reg<aie2p.array.receiver : tile<256xi32>>
  %input_partition_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_channel_records = constant.u32 5 : reg<aie2p.array.scalar : index>
  %input_partition_channel = channel %input_partition, %worker_0_receiver_0, %input_partition_channel_capacity, %input_partition_channel_records : reg<aie2p.array.channel : tile<256xi32>>
  %input_partition_1_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %input_partition_1_rank = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_partition_1_count = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_1 = partition.sender %input_sender, %input_partition_1_offset, %input_partition_1_rank, %input_partition_1_count : reg<aie2p.array.sender : tile<256xi32>>
  %worker_1_receiver_0 = receiver %worker_1, 0 : reg<aie2p.array.receiver : tile<256xi32>>
  %input_partition_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_1_channel_records = constant.u32 5 : reg<aie2p.array.scalar : index>
  %input_partition_1_channel = channel %input_partition_1, %worker_1_receiver_0, %input_partition_1_channel_capacity, %input_partition_1_channel_records : reg<aie2p.array.channel : tile<256xi32>>
  %worker_0_sender_1 = sender %worker_0, 1 : reg<aie2p.array.sender : tile<256xi32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<2x5x256xi32>>
  %output_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %output_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %output_partition_count = constant.u32 2 : reg<aie2p.array.scalar : index>
  %output_partition = partition.receiver %output_receiver, %output_partition_offset, %output_partition_rank, %output_partition_count : reg<aie2p.array.receiver : tile<256xi32>>
  %worker_0_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_0_1_channel_records = constant.u32 5 : reg<aie2p.array.scalar : index>
  %worker_0_1_channel = channel %worker_0_sender_1, %output_partition, %worker_0_1_channel_capacity, %worker_0_1_channel_records : reg<aie2p.array.channel : tile<256xi32>>
  %worker_1_sender_1 = sender %worker_1, 1 : reg<aie2p.array.sender : tile<256xi32>>
  %output_partition_1_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %output_partition_1_rank = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_partition_1_count = constant.u32 2 : reg<aie2p.array.scalar : index>
  %output_partition_1 = partition.receiver %output_receiver, %output_partition_1_offset, %output_partition_1_rank, %output_partition_1_count : reg<aie2p.array.receiver : tile<256xi32>>
  %worker_1_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_1_1_channel_records = constant.u32 5 : reg<aie2p.array.scalar : index>
  %worker_1_1_channel = channel %worker_1_sender_1, %output_partition_1, %worker_1_1_channel_capacity, %worker_1_1_channel_records : reg<aie2p.array.channel : tile<256xi32>>
  %worker_0_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_0_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker_0, %worker_0_column, %worker_0_row
  %worker_1_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_1_row = constant.u32 3 : reg<aie2p.array.scalar : index>
  constrain.location %worker_1, %worker_1_column, %worker_1_row
  return
}

func.def target(@core_target) @select_entry(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %zero = index.constant 0 : offset
  func.call @select_buffers(%source, %zero, %destination, %zero) : (buffer, offset, buffer, offset)
  func.return
}

func.decl @select_buffers(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset)
