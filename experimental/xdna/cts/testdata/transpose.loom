aie2p.target<array> @array_target
aie2p.target<core> @core_target

// Raw BF16 records include every 16-bit pattern and rotating exceptional lanes.
// Capacity-two rings wrap while the input and output bindings retain guards.
low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @transpose_packets() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 1056 : reg<aie2p.array.scalar : index>
  %origin = constant.u64 64 : reg<aie2p.array.offset : offset>
  %workers = group %one
  %worker = worker %workers, %zero, @transpose_bf16_packet
  constrain.location %worker, %zero, %row
  %input_binding = binding 0, "read"
  %output_binding = binding 1, "write"
  %all_input = sender %input_binding, 0 : reg<aie2p.array.sender : tile<1x1056x128xi8>>
  %all_output = receiver %output_binding, 0 : reg<aie2p.array.receiver : tile<1x1056x128xi8>>
  %input = partition.sender %all_input, %origin, %zero, %one : reg<aie2p.array.sender : tile<128xi8>>
  %output = partition.receiver %all_output, %origin, %zero, %one : reg<aie2p.array.receiver : tile<128xi8>>
  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<128xi8>>
  %worker_output = sender %worker, 1 : reg<aie2p.array.sender : tile<128xi8>>
  %input_channel = channel %input, %worker_input, %capacity, %records : reg<aie2p.array.channel : tile<128xi8>>
  %output_channel = channel %worker_output, %output, %capacity, %records : reg<aie2p.array.channel : tile<128xi8>>
  return
}

func.def target(@core_target) @transpose_bf16_packet(%input: buffer, %output: buffer) {
  %source = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %source[%base] : buffer -> view<64xbf16>
  %output_view = buffer.view %destination[%base] : buffer -> view<64xbf16>
  %packet = vector.load %input_view[0] : view<64xbf16> -> vector<64xbf16>
  %values = vector.bitcast %packet : vector<64xbf16> to vector<8x8xbf16>
  %transposed = vector.transpose<[1, 0]> %values : vector<8x8xbf16> -> vector<8x8xbf16>
  %result = vector.bitcast %transposed : vector<8x8xbf16> to vector<64xbf16>
  vector.store %result, %output_view[0] : vector<64xbf16>, view<64xbf16>
  func.return
}

// Seven records encode each lane ordinal across independent predicate bits.
// The worker emits the full-byte transpose followed by the predicate transpose.
low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @transpose_residual_packets() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 7 : reg<aie2p.array.scalar : index>
  %origin = constant.u64 64 : reg<aie2p.array.offset : offset>
  %workers = group %one
  %worker = worker %workers, %zero, @transpose_residual_packet
  constrain.location %worker, %zero, %row
  %input_binding = binding 0, "read"
  %output_binding = binding 1, "write"
  %all_input = sender %input_binding, 0 : reg<aie2p.array.sender : tile<1x7x128xi8>>
  %all_output = receiver %output_binding, 0 : reg<aie2p.array.receiver : tile<1x7x256xi8>>
  %input = partition.sender %all_input, %origin, %zero, %one : reg<aie2p.array.sender : tile<128xi8>>
  %output = partition.receiver %all_output, %origin, %zero, %one : reg<aie2p.array.receiver : tile<256xi8>>
  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<128xi8>>
  %worker_output = sender %worker, 1 : reg<aie2p.array.sender : tile<256xi8>>
  %input_channel = channel %input, %worker_input, %capacity, %records : reg<aie2p.array.channel : tile<128xi8>>
  %output_channel = channel %worker_output, %output, %capacity, %records : reg<aie2p.array.channel : tile<256xi8>>
  return
}

func.def target(@core_target) @transpose_residual_packet(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %input_origin = index.constant 0 : offset
  %predicate_origin = index.constant 128 : offset
  %input_view = buffer.view %source[%input_origin] : buffer -> view<8x16xi8>
  %ordinary_output_view = buffer.view %destination[%input_origin] : buffer -> view<16x8xi8>
  %predicate_output_view = buffer.view %destination[%predicate_origin] : buffer -> view<16x8xi8>
  %values = vector.load %input_view[0, 0] : view<8x16xi8> -> vector<8x16xi8>
  %ordinary = vector.transpose<[1, 0]> %values : vector<8x16xi8> -> vector<16x8xi8>
  vector.store %ordinary, %ordinary_output_view[0, 0] : vector<16x8xi8>, view<16x8xi8>
  %zero = vector.constant 0 : vector<8x16xi8>
  %predicate = vector.cmpi ne, %values, %zero : vector<8x16xi8> -> vector<8x16xi1>
  %transposed = vector.transpose<[1, 0]> %predicate : vector<8x16xi1> -> vector<16x8xi1>
  %result_zero = vector.constant 0 : vector<16x8xi8>
  %result_one = vector.constant 1 : vector<16x8xi8>
  %predicate_bytes = vector.select %transposed, %result_one, %result_zero : vector<16x8xi8>
  vector.store %predicate_bytes, %predicate_output_view[0, 0] : vector<16x8xi8>, view<16x8xi8>
  func.return
}
