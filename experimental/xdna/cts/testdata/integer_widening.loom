aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @widen_packets() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_rank, @widen_accumulator_boundary
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x16x256xi8>>
  %input_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %input_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %input_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_partition = partition.sender %input_sender, %input_partition_offset, %input_partition_rank, %input_partition_count : reg<aie2p.array.sender : tile<256xi8>>
  %worker_receiver_0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<256xi8>>
  %input_partition_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_channel_records = constant.u32 16 : reg<aie2p.array.scalar : index>
  %input_partition_channel = channel %input_partition, %worker_receiver_0, %input_partition_channel_capacity, %input_partition_channel_records : reg<aie2p.array.channel : tile<256xi8>>
  %worker_sender_1 = sender %worker, 1 : reg<aie2p.array.sender : tile<576xi8>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1x16x576xi8>>
  %output_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %output_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %output_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_partition = partition.receiver %output_receiver, %output_partition_offset, %output_partition_rank, %output_partition_count : reg<aie2p.array.receiver : tile<576xi8>>
  %worker_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_1_channel_records = constant.u32 16 : reg<aie2p.array.scalar : index>
  %worker_1_channel = channel %worker_sender_1, %output_partition, %worker_1_channel_capacity, %worker_1_channel_records : reg<aie2p.array.channel : tile<576xi8>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @widen_accumulator_boundary(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %source_i32 = buffer.view %source[%origin] : buffer -> view<64xi32>
  %source_f32 = buffer.view %source[%origin] : buffer -> view<64xf32>
  %destination_i32 = buffer.view %destination[%origin] : buffer -> view<144xi32>
  %destination_i64 = buffer.view %destination[%origin] : buffer -> view<72xi64>
  %sentinel = vector.constant -1515870811 : vector<16xi32>
  vector.store<volatile> %sentinel, %destination_i32[0] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[16] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[32] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[48] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[64] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[80] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[96] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[112] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[128] : vector<16xi32>, view<144xi32>
  %integers = vector.load %source_i32[0] : view<64xi32> -> vector<17xi32>
  %unsigned = vector.extui %integers : vector<17xi32> to vector<17xi64>
  %signed = vector.extsi %integers : vector<17xi32> to vector<17xi64>
  %values = vector.load %source_f32[24] : view<64xf32> -> vector<9xf32>
  %thresholds = vector.load %source_f32[48] : view<64xf32> -> vector<3xf32>
  %quantized = vector.table.quantize %values, %thresholds {nan = zero, tie = lower} : vector<9xf32>, vector<3xf32> -> vector<9xi64>
  vector.store %unsigned, %destination_i64[0] : vector<17xi64>, view<72xi64>
  vector.store %signed, %destination_i64[24] : vector<17xi64>, view<72xi64>
  vector.store %quantized, %destination_i64[48] : vector<9xi64>, view<72xi64>
  func.return
}
