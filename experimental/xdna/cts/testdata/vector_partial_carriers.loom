// A loop-carried vector remains a snapshot after its backing tile is poisoned.
// Slices and concatenations exercise carrier boundaries and partial tails.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @partial_carriers() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_rank, @slice_snapshot
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x16x256xi8>>
  %input_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %input_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %input_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_partition = partition.sender %input_sender, %input_partition_offset, %input_partition_rank, %input_partition_count : reg<aie2p.array.sender : tile<256xi8>>
  %worker_receiver_0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<256xi8>>
  %input_partition_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_channel_records = constant.u32 16 : reg<aie2p.array.scalar : index>
  %input_partition_channel = channel %input_partition, %worker_receiver_0, %input_partition_channel_capacity, %input_partition_channel_records : reg<aie2p.array.channel : tile<256xi8>>
  %worker_sender_1 = sender %worker, 1 : reg<aie2p.array.sender : tile<512xi8>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1x16x512xi8>>
  %output_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %output_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %output_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_partition = partition.receiver %output_receiver, %output_partition_offset, %output_partition_rank, %output_partition_count : reg<aie2p.array.receiver : tile<512xi8>>
  %worker_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_1_channel_records = constant.u32 16 : reg<aie2p.array.scalar : index>
  %worker_1_channel = channel %worker_sender_1, %output_partition, %worker_1_channel_capacity, %worker_1_channel_records : reg<aie2p.array.channel : tile<512xi8>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @slice_snapshot(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %payload_origin = index.constant 64 : offset
  %count_view = buffer.view %source[%origin] : buffer -> view<64xi32>
  %source_view = buffer.view %source[%payload_origin] : buffer -> view<128xi8>
  %destination_view = buffer.view %destination[%origin] : buffer -> view<512xi8>
  %count_i32 = view.load %count_view[0] : view<64xi32> -> i32
  %count = index.cast %count_i32 : i32 to index
  %snapshot = vector.load %source_view[0] : view<128xi8> -> vector<128xi8>
  %sentinel = vector.constant -91 : vector<64xi8>
  vector.store<volatile> %sentinel, %source_view[0] : vector<64xi8>, view<128xi8>
  vector.store<volatile> %sentinel, %source_view[64] : vector<64xi8>, view<128xi8>
  vector.store %sentinel, %destination_view[0] : vector<64xi8>, view<512xi8>
  vector.store %sentinel, %destination_view[64] : vector<64xi8>, view<512xi8>
  vector.store %sentinel, %destination_view[128] : vector<64xi8>, view<512xi8>
  vector.store %sentinel, %destination_view[192] : vector<64xi8>, view<512xi8>
  vector.store %sentinel, %destination_view[256] : vector<64xi8>, view<512xi8>
  vector.store %sentinel, %destination_view[320] : vector<64xi8>, view<512xi8>
  vector.store %sentinel, %destination_view[384] : vector<64xi8>, view<512xi8>
  vector.store %sentinel, %destination_view[448] : vector<64xi8>, view<512xi8>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %captured = scf.for %iteration = [%zero to %count step %one](%carried = %snapshot : vector<128xi8>) -> (vector<128xi8>) {
    vector.store %carried, %destination_view[0] : vector<128xi8>, view<512xi8>
    %crossing = vector.slice %carried[63] : vector<128xi8> -> vector<64xi8>
    vector.store %crossing, %destination_view[128] : vector<64xi8>, view<512xi8>
    %wide = vector.slice %carried[1] : vector<128xi8> -> vector<96xi8>
    vector.store %wide, %destination_view[192] : vector<96xi8>, view<512xi8>
    %pair_left = vector.slice %carried[0] : vector<128xi8> -> vector<40xi8>
    %pair_right = vector.slice %carried[40] : vector<128xi8> -> vector<40xi8>
    %partial_pair = vector.concat<0> %pair_left, %pair_right : vector<40xi8>, vector<40xi8> -> vector<80xi8>
    %pivot = vector.slice %carried[80] : vector<128xi8> -> vector<1xi8>
    %partial_wide = vector.concat<0> %pivot, %partial_pair : vector<1xi8>, vector<80xi8> -> vector<81xi8>
    %chain_tail = vector.slice %carried[81] : vector<128xi8> -> vector<47xi8>
    %wide_partial = vector.concat<0> %partial_wide, %chain_tail : vector<81xi8>, vector<47xi8> -> vector<128xi8>
    vector.store %wide_partial, %destination_view[288] : vector<128xi8>, view<512xi8>
    %prefix = vector.slice %carried[0] : vector<128xi8> -> vector<1xi8>
    %suffix = vector.slice %carried[1] : vector<128xi8> -> vector<63xi8>
    %joined = vector.concat<0> %prefix, %suffix : vector<1xi8>, vector<63xi8> -> vector<64xi8>
    %direct_tail = vector.slice %carried[64] : vector<128xi8> -> vector<1xi8>
    %wide_joined = vector.concat<0> %joined, %direct_tail : vector<64xi8>, vector<1xi8> -> vector<65xi8>
    vector.store %wide_joined, %destination_view[416] : vector<65xi8>, view<512xi8>
    scf.yield %carried : vector<128xi8>
  }
  func.return
}
