global.rodata.def @bf16_pairs = align(32) bytes("803f004040408040a040c040e040004110412041304140415041604170418041884190419841a041a841b041b841c041c841d041d841e041e841f041f8410042")

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @immutable_gather_packets() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_rank, @gather_decode_dot
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x4x256xi8>>
  %input_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %input_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %input_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_partition = partition.sender %input_sender, %input_partition_offset, %input_partition_rank, %input_partition_count : reg<aie2p.array.sender : tile<256xi8>>
  %worker_receiver_0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<256xi8>>
  %input_partition_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_channel_records = constant.u32 4 : reg<aie2p.array.scalar : index>
  %input_partition_channel = channel %input_partition, %worker_receiver_0, %input_partition_channel_capacity, %input_partition_channel_records : reg<aie2p.array.channel : tile<256xi8>>
  %worker_sender_1 = sender %worker, 1 : reg<aie2p.array.sender : tile<192xi8>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1x4x192xi8>>
  %output_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %output_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %output_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_partition = partition.receiver %output_receiver, %output_partition_offset, %output_partition_rank, %output_partition_count : reg<aie2p.array.receiver : tile<192xi8>>
  %worker_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_1_channel_records = constant.u32 4 : reg<aie2p.array.scalar : index>
  %worker_1_channel = channel %worker_sender_1, %output_partition, %worker_1_channel_capacity, %worker_1_channel_records : reg<aie2p.array.channel : tile<192xi8>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @gather_decode_dot(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %table = global.load @bf16_pairs : buffer
  %origin = index.constant 0 : offset
  %table_i32 = buffer.view %table[%origin] : buffer -> view<16xi32>
  %table_bf16 = buffer.view %table[%origin] : buffer -> view<32xbf16>
  %table_f64 = buffer.view %table[%origin] : buffer -> view<8xf64>
  %source_i8 = buffer.view %source[%origin] : buffer -> view<256xi8>
  %source_i32 = buffer.view %source[%origin] : buffer -> view<64xi32>
  %source_bf16 = buffer.view %source[%origin] : buffer -> view<128xbf16>
  %source_f32 = buffer.view %source[%origin] : buffer -> view<64xf32>
  %destination_bf16 = buffer.view %destination[%origin] : buffer -> view<96xbf16>
  %destination_f32 = buffer.view %destination[%origin] : buffer -> view<48xf32>
  %destination_f64 = buffer.view %destination[%origin] : buffer -> view<24xf64>
  %raw_indices = vector.load %source_i32[0] : view<64xi32> -> vector<16xi32>
  %index_mask = vector.constant 15 : vector<16xi32>
  %indices = vector.andi %raw_indices, %index_mask : vector<16xi32>
  %packed_values = vector.gather %table_i32[0][%indices] : view<16xi32>, vector<16xi32> -> vector<16xi32>
  %values = vector.bitcast %packed_values : vector<16xi32> to vector<32xbf16>
  %rhs = vector.load %source_bf16[64] : view<128xbf16> -> vector<32xbf16>
  %initial = vector.load %source_f32[48] : view<64xf32> -> vector<16xf32>
  %result = vector.dot2f %values, %rhs, %initial : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  vector.store %result, %destination_f32[0] : vector<16xf32>, view<48xf32>

  %raw_bf16_indices = vector.load %source_i8[64] : view<256xi8> -> vector<32xi8>
  %bf16_index_mask = vector.constant 31 : vector<32xi8>
  %bounded_bf16_indices = vector.andi %raw_bf16_indices, %bf16_index_mask : vector<32xi8>
  %bf16_indices = vector.extui %bounded_bf16_indices : vector<32xi8> to vector<32xi32>
  %bf16_values = vector.gather %table_bf16[0][%bf16_indices] : view<32xbf16>, vector<32xi32> -> vector<32xbf16>
  vector.store %bf16_values, %destination_bf16[32] : vector<32xbf16>, view<96xbf16>

  %raw_f64_indices = vector.load %source_i32[24] : view<64xi32> -> vector<8xi32>
  %f64_index_mask = vector.constant 7 : vector<8xi32>
  %f64_indices = vector.andi %raw_f64_indices, %f64_index_mask : vector<8xi32>
  %f64_values = vector.gather %table_f64[0][%f64_indices] : view<8xf64>, vector<8xi32> -> vector<8xf64>
  vector.store %f64_values, %destination_f64[16] : vector<8xf64>, view<24xf64>
  func.return
}
