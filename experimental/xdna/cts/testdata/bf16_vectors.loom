// BF16 values cross memory, ordinary vector operations, and matrix operands.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @bf16_packets() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_rank, @bf16_entry
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x64x32xi32>>
  %input_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %input_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %input_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_partition = partition.sender %input_sender, %input_partition_offset, %input_partition_rank, %input_partition_count : reg<aie2p.array.sender : tile<32xi32>>
  %worker_receiver_0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<32xi32>>
  %input_partition_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_partition_channel_records = constant.u32 64 : reg<aie2p.array.scalar : index>
  %input_partition_channel = channel %input_partition, %worker_receiver_0, %input_partition_channel_capacity, %input_partition_channel_records : reg<aie2p.array.channel : tile<32xi32>>
  %worker_sender_1 = sender %worker, 1 : reg<aie2p.array.sender : tile<192xi32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1x64x192xi32>>
  %output_partition_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %output_partition_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %output_partition_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_partition = partition.receiver %output_receiver, %output_partition_offset, %output_partition_rank, %output_partition_count : reg<aie2p.array.receiver : tile<192xi32>>
  %worker_1_channel_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker_1_channel_records = constant.u32 64 : reg<aie2p.array.scalar : index>
  %worker_1_channel = channel %worker_sender_1, %output_partition, %worker_1_channel_capacity, %worker_1_channel_records : reg<aie2p.array.channel : tile<192xi32>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @bf16_entry(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %rhs_offset = index.constant 16 : offset
  %codes_offset = index.constant 32 : offset
  %bits_offset = index.constant 48 : offset
  %acc_offset = index.constant 64 : offset
  %table_view = buffer.view %source[%origin] : buffer -> view<8xbf16>
  %rhs_view = buffer.view %source[%rhs_offset] : buffer -> view<8xbf16>
  %codes_view = buffer.view %source[%codes_offset] : buffer -> view<8xi16>
  %bits_view = buffer.view %source[%bits_offset] : buffer -> view<8xbf16>
  %acc_view = buffer.view %source[%acc_offset] : buffer -> view<4xf32>
  %table = vector.load %table_view[0] : view<8xbf16> -> vector<8xbf16>
  %rhs = vector.load %rhs_view[0] : view<8xbf16> -> vector<8xbf16>
  %codes = vector.load %codes_view[0] : view<8xi16> -> vector<8xi16>
  %bits = vector.load %bits_view[0] : view<8xbf16> -> vector<8xbf16>
  %initial = vector.load %acc_view[0] : view<4xf32> -> vector<4xf32>
  %decoded = vector.table.lookup %table[%codes] : vector<8xbf16>, vector<8xi16> -> vector<8xbf16>
  %negative = vector.negf %bits : vector<8xbf16>
  %absolute = vector.absf %bits : vector<8xbf16>
  %copied = vector.copysignf %bits, %rhs : vector<8xbf16>
  %last = vector.extract %table[7] : vector<8xbf16> -> bf16
  %updated = vector.insert %last into %decoded[5] : bf16, vector<8xbf16>
  %splat = vector.splat %last : vector<8xbf16>
  %zero = vector.constant 0.0 : vector<4xf32>
  %dot_zero = vector.dot2f %decoded, %rhs, %zero : vector<8xbf16>, vector<8xbf16>, vector<4xf32>
  %dot_initial = vector.dot2f %decoded, %rhs, %initial : vector<8xbf16>, vector<8xbf16>, vector<4xf32>
  // Volatile initialization keeps the guard writes before the partial stores.
  // Each 16-byte result leaves 48 bytes of the same register-sized slot intact.
  %guard_view = buffer.view %destination[%origin] : buffer -> view<128xi32>
  %guard = vector.constant -1515870811 : vector<16xi32>
  vector.store<volatile> %guard, %guard_view[0] : vector<16xi32>, view<128xi32>
  vector.store<volatile> %guard, %guard_view[16] : vector<16xi32>, view<128xi32>
  vector.store<volatile> %guard, %guard_view[32] : vector<16xi32>, view<128xi32>
  vector.store<volatile> %guard, %guard_view[48] : vector<16xi32>, view<128xi32>
  vector.store<volatile> %guard, %guard_view[64] : vector<16xi32>, view<128xi32>
  vector.store<volatile> %guard, %guard_view[80] : vector<16xi32>, view<128xi32>
  vector.store<volatile> %guard, %guard_view[96] : vector<16xi32>, view<128xi32>
  vector.store<volatile> %guard, %guard_view[112] : vector<16xi32>, view<128xi32>
  %bf16_results = buffer.view %destination[%origin] : buffer -> view<256xbf16>
  %f32_results = buffer.view %destination[%origin] : buffer -> view<128xf32>
  vector.store %decoded, %bf16_results[0] : vector<8xbf16>, view<256xbf16>
  vector.store %negative, %bf16_results[32] : vector<8xbf16>, view<256xbf16>
  vector.store %absolute, %bf16_results[64] : vector<8xbf16>, view<256xbf16>
  vector.store %copied, %bf16_results[96] : vector<8xbf16>, view<256xbf16>
  vector.store %updated, %bf16_results[128] : vector<8xbf16>, view<256xbf16>
  vector.store %splat, %bf16_results[160] : vector<8xbf16>, view<256xbf16>
  vector.store %dot_zero, %f32_results[96] : vector<4xf32>, view<128xf32>
  vector.store %dot_initial, %f32_results[112] : vector<4xf32>, view<128xf32>
  %m = index.constant 8 : index
  %n = index.constant 8 : index
  %k = index.constant 1 : index
  %lhs_fragment = vector.fragment<lhs> %decoded shape [%m, %k] : vector<8xbf16>
  %rhs_fragment = vector.fragment<rhs> %rhs shape [%k, %n] : vector<8xbf16>
  %accumulator = vector.constant 0.0 : vector<64xf32>
  %acc_fragment = vector.fragment<init> %accumulator shape [%m, %n] : vector<64xf32>
  %product = vector.mma %lhs_fragment, %rhs_fragment, %acc_fragment : vector<8xbf16>, vector<8xbf16>, vector<64xf32>
  %product_offset = index.constant 512 : offset
  %product_view = buffer.view %destination[%product_offset] : buffer -> view<64xf32>
  vector.store %product, %product_view[0] : vector<64xf32>, view<64xf32>
  func.return
}
