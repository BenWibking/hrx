#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-3-Clause
# ar: local driver for the advance-kernel autoresearch campaign on moth.
# See README.md (humans) and program.md (the agent).
#
#   ar init TAG                 worktree + branch autoresearch/TAG, seed kernel/
#   ar setup [--bin-only]       build the frozen Loom tools and harness on moth
#   ar eval "DESCRIPTION" [--pairs N] [--steps N] [--bar X] [--contended]
#           [--gpu-wait SECONDS]
#                               evaluate the worktree's HEAD against the best
#   ar resume RUN               reattach to an eval whose connection dropped
#   ar screen ["NOTE"] [--dir DIR]
#                               compile only, on moth: kernel/ as it stands in
#                               the worktree (uncommitted edits included), or
#                               DIR; prints static stats vs the best. No GPU.
#   ar status                   results table, best run, deadline
#   ar import                   write kernel/chemistry.loom from the kernel C++
#   ar deadline set-in MINUTES | set-at "YYYY-MM-DD HH:MM" | show | clear
#   ar target LOOM_HIP | show | clear
#                               end the campaign once a kept run's Loom/HIP
#                               advance ratio drops below LOOM_HIP
#
# TAG comes from `ar init`, then from $AR_TAG or the current branch name.
# Works with macOS bash 3.2.
set -uo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
host=${AR_HOST:-moth}
remote_root=${AR_REMOTE_ROOT:-/mnt/data/bwibking/ar}
KREL=experimental/loom-codegen-comparison/kernel
main=$(git -C "$here" rev-parse --show-toplevel) || exit 1
# A run with one of these statuses is discarded: its commit is tagged and the
# worktree is reset to the best commit.
DISCARD_STATUSES=" discard identical incorrect hang compile-fail import-fail interface-fail "

die() { echo "ar: $*" >&2; exit 1; }
# One plain `ssh moth` connection per command (moth's firewall dislikes bursts).
ssh_moth() {
  ssh -o WarnWeakCrypto=no -o ServerAliveInterval=30 -o ServerAliveCountMax=10 "$host" "$@"
}
kv() {  # kv KEY LINE : value of KEY=VALUE in a RESULT line, or "-"
  local v
  v=$(sed -nE "s/.* $1=([^ ]*).*/\1/p" <<<"$2" | head -1)
  echo "${v:--}"
}

resolve_tag() {
  tag=${AR_TAG:-}
  if [[ -z $tag ]]; then
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    [[ $branch == autoresearch/* ]] && tag=${branch#autoresearch/}
  fi
  [[ -n $tag ]] || die "no campaign: run inside the campaign worktree or set AR_TAG"
  C=$main/.notes/autoresearch/$tag
  [[ -f $C/campaign.env ]] || die "no campaign $tag at $C"
  # shellcheck disable=SC1091
  source "$C/campaign.env"
  BEST_RUN=none; BEST_SHA=$SEED
  # shellcheck disable=SC1091
  [[ -f $C/best.env ]] && source "$C/best.env"
}

cmd_init() {
  tag=${1:?usage: ar init TAG}
  [[ $tag =~ ^[A-Za-z0-9._-]+$ ]] || die "TAG may use letters, digits, . _ -"
  C=$main/.notes/autoresearch/$tag
  [[ -e $C ]] && die "campaign $tag already exists at $C"
  local base wt py
  base=$(git -C "$main" rev-parse HEAD)
  wt=${AR_WORKTREE:-$(cd "$main/.." && pwd)/hrx-system-ar-$tag}
  git -C "$main" worktree add --quiet -b "autoresearch/$tag" "$wt" "$base" || die "worktree add failed"
  py=python3
  [[ -x $main/build/py312-venv/bin/python ]] && py=$main/build/py312-venv/bin/python
  local k=$wt/$KREL c=$wt/experimental/loom-codegen-comparison
  "$py" "$c/generate.py" --output-dir="$k" > /dev/null || die "generate.py failed"
  rm -f "$k/reference_kernels.inc"
  cp "$c/support.h" "$c/f64_math.h" "$k/"
  sed -i '' 's|^// Generated by generate.py from reference.cpp; do not hand edit.$|// Seeded by generate.py from reference.cpp; edited by autoresearch campaign '"$tag"'.|' \
    "$k/reproducer.cpp"
  git -C "$wt" add "$KREL"
  git -C "$wt" commit -q -m "autoresearch($tag): seed kernel from generate.py" || die "seed commit failed"
  mkdir -p "$C/runs"
  {
    echo "TAG=$tag"
    echo "BASE=$base"
    echo "SEED=$(git -C "$wt" rev-parse HEAD)"
    echo "WORKTREE=$wt"
  } > "$C/campaign.env"
  printf 'run\tcommit\tstatus\tspeedup\thipnorm\tcand_ms\tbest_ms\tloom_hip\tvgpr\tsgpr\tscratch_bytes\twaitcnt\tscratch_ops\tminutes\tdescription\n' > "$C/results.tsv"
  printf '# Campaign %s notes\n\nHypotheses, observations and dead ends, newest last.\n' "$tag" > "$C/notes.md"
  echo "campaign $tag: worktree $wt, state $C"
  echo "next: cd $wt && $here/ar setup"
}

cmd_setup() {
  resolve_tag
  local stage
  stage=$(mktemp -d "${TMPDIR:-/tmp}/ar-setup.XXXXXX")
  mkdir -p "$stage/bin"
  cp "$here/remote.sh" "$here/analyze.py" "$here/layout.cpp" "$stage/bin/"
  if [[ ${1:-} == --bin-only ]]; then
    COPYFILE_DISABLE=1 tar --no-xattrs -C "$stage" -cf - bin |
      ssh_moth "mkdir -p $remote_root/$TAG && tar -xf - -C $remote_root/$TAG && echo bin updated"
    rm -rf "$stage"; return
  fi
  git -C "$main" archive --format=tar.gz "$BASE" > "$stage/src.tar.gz" || die "git archive failed"
  echo "setup $TAG on $host: frozen tools from ${BASE:0:10} (several minutes)"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$stage" -cf - bin src.tar.gz |
    ssh_moth "mkdir -p $remote_root/$TAG && tar -xf - -C $remote_root/$TAG && bash $remote_root/$TAG/bin/remote.sh setup-start $TAG $BASE" 2>&1 |
    tee "$C/setup.log"
  rm -rf "$stage"
  grep -q '^SETUP ok' "$C/setup.log" || die "setup failed; see $C/setup.log"
  echo "setup ok. next: ar eval \"baseline\" (from the worktree, at the seed commit)"
}

clock_line() {  # print local time and minutes left, so agents never estimate the clock
  local now end
  now=$(date +%s)
  if [[ -f $C/deadline ]]; then
    end=$(cat "$C/deadline")
    echo "ar: clock $(date -r "$now" '+%F %H:%M %Z'); deadline $(date -r "$end" '+%H:%M %Z'), $(( (end - now) / 60 )) min left"
  else
    echo "ar: clock $(date -r "$now" '+%F %H:%M %Z'); no deadline"
  fi
}

deadline_check() {  # refuse to start an eval after the target or deadline
  if [[ -f $C/complete ]]; then
    echo "ar: $(cat "$C/complete"). Campaign over." >&2
    exit 3
  fi
  [[ -f $C/deadline ]] || return 0
  local end now need
  end=$(cat "$C/deadline"); now=$(date +%s)
  need=$(awk -F'\t' 'NR > 1 && $14 ~ /^[0-9]+$/ {print $14}' "$C/results.tsv" | tail -3 | sort -n |
    awk '{a[NR] = $1} END {print (NR ? a[int((NR + 1) / 2)] : 10)}')
  if (( now + need * 60 > end )); then
    echo "ar: deadline $(date -r "$end" '+%F %T') leaves $(( (end - now) / 60 )) min; an eval needs ~$need min. Campaign over." >&2
    exit 3
  fi
}

record() {  # record RUN : unpack the bundle, log the row, apply the verdict
  local run=$1 d=$C/runs/$1 res status sha desc
  sha=$(sed -n 's/^sha=//p' "$d/meta"); desc=$(sed -n 's/^desc=//p' "$d/meta")
  [[ -s $d/bundle.tgz ]] && tar xzf "$d/bundle.tgz" -C "$d" 2>/dev/null
  if [[ ! -f $d/result.txt ]]; then
    echo "ar: no result for $run (connection lost?). Reattach with: ar resume $run" >&2
    exit 4
  fi
  res=$(cat "$d/result.txt")
  status=$(kv status "$res")
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$run" "${sha:0:10}" "$status" \
    "$(kv median_speedup "$res")" "$(kv hipnorm_speedup "$res")" "$(kv cand_ms "$res")" \
    "$(kv best_ms "$res")" "$(kv loom_hip "$res")" "$(kv vgpr "$res")" "$(kv sgpr "$res")" \
    "$(kv scratch_bytes "$res")" "$(kv waitcnt "$res")" "$(kv scratch_ops "$res")" \
    "$(kv minutes "$res")" "$desc" >> "$C/results.tsv"
  echo
  echo "$res"
  case $status in
    baseline|keep)
      printf 'BEST_RUN=%s\nBEST_SHA=%s\n' "$run" "$sha" > "$C/best.env"
      if [[ $status == baseline ]]; then
        # Default acceptance bar: twice the median A/A deviation, never below
        # 2%. The median ignores the occasional run in the slow timing mode.
        local bar
        bar=$(awk -v s="$(kv aa_median_dev "$res")" 'BEGIN {b = 1 + 2 * s; if (b < 1.02) b = 1.02; printf "%.3f", b}')
        grep -v '^BAR=' "$C/campaign.env" > "$C/campaign.env.new"; echo "BAR=$bar" >> "$C/campaign.env.new"
        mv "$C/campaign.env.new" "$C/campaign.env"
        echo "VERDICT baseline: best is now $run; median A/A deviation $(kv aa_median_dev "$res") sets the bar to $bar"
      else
        echo "VERDICT keep: best is now $run (${sha:0:10})"
      fi
      if [[ -n ${TARGET_LOOM_HIP:-} ]] && awk -v r="$(kv loom_hip "$res")" -v t="$TARGET_LOOM_HIP" \
           'BEGIN {exit !(r != "-" && r + 0 < t + 0)}'; then
        echo "target reached by $run: Loom/HIP advance ratio $(kv loom_hip "$res") < $TARGET_LOOM_HIP" > "$C/complete"
        echo "TARGET REACHED: $(cat "$C/complete"). Campaign over."
      fi ;;
    *)
      if [[ $DISCARD_STATUSES == *" $status "* && $BEST_RUN != none ]]; then
        git -C "$WORKTREE" tag -f "ar/$TAG/$run-$status" "$sha" > /dev/null
        git -C "$WORKTREE" reset -q --hard "$BEST_SHA"
        echo "VERDICT $status: commit kept as tag ar/$TAG/$run-$status; worktree reset to best $BEST_RUN (${BEST_SHA:0:10})"
      else
        echo "VERDICT $status: nothing changed. Fix the cause or re-run ar eval on the same commit."
      fi ;;
  esac
}

cmd_eval() {
  resolve_tag
  local desc=${1:?usage: ar eval \"DESCRIPTION\" [options]}; shift
  local pairs=5 steps=5 bar=${BAR:-1.02} contended=0 gpu_wait=1800
  while (($#)); do
    case $1 in
      --pairs) pairs=$2; shift ;;
      --steps) steps=$2; shift ;;
      --bar) bar=$2; shift ;;
      --contended) contended=1 ;;
      --gpu-wait) gpu_wait=$2; shift ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  [[ $pairs =~ ^[1-9][0-9]?$ && $steps =~ ^[1-9][0-9]?$ && $gpu_wait =~ ^[0-9]+$ ]] || die "bad option value"
  clock_line
  deadline_check
  cd "$WORKTREE" || die "worktree $WORKTREE missing"
  [[ $(git rev-parse --abbrev-ref HEAD) == "autoresearch/$TAG" ]] || die "worktree is not on autoresearch/$TAG"
  [[ -z $(git status --porcelain --untracked-files=no) && -z $(git status --porcelain -- "$KREL") ]] ||
    die "commit (or discard) your changes first; ar eval measures HEAD"
  local sha outside
  sha=$(git rev-parse HEAD)
  git merge-base --is-ancestor "$SEED" "$sha" || die "HEAD does not descend from the seed commit"
  outside=$(git diff --name-only "$SEED" "$sha" | grep -v "^$KREL/" || true)
  [[ -z $outside ]] || die "only $KREL/ may change; this commit also changes:"$'\n'"$outside"
  if [[ $BEST_RUN == none ]]; then
    [[ $sha == "$SEED" ]] || die "no baseline yet: evaluate the seed commit first (ar eval \"baseline\")"
  else
    [[ $sha != "$BEST_SHA" ]] || die "HEAD is the current best; commit a change first"
  fi
  mkdir "$C/lock" 2>/dev/null || die "another eval holds $C/lock (remove it if that eval is dead)"
  trap 'rmdir "$C/lock" 2>/dev/null; clock_line' EXIT
  local n run d
  n=$(($(wc -l < "$C/results.tsv") - 1))
  run=$(printf 'e%03d' "$n")
  while [[ -e $C/runs/$run ]]; do n=$((n + 1)); run=$(printf 'e%03d' "$n"); done
  d=$C/runs/$run; mkdir -p "$d"
  printf 'sha=%s\ndesc=%s\nbest=%s\nstarted=%s\n' "$sha" "$(printf '%s' "$desc" | tr '\t\n' '  ')" "$BEST_RUN" "$(date '+%F %T')" > "$d/meta"
  echo "eval $run ${sha:0:10} vs ${BEST_RUN} on $host (pairs=$pairs steps=$steps bar=$bar): $desc"
  { git archive --format=tar.gz "$sha" "$KREL" |
      ssh_moth "bash $remote_root/$TAG/bin/remote.sh eval-start $TAG $run $BEST_RUN $pairs $steps $bar $contended $gpu_wait" \
      > "$d/bundle.tgz"; } 2>&1 | tee "$d/eval.log"
  record "$run"
}

cmd_resume() {
  resolve_tag
  local run=${1:?usage: ar resume RUN} d
  d=$C/runs/$run
  [[ -f $d/meta ]] || die "no run $run"
  grep -q "^$run"$'\t' "$C/results.tsv" && die "$run is already recorded"
  mkdir "$C/lock" 2>/dev/null || die "another eval holds $C/lock"
  trap 'rmdir "$C/lock" 2>/dev/null; clock_line' EXIT
  { ssh_moth "bash $remote_root/$TAG/bin/remote.sh resume $TAG $run" > "$d/bundle.tgz"; } 2>&1 | tee -a "$d/eval.log"
  record "$run"
}

cmd_screen() {
  resolve_tag
  local dir="" note=""
  while (($#)); do
    case $1 in
      --dir) dir=${2:?--dir DIR}; shift ;;
      -*) die "unknown option $1" ;;
      *) note=$1 ;;
    esac
    shift
  done
  clock_line
  [[ -f $C/complete ]] && die "$(cat "$C/complete"). Campaign over."
  [[ -f $C/deadline ]] && (( $(date +%s) > $(cat "$C/deadline") )) && die "the deadline has passed. Campaign over."
  local src
  if [[ -n $dir ]]; then
    dir=$(cd "$dir" 2>/dev/null && pwd) || die "no directory $dir"
    src="dir $dir"
  else
    dir=$WORKTREE/$KREL
    local sha dirty=""
    sha=$(git -C "$WORKTREE" rev-parse --short=10 HEAD)
    [[ -n $(git -C "$WORKTREE" status --porcelain -- "$KREL") ]] && dirty="+uncommitted"
    src="worktree $sha$dirty"
  fi
  [[ -f $dir/reproducer.cpp || -f $dir/chemistry.loom ]] || die "$dir has neither reproducer.cpp nor chemistry.loom"
  # Shares the eval lock: one remote job, and one ssh session, at a time.
  mkdir "$C/lock" 2>/dev/null || die "another eval or screen holds $C/lock (remove it if that job is dead)"
  trap 'rmdir "$C/lock" 2>/dev/null; clock_line' EXIT
  local n=1 id d
  mkdir -p "$C/screens"
  while id=$(printf 's%03d' "$n"); [[ -e $C/screens/$id ]]; do n=$((n + 1)); done
  d=$C/screens/$id; mkdir -p "$d"
  echo "screen $id on $host (compile only, no GPU): $src${note:+: $note}"
  { COPYFILE_DISABLE=1 tar --no-xattrs -C "$dir" -czf - . |
      ssh_moth "bash $remote_root/$TAG/bin/remote.sh screen $TAG $id $BEST_RUN" > "$d/bundle.tgz"; } 2>&1 |
    tee "$d/screen.log"
  [[ -s $d/bundle.tgz ]] && tar xzf "$d/bundle.tgz" -C "$d" 2>/dev/null
  [[ -f $d/result.txt ]] || die "no result for $id (connection lost?); run ar screen again"
  local res status
  res=$(cat "$d/result.txt"); status=$(kv status "$res")
  [[ -f $C/screens.tsv ]] ||
    printf 'screen\twhen\tsource\tstatus\tvgpr\tsgpr\tscratch_bytes\tinsts\tscratch_ops\twaitcnt\tbranches\tsame_as_best\tnote\n' > "$C/screens.tsv"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$(date '+%F %T')" "$src" "$status" \
    "$(kv vgpr "$res")" "$(kv sgpr "$res")" "$(kv scratch_bytes "$res")" "$(kv insts "$res")" \
    "$(kv scratch_ops "$res")" "$(kv waitcnt "$res")" "$(kv branches "$res")" \
    "$(kv identical_to_best "$res")" "$(printf '%s' "$note" | tr '\t\n' '  ')" >> "$C/screens.tsv"
  echo
  echo "$res"
  local bs=$C/runs/$BEST_RUN/stats.txt
  if [[ $status == ok && -f $bs ]]; then
    local b k delta=""
    b=$(sed -n 's/^advance //p' "$bs")
    for k in vgpr sgpr scratch_bytes insts scratch_ops waitcnt branches; do
      delta+=" $k $(kv "$k" " $b") -> $(kv "$k" "$res")"$'\n'
    done
    echo "vs best $BEST_RUN:"; printf '%s' "$delta" | column -t
  fi
  echo "files: $d"
  [[ $status == ok ]]
}

cmd_status() {
  resolve_tag
  column -t -s $'\t' "$C/results.tsv"
  echo
  echo "campaign $TAG  worktree $WORKTREE  HEAD $(git -C "$WORKTREE" rev-parse --short=10 HEAD)"
  echo "best $BEST_RUN (${BEST_SHA:0:10})  bar ${BAR:-1.02 (until baseline)}"
  clock_line
  [[ -n ${TARGET_LOOM_HIP:-} ]] && echo "target: kept run with Loom/HIP advance ratio < $TARGET_LOOM_HIP"
  [[ -f $C/complete ]] && echo "COMPLETE: $(cat "$C/complete")"
  echo "state: $C"
}

cmd_import() {
  resolve_tag
  cd "$WORKTREE" || die "worktree missing"
  [[ -e $KREL/chemistry.loom ]] && die "$KREL/chemistry.loom exists; the campaign is already in IR mode"
  git archive --format=tar.gz HEAD "$KREL" |
    ssh_moth "bash $remote_root/$TAG/bin/remote.sh import $TAG" > "$KREL/chemistry.loom.new" ||
    { rm -f "$KREL/chemistry.loom.new"; die "import failed"; }
  mv "$KREL/chemistry.loom.new" "$KREL/chemistry.loom"
  echo "wrote $KREL/chemistry.loom ($(wc -l < "$KREL/chemistry.loom") lines) from HEAD's kernel C++."
  echo "Once committed, evals compile it directly and the C++ no longer matters."
}

cmd_target() {
  resolve_tag
  case ${1:-show} in
    show) ;;
    clear) grep -v '^TARGET_LOOM_HIP=' "$C/campaign.env" > "$C/campaign.env.new"; mv "$C/campaign.env.new" "$C/campaign.env"
           unset TARGET_LOOM_HIP ;;
    *) [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "target LOOM_HIP | show | clear"
       grep -v '^TARGET_LOOM_HIP=' "$C/campaign.env" > "$C/campaign.env.new"; echo "TARGET_LOOM_HIP=$1" >> "$C/campaign.env.new"
       mv "$C/campaign.env.new" "$C/campaign.env"; TARGET_LOOM_HIP=$1 ;;
  esac
  echo "target: ${TARGET_LOOM_HIP:-none}"
}

cmd_deadline() {
  resolve_tag
  case ${1:-show} in
    set-in) [[ ${2:-} =~ ^[0-9]+$ ]] || die "set-in MINUTES"; echo $(( $(date +%s) + $2 * 60 )) > "$C/deadline" ;;
    set-at) date -j -f '%Y-%m-%d %H:%M' "${2:-}" +%s > "$C/deadline.new" 2>/dev/null ||
              { rm -f "$C/deadline.new"; die "set-at \"YYYY-MM-DD HH:MM\""; }
            mv "$C/deadline.new" "$C/deadline" ;;
    clear) rm -f "$C/deadline"; echo "no deadline"; return ;;
    show) ;;
    *) die "deadline set-in MINUTES | set-at \"YYYY-MM-DD HH:MM\" | show | clear" ;;
  esac
  if [[ -f $C/deadline ]]; then
    echo "deadline $(date -r "$(cat "$C/deadline")" '+%F %T') ($(( ($(cat "$C/deadline") - $(date +%s)) / 60 )) min left)"
  else
    echo "no deadline"
  fi
}

# Sourcing defines the functions without running a command (for tests).
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0
sub=${1:-}; shift || true
case $sub in
  init) cmd_init "$@" ;;
  setup) cmd_setup "$@" ;;
  eval) cmd_eval "$@" ;;
  resume) cmd_resume "$@" ;;
  screen) cmd_screen "$@" ;;
  status) cmd_status ;;
  import) cmd_import ;;
  deadline) cmd_deadline "$@" ;;
  target) cmd_target "$@" ;;
  *) sed -n '3,24p' "$0"; exit 2 ;;
esac
