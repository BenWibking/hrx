low.func.def schedule(locked) target<amdgpu.cdna3.core>(@target) @masked_edge(%lane: reg<amdgpu.vgpr>, %old: reg<amdgpu.vgpr>, %stale: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %address = storage_address %slot : low.storage<private> -> reg<amdgpu.vgpr>
  low.spill %old, %slot : reg<amdgpu.vgpr>, low.storage<private>
  %limit = v_mov_b32 2
  %active = v_cmp_lt_u32 %lane, %limit
  %one = v_mov_b32 1
  %updated = v_add_u32 %old, %one
  // Deterministic stale contents stand in for register reuse in retired lanes.
  %incoming = v_cndmask_b32 %stale, %updated, %active
  %saved, %any = s_and_saveexec_b64 %active
  low.br ^edge
^edge:
  scratch_store_b32_vaddr %address, %incoming
  s_mov_b64_exec %saved
  %result = low.reload %slot : low.storage<private> -> reg<amdgpu.vgpr>
  return %result
}

kernel.def target(@target) @masked_kernel() {
  %one = index.constant 1 : index
  %width = index.constant 4 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%width, %one, %one) : index
} launch(%old_buffer: buffer, %stale_buffer: buffer, %output_buffer: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %old_view = buffer.view %old_buffer[%base] : buffer -> view<4xi32>
  %stale_view = buffer.view %stale_buffer[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<4xi32>
  %old = vector.load %old_view[%lane] : view<4xi32> -> vector<1xi32>
  %stale = vector.load %stale_view[%lane] : view<4xi32> -> vector<1xi32>
  %lane_i32 = index.cast %lane : index to i32
  %lane_vector = vector.splat %lane_i32 : vector<1xi32>
  %result = low.invoke @masked_edge(%lane_vector, %old, %stale) : (vector<1xi32>, vector<1xi32>, vector<1xi32>) -> (vector<1xi32>)
  // Undo the active lanes' increment so every expected element equals old.
  %two = index.constant 2 : index
  %is_active = index.cmp ult, %lane, %two : index
  %one_i32 = scalar.constant 1 : i32
  %zero_i32 = scalar.constant 0 : i32
  %delta = scf.select %is_active, %one_i32, %zero_i32 : i32
  %delta_vector = vector.splat %delta : vector<1xi32>
  %observed = vector.subi %result, %delta_vector : vector<1xi32>
  vector.store %observed, %output_view[%lane] : vector<1xi32>, view<4xi32>
  kernel.return
}

