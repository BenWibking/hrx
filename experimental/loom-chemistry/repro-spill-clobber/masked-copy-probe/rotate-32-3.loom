kernel.def @rotate() {
 %one = index.constant 1 : index
 %width = index.constant 64 : index
 kernel.launch.config workgroups(%one,%one,%one) workgroup_size(%width,%one,%one) : index
} launch(%input: buffer,%output: buffer,%mode: buffer) {
 %lane = kernel.workitem.id<x> : index
 %base = index.constant 0 : offset
 %iv = buffer.view %input[%base] : buffer -> view<192xi32>
 %ov = buffer.view %output[%base] : buffer -> view<192xi32>
 %mv = buffer.view %mode[%base] : buffer -> view<1xi32>
 %flag = view.load %mv[0] : view<1xi32> -> i32
 %li = index.cast %lane : index to i32
 %three = scalar.constant 3 : i32
 %class = scalar.andi %li,%three : i32
 %eff = scalar.muli %class,%flag : i32
 %four = scalar.constant 4 : i32
 %bound = scalar.subi %four,%eff : i32
 %zero = scalar.constant 0 : i32
 %one_i = scalar.constant 1 : i32
 %stride = index.constant 3 : index
 %row = index.mul %lane,%stride : index
 %j0 = index.constant 0 : index
 %ix0 = index.add %row,%j0 : index
 %v0 = view.load %iv[%ix0] : view<192xi32> -> i32
 %j1 = index.constant 1 : index
 %ix1 = index.add %row,%j1 : index
 %v1 = view.load %iv[%ix1] : view<192xi32> -> i32
 %j2 = index.constant 2 : index
 %ix2 = index.add %row,%j2 : index
 %v2 = view.load %iv[%ix2] : view<192xi32> -> i32
 %iterations, %r0, %r1, %r2 = scf.while(%i = %zero : i32, %x0 = %v0 : i32, %x1 = %v1 : i32, %x2 = %v2 : i32) -> (i32, i32, i32, i32) {
 %go = scalar.cmpi slt,%i,%bound : i32
 scf.condition %go,%i, %x0, %x1, %x2 : i1,i32,i32, i32, i32
 } do(%k: i32, %b0: i32, %b1: i32, %b2: i32) {
 %next = scalar.addi %k,%one_i : i32
 scf.yield %next,%b1, %b2, %b0 : i32,i32, i32, i32
 }
 %c0 = scalar.constant 0 : i32
 %is0 = scalar.cmpi eq,%class,%c0 : i32
 %c1 = scalar.constant 1 : i32
 %is1 = scalar.cmpi eq,%class,%c1 : i32
 %c2 = scalar.constant 2 : i32
 %is2 = scalar.cmpi eq,%class,%c2 : i32
 %uniform = scalar.cmpi eq,%flag,%zero : i32
 %e0_0_0 = scalar.constant 2 : i32
 %e0_1_0 = scalar.constant 2 : i32
 %e0_2_0 = scalar.constant 2 : i32
 %e0_3_0 = scalar.constant 2 : i32
 %e23_0_0 = scf.select %is2,%e0_2_0,%e0_3_0 : i32
 %e123_0_0 = scf.select %is1,%e0_1_0,%e23_0_0 : i32
 %case0_0 = scf.select %is0,%e0_0_0,%e123_0_0 : i32
 %e1_0_0 = scalar.constant 2 : i32
 %e1_1_0 = scalar.constant 1 : i32
 %e1_2_0 = scalar.constant 3 : i32
 %e1_3_0 = scalar.constant 2 : i32
 %e23_1_0 = scf.select %is2,%e1_2_0,%e1_3_0 : i32
 %e123_1_0 = scf.select %is1,%e1_1_0,%e23_1_0 : i32
 %case1_0 = scf.select %is0,%e1_0_0,%e123_1_0 : i32
 %expected0 = scf.select %uniform,%case0_0,%case1_0 : i32
 %diff0 = scalar.subi %r0,%expected0 : i32
 view.store %diff0,%ov[%ix0] : i32,view<192xi32>
 %e0_0_1 = scalar.constant 3 : i32
 %e0_1_1 = scalar.constant 3 : i32
 %e0_2_1 = scalar.constant 3 : i32
 %e0_3_1 = scalar.constant 3 : i32
 %e23_0_1 = scf.select %is2,%e0_2_1,%e0_3_1 : i32
 %e123_0_1 = scf.select %is1,%e0_1_1,%e23_0_1 : i32
 %case0_1 = scf.select %is0,%e0_0_1,%e123_0_1 : i32
 %e1_0_1 = scalar.constant 3 : i32
 %e1_1_1 = scalar.constant 2 : i32
 %e1_2_1 = scalar.constant 1 : i32
 %e1_3_1 = scalar.constant 3 : i32
 %e23_1_1 = scf.select %is2,%e1_2_1,%e1_3_1 : i32
 %e123_1_1 = scf.select %is1,%e1_1_1,%e23_1_1 : i32
 %case1_1 = scf.select %is0,%e1_0_1,%e123_1_1 : i32
 %expected1 = scf.select %uniform,%case0_1,%case1_1 : i32
 %diff1 = scalar.subi %r1,%expected1 : i32
 view.store %diff1,%ov[%ix1] : i32,view<192xi32>
 %e0_0_2 = scalar.constant 1 : i32
 %e0_1_2 = scalar.constant 1 : i32
 %e0_2_2 = scalar.constant 1 : i32
 %e0_3_2 = scalar.constant 1 : i32
 %e23_0_2 = scf.select %is2,%e0_2_2,%e0_3_2 : i32
 %e123_0_2 = scf.select %is1,%e0_1_2,%e23_0_2 : i32
 %case0_2 = scf.select %is0,%e0_0_2,%e123_0_2 : i32
 %e1_0_2 = scalar.constant 1 : i32
 %e1_1_2 = scalar.constant 3 : i32
 %e1_2_2 = scalar.constant 2 : i32
 %e1_3_2 = scalar.constant 1 : i32
 %e23_1_2 = scf.select %is2,%e1_2_2,%e1_3_2 : i32
 %e123_1_2 = scf.select %is1,%e1_1_2,%e23_1_2 : i32
 %case1_2 = scf.select %is0,%e1_0_2,%e123_1_2 : i32
 %expected2 = scf.select %uniform,%case0_2,%case1_2 : i32
 %diff2 = scalar.subi %r2,%expected2 : i32
 view.store %diff2,%ov[%ix2] : i32,view<192xi32>
 kernel.return
}
check.case @mixed {
 %input = check.generate.iota offset(1) step(1) period(3) : tensor<192xi32>
 %output = check.generate.fill value(-1) : tensor<192xi32>
 %mode = check.generate.fill value(1) : tensor<1xi32>
 %expected = check.generate.fill value(0) : tensor<192xi32>
 kernel.launch @rotate(%input,%output,%mode) : (tensor<192xi32>,tensor<192xi32>,tensor<1xi32>)
 check.expect.equal actual(%output) expected(%expected) : tensor<192xi32>
 check.return
}
check.case @uniform {
 %input = check.generate.iota offset(1) step(1) period(3) : tensor<192xi32>
 %output = check.generate.fill value(-1) : tensor<192xi32>
 %mode = check.generate.fill value(0) : tensor<1xi32>
 %expected = check.generate.fill value(0) : tensor<192xi32>
 kernel.launch @rotate(%input,%output,%mode) : (tensor<192xi32>,tensor<192xi32>,tensor<1xi32>)
 check.expect.equal actual(%output) expected(%expected) : tensor<192xi32>
 check.return
}
