check.case @divergent_pressure {
  %input = check.generate.fill value(1) : tensor<680xi32>
  %out = check.generate.fill value(-1) : tensor<680xi32>
  %expected = check.generate.fill value(0) : tensor<680xi32>
  %mode_value = check.generate.fill value(1) : tensor<1xi32>
  kernel.launch @pressure(%input, %out, %mode_value) : (tensor<680xi32>, tensor<680xi32>, tensor<1xi32>)
  check.expect.equal actual(%out) expected(%expected) : tensor<680xi32>
  check.return
}
check.case @uniform_trip_count {
  %input = check.generate.fill value(1) : tensor<680xi32>
  %out = check.generate.fill value(-1) : tensor<680xi32>
  %expected = check.generate.fill value(0) : tensor<680xi32>
  %mode_value = check.generate.fill value(0) : tensor<1xi32>
  kernel.launch @pressure(%input, %out, %mode_value) : (tensor<680xi32>, tensor<680xi32>, tensor<1xi32>)
  check.expect.equal actual(%out) expected(%expected) : tensor<680xi32>
  check.return
}
