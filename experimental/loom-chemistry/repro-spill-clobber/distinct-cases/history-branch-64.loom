check.case @mixed {
 %input = check.generate.iota offset(1) step(1) period(64) : tensor<256xi32>
 %output = check.generate.fill value(-1) : tensor<1024xi32>
 %mode = check.generate.fill value(1) : tensor<1xi32>
 %expected = check.generate.fill value(0) : tensor<1024xi32>
 kernel.launch @stress(%input,%output,%mode) : (tensor<256xi32>,tensor<1024xi32>,tensor<1xi32>)
 check.expect.equal actual(%output) expected(%expected) : tensor<1024xi32>
 check.return
}
check.case @uniform {
 %input = check.generate.iota offset(1) step(1) period(64) : tensor<256xi32>
 %output = check.generate.fill value(-1) : tensor<1024xi32>
 %mode = check.generate.fill value(0) : tensor<1xi32>
 %expected = check.generate.fill value(0) : tensor<1024xi32>
 kernel.launch @stress(%input,%output,%mode) : (tensor<256xi32>,tensor<1024xi32>,tensor<1xi32>)
 check.expect.equal actual(%output) expected(%expected) : tensor<1024xi32>
 check.return
}
