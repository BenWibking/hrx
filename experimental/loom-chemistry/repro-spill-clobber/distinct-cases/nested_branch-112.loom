check.case @nested_branch_divergent {
  %input = check.generate.fill value(1) : tensor<448xi32>
  %out = check.generate.fill value(-1) : tensor<448xi32>
  %expected = check.generate.fill value(0) : tensor<448xi32>
  %mode_value = check.generate.fill value(1) : tensor<1xi32>
  kernel.launch @pressure(%input, %out, %mode_value) : (tensor<448xi32>, tensor<448xi32>, tensor<1xi32>)
  check.expect.equal actual(%out) expected(%expected) : tensor<448xi32>
  check.return
}
check.case @nested_branch_uniform {
  %input = check.generate.fill value(1) : tensor<448xi32>
  %out = check.generate.fill value(-1) : tensor<448xi32>
  %expected = check.generate.fill value(0) : tensor<448xi32>
  %mode_value = check.generate.fill value(0) : tensor<1xi32>
  kernel.launch @pressure(%input, %out, %mode_value) : (tensor<448xi32>, tensor<448xi32>, tensor<1xi32>)
  check.expect.equal actual(%out) expected(%expected) : tensor<448xi32>
  check.return
}
