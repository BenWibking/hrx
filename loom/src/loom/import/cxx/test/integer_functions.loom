func.decl @fixed_multiply(%left: i32, %right: i32) -> (i32)

func.decl @byte_increment(%input: i32) -> (i32)

func.decl @byte_decrement(%input: i32) -> (i32)

func.decl @short_decrement(%input: i32) -> (i32)

func.decl @wide_increment(%input: i64) -> (i64)

func.decl @shift_left_narrow(%value: i32, %count: i64) -> (i32)

func.decl @shift_left_wide(%value: i64, %count: i32) -> (i64)

func.decl @shift_right_signed(%value: i64, %count: i32) -> (i64)

func.decl @shift_right_unsigned(%value: i64, %count: i32) -> (i64)

global.rodata.def @fixed_multiply_trials = align(4) bytes("00000000ffffffff0000010000000100fffffeff00800100010001000080feff0000008000000100ffffff7f0000010039300000851a0000")

global.rodata.def @byte_trials = align(4) bytes("000000007f00000080000000fe000000ff000000ff010000")

global.rodata.def @short_trials = align(4) bytes("0180ffff7fffffffffffffff0000000001000000ff7f0000")

global.rodata.def @wide_trials = align(8) bytes("00000000000000007e00000000000000fe00000000000000ff00000000000000ffffffff000000000000000001000000ffffffffffffff7f0000000000000080ffffffffffffffff")

global.rodata.def @narrow_shift_values = align(4) bytes("00000000010000007856341200000080ffffffff")

global.rodata.def @narrow_shift_counts = align(8) bytes("0000000000000000010000000000000010000000000000001f00000000000000")

global.rodata.def @wide_shift_values = align(8) bytes("00000000000000000100000000000000fffffffffffffffffffffeffffffffffefcdab89674523010000000000000080")

global.rodata.def @wide_shift_counts = align(4) bytes("0000000001000000100000001f000000200000003f000000")

func.def @fixed_multiply_inputs(%trial: index) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %pair_width = index.constant 2 : index
  %step = index.constant 1 : index
  %bounded_trial = index.assume %trial [range(%trial, 0, 6)] : index
  %left_position = index.mul %bounded_trial, %pair_width : index
  %right_position = index.add %left_position, %step : index
  %storage = global.load @fixed_multiply_trials : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<14xi32>
  %left = view.load %values[%left_position] : view<14xi32> -> i32
  %right = view.load %values[%right_position] : view<14xi32> -> i32
  func.return %left, %right : i32, i32
}

func.def @byte_input(%trial: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 5)] : index
  %storage = global.load @byte_trials : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %input = view.load %values[%bounded_trial] : view<6xi32> -> i32
  func.return %input : i32
}

func.def @short_input(%trial: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 5)] : index
  %storage = global.load @short_trials : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %input = view.load %values[%bounded_trial] : view<6xi32> -> i32
  func.return %input : i32
}

func.def @wide_input(%trial: index) -> (i64) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 8)] : index
  %storage = global.load @wide_trials : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<9xi64>
  %input = view.load %values[%bounded_trial] : view<9xi64> -> i64
  func.return %input : i64
}

func.def @narrow_shift_input(%trial: index) -> (i32, i64) {
  %origin = index.constant 0 : offset
  %count_span = index.constant 4 : index
  %bounded_trial = index.assume %trial [range(%trial, 0, 19)] : index
  %value_position = index.div %bounded_trial, %count_span : index
  %count_position = index.rem %bounded_trial, %count_span : index
  %value_storage = global.load @narrow_shift_values : buffer
  %values = buffer.view %value_storage[%origin] : buffer -> view<5xi32>
  %count_storage = global.load @narrow_shift_counts : buffer
  %counts = buffer.view %count_storage[%origin] : buffer -> view<4xi64>
  %value = view.load %values[%value_position] : view<5xi32> -> i32
  %count = view.load %counts[%count_position] : view<4xi64> -> i64
  func.return %value, %count : i32, i64
}

func.def @wide_shift_input(%trial: index) -> (i64, i32) {
  %origin = index.constant 0 : offset
  %count_span = index.constant 6 : index
  %bounded_trial = index.assume %trial [range(%trial, 0, 35)] : index
  %value_position = index.div %bounded_trial, %count_span : index
  %count_position = index.rem %bounded_trial, %count_span : index
  %value_storage = global.load @wide_shift_values : buffer
  %values = buffer.view %value_storage[%origin] : buffer -> view<6xi64>
  %count_storage = global.load @wide_shift_counts : buffer
  %counts = buffer.view %count_storage[%origin] : buffer -> view<6xi32>
  %value = view.load %values[%value_position] : view<6xi64> -> i64
  %count = view.load %counts[%count_position] : view<6xi32> -> i32
  func.return %value, %count : i64, i32
}

func.def @fixed_multiply_observation(%left: i32, %right: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %result = func.call @fixed_multiply(%left, %right) : (i32, i32) -> (i32)
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  func.return
}

func.def @fixed_multiply_oracle(%left: i32, %right: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %shift = scalar.constant 16 : i64
  %wide_left = scalar.extsi %left : i32 to i64
  %wide_right = scalar.extsi %right : i32 to i64
  %product = scalar.muli %wide_left, %wide_right : i64
  %scaled = scalar.shrsi %product, %shift : i64
  %result = scalar.trunci %scaled : i64 to i32
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  func.return
}

func.def @byte_observations(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %incremented = func.call @byte_increment(%input) : (i32) -> (i32)
  %decremented = func.call @byte_decrement(%input) : (i32) -> (i32)
  %view = buffer.view %output[%origin] : buffer -> view<2xi32>
  view.store %incremented, %view[0] : i32, view<2xi32>
  view.store %decremented, %view[1] : i32, view<2xi32>
  func.return
}

func.def @byte_oracle(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %c1 = scalar.constant 1 : i8
  %narrow = scalar.trunci %input : i32 to i8
  %incremented_narrow = scalar.addi %narrow, %c1 : i8
  %decremented_narrow = scalar.subi %narrow, %c1 : i8
  %incremented = scalar.extui %incremented_narrow : i8 to i32
  %decremented = scalar.extui %decremented_narrow : i8 to i32
  %view = buffer.view %output[%origin] : buffer -> view<2xi32>
  view.store %incremented, %view[0] : i32, view<2xi32>
  view.store %decremented, %view[1] : i32, view<2xi32>
  func.return
}

func.def @short_decrement_observation(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %result = func.call @short_decrement(%input) : (i32) -> (i32)
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  func.return
}

func.def @short_decrement_oracle(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %c1 = scalar.constant 1 : i16
  %narrow = scalar.trunci %input : i32 to i16
  %decremented = scalar.subi %narrow, %c1 : i16
  %result = scalar.extsi %decremented : i16 to i32
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  func.return
}

func.def @wide_increment_observation(%input: i64, %output: buffer) {
  %origin = index.constant 0 : offset
  %result = func.call @wide_increment(%input) : (i64) -> (i64)
  %view = buffer.view %output[%origin] : buffer -> view<1xi64>
  view.store %result, %view[0] : i64, view<1xi64>
  func.return
}

func.def @wide_increment_oracle(%input: i64, %output: buffer) {
  %origin = index.constant 0 : offset
  %c1 = scalar.constant 1 : i64
  %result = scalar.addi %input, %c1 : i64
  %view = buffer.view %output[%origin] : buffer -> view<1xi64>
  view.store %result, %view[0] : i64, view<1xi64>
  func.return
}

func.def @narrow_shift_observation(%value: i32, %count: i64, %output: buffer) {
  %origin = index.constant 0 : offset
  %result = func.call @shift_left_narrow(%value, %count) : (i32, i64) -> (i32)
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  func.return
}

func.def @narrow_shift_oracle(%value: i32, %count: i64, %output: buffer) {
  %origin = index.constant 0 : offset
  %narrow_count = scalar.trunci %count : i64 to i32
  %result = scalar.shli %value, %narrow_count : i32
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  func.return
}

func.def @wide_shift_observations(%value: i64, %count: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %left = func.call @shift_left_wide(%value, %count) : (i64, i32) -> (i64)
  %signed_right = func.call @shift_right_signed(%value, %count) : (i64, i32) -> (i64)
  %unsigned_right = func.call @shift_right_unsigned(%value, %count) : (i64, i32) -> (i64)
  %view = buffer.view %output[%origin] : buffer -> view<3xi64>
  view.store %left, %view[0] : i64, view<3xi64>
  view.store %signed_right, %view[1] : i64, view<3xi64>
  view.store %unsigned_right, %view[2] : i64, view<3xi64>
  func.return
}

func.def @wide_shift_oracle(%value: i64, %count: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %wide_count = scalar.extui %count : i32 to i64
  %left = scalar.shli %value, %wide_count : i64
  %signed_right = scalar.shrsi %value, %wide_count : i64
  %unsigned_right = scalar.shrui %value, %wide_count : i64
  %view = buffer.view %output[%origin] : buffer -> view<3xi64>
  view.store %left, %view[0] : i64, view<3xi64>
  view.store %signed_right, %view[1] : i64, view<3xi64>
  view.store %unsigned_right, %view[2] : i64, view<3xi64>
  func.return
}

check.scenario @integer_functions {
  check.trial[7](%trial: index, %entropy: check.entropy) {
    %left, %right = check.generate<@fixed_multiply_inputs>(%trial) : (index) -> (i32, i32)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@fixed_multiply_observation, @fixed_multiply_oracle>(%left, %right, %output) : (i32, i32, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@byte_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<2xi32>
    check.compare<@byte_observations, @byte_oracle>(%input, %output) : (i32, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@short_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@short_decrement_observation, @short_decrement_oracle>(%input, %output) : (i32, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[9](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@wide_input>(%trial) : (index) -> (i64)
    %output = check.generate.fill value(-123) : tensor<1xi64>
    check.compare<@wide_increment_observation, @wide_increment_oracle>(%input, %output) : (i64, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi64>
    }
  }
  check.trial[20](%trial: index, %entropy: check.entropy) {
    %value, %count = check.generate<@narrow_shift_input>(%trial) : (index) -> (i32, i64)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@narrow_shift_observation, @narrow_shift_oracle>(%value, %count, %output) : (i32, i64, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[36](%trial: index, %entropy: check.entropy) {
    %value, %count = check.generate<@wide_shift_input>(%trial) : (index) -> (i64, i32)
    %output = check.generate.fill value(-123) : tensor<3xi64>
    check.compare<@wide_shift_observations, @wide_shift_oracle>(%value, %count, %output) : (i64, i32, tensor<3xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3xi64>
    }
  }
  check.return
}
