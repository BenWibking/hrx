func.decl @comparison_chain(%first: i32, %second: i32, %third: i32, %fourth: i32, %fifth: i32, %sixth: i32, %seventh: i32) -> (i32)

func.def @comparison_inputs(%trial: index) -> (i32, i32, i32, i32, i32, i32, i32) {
  %bounded_trial = index.assume %trial [range(%trial, 0, 135)] : index
  %mask_end = index.constant 128 : index
  %special_base = index.constant 129 : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %is_mask = index.cmp ult, %bounded_trial, %mask_end : index
  %trial_i32 = index.cast %bounded_trial : index to i32
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c8_i32 = scalar.constant 8 : i32
  %c16_i32 = scalar.constant 16 : i32
  %c32_i32 = scalar.constant 32 : i32
  %c64_i32 = scalar.constant 64 : i32
  %c255 = scalar.constant 255 : i32
  %c256 = scalar.constant 256 : i32
  %maximum = scalar.constant -1 : i32
  %first_bit = scalar.andi %trial_i32, %c1_i32 : i32
  %second_bit = scalar.andi %trial_i32, %c2_i32 : i32
  %third_bit = scalar.andi %trial_i32, %c4_i32 : i32
  %fourth_bit = scalar.andi %trial_i32, %c8_i32 : i32
  %fifth_bit = scalar.andi %trial_i32, %c16_i32 : i32
  %sixth_bit = scalar.andi %trial_i32, %c32_i32 : i32
  %seventh_bit = scalar.andi %trial_i32, %c64_i32 : i32
  %first_set = scalar.cmpi ne, %first_bit, %c0_i32 : i32
  %second_set = scalar.cmpi ne, %second_bit, %c0_i32 : i32
  %third_set = scalar.cmpi ne, %third_bit, %c0_i32 : i32
  %fourth_set = scalar.cmpi ne, %fourth_bit, %c0_i32 : i32
  %fifth_set = scalar.cmpi ne, %fifth_bit, %c0_i32 : i32
  %sixth_set = scalar.cmpi ne, %sixth_bit, %c0_i32 : i32
  %seventh_set = scalar.cmpi ne, %seventh_bit, %c0_i32 : i32
  %first_mask = scf.select %first_set, %c256, %c255 : i32
  %second_mask = scf.select %second_set, %c256, %c255 : i32
  %third_mask = scf.select %third_set, %c256, %c255 : i32
  %fourth_mask = scf.select %fourth_set, %c256, %c255 : i32
  %fifth_mask = scf.select %fifth_set, %c256, %c255 : i32
  %sixth_mask = scf.select %sixth_set, %c256, %c255 : i32
  %seventh_mask = scf.select %seventh_set, %c256, %c255 : i32
  %first_trial = index.add %special_base, %c0 : index
  %second_trial = index.add %special_base, %c1 : index
  %third_trial = index.add %special_base, %c2 : index
  %fourth_trial = index.add %special_base, %c3 : index
  %fifth_trial = index.add %special_base, %c4 : index
  %sixth_trial = index.add %special_base, %c5 : index
  %seventh_trial = index.add %special_base, %c6 : index
  %first_special = index.cmp eq, %bounded_trial, %first_trial : index
  %second_special = index.cmp eq, %bounded_trial, %second_trial : index
  %third_special = index.cmp eq, %bounded_trial, %third_trial : index
  %fourth_special = index.cmp eq, %bounded_trial, %fourth_trial : index
  %fifth_special = index.cmp eq, %bounded_trial, %fifth_trial : index
  %sixth_special = index.cmp eq, %bounded_trial, %sixth_trial : index
  %seventh_special = index.cmp eq, %bounded_trial, %seventh_trial : index
  %first_tail = scf.select %first_special, %maximum, %c0_i32 : i32
  %second_tail = scf.select %second_special, %maximum, %c0_i32 : i32
  %third_tail = scf.select %third_special, %maximum, %c0_i32 : i32
  %fourth_tail = scf.select %fourth_special, %maximum, %c0_i32 : i32
  %fifth_tail = scf.select %fifth_special, %maximum, %c0_i32 : i32
  %sixth_tail = scf.select %sixth_special, %maximum, %c0_i32 : i32
  %seventh_tail = scf.select %seventh_special, %maximum, %c0_i32 : i32
  %first = scf.select %is_mask, %first_mask, %first_tail : i32
  %second = scf.select %is_mask, %second_mask, %second_tail : i32
  %third = scf.select %is_mask, %third_mask, %third_tail : i32
  %fourth = scf.select %is_mask, %fourth_mask, %fourth_tail : i32
  %fifth = scf.select %is_mask, %fifth_mask, %fifth_tail : i32
  %sixth = scf.select %is_mask, %sixth_mask, %sixth_tail : i32
  %seventh = scf.select %is_mask, %seventh_mask, %seventh_tail : i32
  func.return %first, %second, %third, %fourth, %fifth, %sixth, %seventh : i32, i32, i32, i32, i32, i32, i32
}

func.def @comparison_observation(%first: i32, %second: i32, %third: i32, %fourth: i32, %fifth: i32, %sixth: i32, %seventh: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %result = func.call @comparison_chain(%first, %second, %third, %fourth, %fifth, %sixth, %seventh) : (i32, i32, i32, i32, i32, i32, i32) -> (i32)
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  func.return
}

func.def @comparison_oracle(%first: i32, %second: i32, %third: i32, %fourth: i32, %fifth: i32, %sixth: i32, %seventh: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %limit = scalar.constant 256 : i32
  %first_in_range = scalar.cmpi ult, %first, %limit : i32
  %second_in_range = scalar.cmpi ult, %second, %limit : i32
  %third_in_range = scalar.cmpi ult, %third, %limit : i32
  %fourth_in_range = scalar.cmpi ult, %fourth, %limit : i32
  %fifth_in_range = scalar.cmpi ult, %fifth, %limit : i32
  %sixth_in_range = scalar.cmpi ult, %sixth, %limit : i32
  %seventh_in_range = scalar.cmpi ult, %seventh, %limit : i32
  %first_pair = scalar.andi %first_in_range, %second_in_range : i1
  %second_pair = scalar.andi %third_in_range, %fourth_in_range : i1
  %third_pair = scalar.andi %fifth_in_range, %sixth_in_range : i1
  %first_four = scalar.andi %first_pair, %second_pair : i1
  %first_six = scalar.andi %first_four, %third_pair : i1
  %all = scalar.andi %first_six, %seventh_in_range : i1
  %result = scalar.extui %all : i1 to i32
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %result, %view[0] : i32, view<1xi32>
  func.return
}

check.scenario @comparison_functions {
  check.trial[136](%trial: index, %entropy: check.entropy) {
    %first, %second, %third, %fourth, %fifth, %sixth, %seventh = check.generate<@comparison_inputs>(%trial) : (index) -> (i32, i32, i32, i32, i32, i32, i32)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@comparison_observation, @comparison_oracle>(%first, %second, %third, %fourth, %fifth, %sixth, %seventh, %output) : (i32, i32, i32, i32, i32, i32, i32, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}
