func.decl @schedule_call(%count: i32) -> (i32)

func.decl @schedule_snapshot(%count: i32) -> (i32)

func.decl @schedule_wide(%count: i32) -> (i32)

func.decl @schedule_narrow(%count: i32) -> (i32)

func.decl @schedule_signed(%count: i32) -> (i32)

func.decl @schedule_unevaluated(%count: i32) -> (i32)

func.decl @schedule_initializer(%count: i32) -> (i32)

func.decl @schedule_serial(%count: i32) -> (i32)

global.rodata.def @schedule_trials = align(4) bytes("00000000010000000200000003000000040000000500000007000000100000001100000021000000")

func.def @schedule_input(%trial: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 9)] : index
  %storage = global.load @schedule_trials : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<10xi32>
  %count = view.load %values[%bounded_trial] : view<10xi32> -> i32
  func.return %count : i32
}

func.def @schedule_observations(%count: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %call = func.call @schedule_call(%count) : (i32) -> (i32)
  %snapshot = func.call @schedule_snapshot(%count) : (i32) -> (i32)
  %wide = func.call @schedule_wide(%count) : (i32) -> (i32)
  %narrow = func.call @schedule_narrow(%count) : (i32) -> (i32)
  %signed = func.call @schedule_signed(%count) : (i32) -> (i32)
  %unevaluated = func.call @schedule_unevaluated(%count) : (i32) -> (i32)
  %initializer = func.call @schedule_initializer(%count) : (i32) -> (i32)
  %serial = func.call @schedule_serial(%count) : (i32) -> (i32)
  %results = buffer.view %output[%origin] : buffer -> view<8xi32>
  view.store %call, %results[0] : i32, view<8xi32>
  view.store %snapshot, %results[1] : i32, view<8xi32>
  view.store %wide, %results[2] : i32, view<8xi32>
  view.store %narrow, %results[3] : i32, view<8xi32>
  view.store %signed, %results[4] : i32, view<8xi32>
  view.store %unevaluated, %results[5] : i32, view<8xi32>
  view.store %initializer, %results[6] : i32, view<8xi32>
  view.store %serial, %results[7] : i32, view<8xi32>
  func.return
}

func.def @schedule_oracle(%count: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c73 = scalar.constant 73 : i32
  %predecessor = scalar.subi %count, %c1 : i32
  %product = scalar.muli %count, %predecessor : i32
  %sum = scalar.divui %product, %c2 : i32
  %snapshot_partial = scalar.addi %sum, %count : i32
  %snapshot = scalar.addi %snapshot_partial, %c3 : i32
  %unevaluated_partial = scalar.addi %sum, %count : i32
  %unevaluated = scalar.addi %unevaluated_partial, %c73 : i32
  %results = buffer.view %output[%origin] : buffer -> view<8xi32>
  view.store %sum, %results[0] : i32, view<8xi32>
  view.store %snapshot, %results[1] : i32, view<8xi32>
  view.store %sum, %results[2] : i32, view<8xi32>
  view.store %sum, %results[3] : i32, view<8xi32>
  view.store %sum, %results[4] : i32, view<8xi32>
  view.store %unevaluated, %results[5] : i32, view<8xi32>
  view.store %sum, %results[6] : i32, view<8xi32>
  view.store %sum, %results[7] : i32, view<8xi32>
  func.return
}

check.scenario @schedule_values_functions {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %count = check.generate<@schedule_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<8xi32>
    check.compare<@schedule_observations, @schedule_oracle>(%count, %output) : (i32, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.return
}
