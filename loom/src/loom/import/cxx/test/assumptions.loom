    %seven = func.call @bound_seven_oracle(%byte, %c1_i32, %c2_i32, %c3_i32, %c5_i32, %c7_i32, %c11_i32) : (i32, i32, i32, i32, i32, i32, i32) -> (i32)
    %repeated_input = scalar.andi %value, %c31_i32 : i32
    %repeated = func.call @bound_repeated_oracle(%repeated_input) : (i32) -> (i32)
    %capacity_input = scalar.remui %value, %c428_i32 : i32
    %capacity = func.call @bound_capacity_oracle(%capacity_input) : (i32) -> (i32)
    %cast_input = scalar.andi %value, %c15_i32 : i32
    %cast = func.call @bound_cast_oracle(%cast_input) : (i32) -> (i32)
    %byte_input = scalar.trunci %byte : i32 to i8
    %byte_result = func.call @bound_byte_oracle(%byte_input) : (i8) -> (i32)
    %wide_input = scalar.extui %byte : i32 to i64
    %wide = func.call @bound_wide_oracle(%wide_input) : (i64) -> (i32)
    %size = func.call @bound_size_oracle(%cast_input) : (i32) -> (i32)
    %scoped = func.call @bound_scoped_oracle(%value) : (i32) -> (i32)
    %inclusive = func.call @bound_inclusive_oracle(%capacity_input) : (i32) -> (i32)
    %hidden_base = scalar.remui %value, %c63_i32 : i32
    %hidden = scalar.addi %hidden_base, %c1_i32 : i32
    %capacity_delta = scalar.remui %value, %c5_i32 : i32
    %signed_capacity = scalar.addi %hidden, %capacity_delta : i32
    %signed = func.call @bound_signed_oracle(%hidden, %signed_capacity) : (i32, i32) -> (i32)
    %tokens = scalar.andi %value, %low_mask : i32
    %token_capacity = scalar.ori %tokens, %high_bit : i32
    %unsigned = func.call @bound_unsigned_oracle(%tokens, %token_capacity) : (i32, i32) -> (i32)
    %position_0 = index.mul %lane, %field_count : index
    %position_1 = index.add %position_0, %c1_index : index
    %position_2 = index.add %position_0, %c2_index : index
    %position_3 = index.add %position_0, %c3_index : index
    %position_4 = index.add %position_0, %c4_index : index
    %position_5 = index.add %position_0, %c5_index : index
    %position_6 = index.add %position_0, %c6_index : index
    %position_7 = index.add %position_0, %c7_index : index
    %position_8 = index.add %position_0, %c8_index : index
    %position_9 = index.add %position_0, %c9_index : index
    %position_10 = index.add %position_0, %c10_index : index
    %position_11 = index.add %position_0, %c11_index : index
    view.store %pair, %results[%position_0] : i32, view<768xi32>
    view.store %seven, %results[%position_1] : i32, view<768xi32>
    view.store %repeated, %results[%position_2] : i32, view<768xi32>
    view.store %capacity, %results[%position_3] : i32, view<768xi32>
    view.store %cast, %results[%position_4] : i32, view<768xi32>
    view.store %byte_result, %results[%position_5] : i32, view<768xi32>
    view.store %wide, %results[%position_6] : i32, view<768xi32>
    view.store %size, %results[%position_7] : i32, view<768xi32>
    view.store %scoped, %results[%position_8] : i32, view<768xi32>
    view.store %inclusive, %results[%position_9] : i32, view<768xi32>
    view.store %signed, %results[%position_10] : i32, view<768xi32>
    view.store %unsigned, %results[%position_11] : i32, view<768xi32>
  }
  func.return
}

check.scenario @assumptions_functions {
  check.trial[36](%trial: index, %entropy: check.entropy) {
    %first, %second = check.generate<@assumption_pair_input>(%trial) : (index) -> (i32, i32)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@bound_pair_observation, @bound_pair_reference>(%first, %second, %output) : (i32, i32, tensor<1xi32>) -> () {
