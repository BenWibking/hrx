  %wide_high = scalar.constant 1099511627776 : i64
  %specialization_base = scalar.constant 1103806595071 : i64
  %specialization_next = scalar.constant 1103806595075 : i64
  %is_water = scalar.cmpi eq, %input, %c1 : i32
  %is_alias_or_later = scalar.cmpi uge, %input, %c5 : i32
  %offset = scalar.addi %input, %c7 : i32
  %alias_or_offset = scf.select %is_alias_or_later, %c255, %offset : i32
  %dispatch = scf.select %is_water, %c128, %alias_or_offset : i32
  %input_wide = scalar.extui %input : i32 to i64
  %unsigned = scalar.addi %input_wide, %wide_c1 : i64
  %chosen = scalar.cmpi ne, %input, %c0 : i32
  %inferred = scf.select %chosen, %wide_high, %wide_low : i64
  %specialization = scf.select %chosen, %specialization_next, %specialization_base : i64
  %boolean = scalar.extui %chosen : i1 to i32
  %dispatch_wide = scalar.extui %dispatch : i32 to i64
  %boolean_wide = scalar.extui %boolean : i32 to i64
  view.store %dispatch_wide, %results[0] : i64, view<5xi64>
  view.store %unsigned, %results[1] : i64, view<5xi64>
  view.store %inferred, %results[2] : i64, view<5xi64>
  view.store %specialization, %results[3] : i64, view<5xi64>
  view.store %boolean_wide, %results[4] : i64, view<5xi64>
  func.return
}

