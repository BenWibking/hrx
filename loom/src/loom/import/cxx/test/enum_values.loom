check.scenario @enum_values_functions {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@enum_command_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<5xi64>
    check.compare<@enum_command_observations, @enum_command_oracle>(%input, %output) : (i32, tensor<5xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi64>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@enum_byte_input>(%trial) : (index) -> (i8)
    %output = check.generate.fill value(-123) : tensor<2xi32>
    check.compare<@enum_byte_observations, @enum_byte_oracle>(%input, %output) : (i8, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@enum_byte_input>(%trial) : (index) -> (i8)
    %output = check.generate.fill value(-123) : tensor<2xi64>
    check.compare<@enum_signed_byte_observations, @enum_signed_byte_oracle>(%input, %output) : (i8, tensor<2xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi64>
    }
  }
  check.trial[49](%trial: index, %entropy: check.entropy) {
    %left, %right = check.generate<@enum_wide_pair_input>(%trial) : (index) -> (i64, i64)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@enum_compare64_observation, @enum_compare64_oracle>(%left, %right, %output) : (i64, i64, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[7](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@enum_wide_input>(%trial) : (index) -> (i64)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@enum_inferred_unsigned_observation, @enum_inferred_unsigned_oracle>(%input, %output) : (i64, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}

check.scenario @enum_storage_values {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<64xi8>
    check.generate<@enum_storage_u8_input>(%input) : (tensor<64xi8>) -> ()
    %delta = check.generate<@enum_storage_u8_delta>(%trial) : (index) -> (i8)
    %storage = check.generate.fill value(-123) : tensor<96xi8>
    %output = check.tensor.view %storage offset(16) : tensor<96xi8> -> tensor<64xi8>
    check.compare<@enum_storage_u8, @enum_storage_u8_oracle>(%input, %output, %delta) : (tensor<64xi8>, tensor<64xi8>, i8) -> () {
