func.def @enum_command_observations(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<5xi64>
  %dispatch = func.call @enum_dispatch(%input) : (i32) -> (i32)
