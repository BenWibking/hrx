func.decl @constructor_return(%input: i32, %lane: i32) -> (i32)

func.decl @constructor_argument(%input: i32, %lane: i32) -> (i32)

func.decl @constructor_single(%input: i32, %lane: i32) -> (i32)

func.decl @constructor_narrow(%input: i32, %lane: i32) -> (i32)

func.decl @constructor_float(%input: i32, %lane: i32) -> (i32)

func.decl @constructor_nested(%input: i32, %lane: i32) -> (i32)

kernel.decl @vector_initializers() launch(%output: buffer, %input: i32)

global.rodata.def @vector_initializer_trials = align(4) bytes("00000000010000007f000000ff0000000001000080fffffffcffff7fffffffff")

func.def @vector_initializer_input(%trial: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 7)] : index
  %trial_buffer = global.load @vector_initializer_trials : buffer
  %trials = buffer.view %trial_buffer[%origin] : buffer -> view<8xi32>
  %input = view.load %trials[%bounded_trial] : view<8xi32> -> i32
  func.return %input : i32
}

func.def @vector_initializer_observations(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %lane_count = index.constant 4 : index
  %narrow_lane_count = index.constant 16 : index
  %step = index.constant 1 : index
  %argument_base = index.constant 4 : index
  %single_base = index.constant 8 : index
  %narrow_base = index.constant 12 : index
  %float_base = index.constant 28 : index
  %nested_base = index.constant 32 : index
  %results = buffer.view %output[%origin] : buffer -> view<36xi32>
  scf.for %lane = [%begin to %lane_count step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %return_value = func.call @constructor_return(%input, %lane_i32) : (i32, i32) -> (i32)
    %argument_value = func.call @constructor_argument(%input, %lane_i32) : (i32, i32) -> (i32)
    %single_value = func.call @constructor_single(%input, %lane_i32) : (i32, i32) -> (i32)
    %float_value = func.call @constructor_float(%input, %lane_i32) : (i32, i32) -> (i32)
    %nested_value = func.call @constructor_nested(%input, %lane_i32) : (i32, i32) -> (i32)
    %argument_index = index.add %argument_base, %lane : index
    %single_index = index.add %single_base, %lane : index
    %float_index = index.add %float_base, %lane : index
    %nested_index = index.add %nested_base, %lane : index
    view.store %return_value, %results[%lane] : i32, view<36xi32>
    view.store %argument_value, %results[%argument_index] : i32, view<36xi32>
    view.store %single_value, %results[%single_index] : i32, view<36xi32>
    view.store %float_value, %results[%float_index] : i32, view<36xi32>
    view.store %nested_value, %results[%nested_index] : i32, view<36xi32>
  }
  scf.for %lane = [%begin to %narrow_lane_count step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %value = func.call @constructor_narrow(%input, %lane_i32) : (i32, i32) -> (i32)
    %index = index.add %narrow_base, %lane : index
    view.store %value, %results[%index] : i32, view<36xi32>
  }
  func.return
}

func.def @vector_initializer_reference(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %lane_count = index.constant 4 : index
  %narrow_lane_count = index.constant 16 : index
  %step = index.constant 1 : index
  %argument_base = index.constant 4 : index
  %single_base = index.constant 8 : index
  %narrow_base = index.constant 12 : index
  %float_base = index.constant 28 : index
  %nested_base = index.constant 32 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c7 = scalar.constant 7 : i32
  %c9 = scalar.constant 9 : i32
  %c128 = scalar.constant 128 : i32
  %c255 = scalar.constant 255 : i32
  %float_sign_bit = scalar.constant -2147483648 : i32
  %one_and_half = scalar.constant 1069547520 : i32
  %input_float = scalar.sitofp %input : i32 to f32
  %input_float_bits = scalar.bitcast %input_float : f32 to i32
  %narrow_input = scalar.trunci %input : i32 to i8
  %narrow_input_wide = scalar.extui %narrow_input : i8 to i32
  %nested_first = scalar.addi %input, %c9 : i32
  %results = buffer.view %output[%origin] : buffer -> view<36xi32>
  scf.for %lane = [%begin to %lane_count step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1 : i32
    %is_third = scalar.cmpi eq, %lane_i32, %c2 : i32
    %return_value = scalar.addi %input, %lane_i32 : i32
    %argument_tail = scf.select %is_second, %c7, %c0 : i32
    %argument_value = scf.select %is_first, %input, %argument_tail : i32
    %single_value = scf.select %is_first, %input, %c0 : i32
    %float_tail0 = scf.select %is_second, %float_sign_bit, %c0 : i32
    %float_tail1 = scf.select %is_third, %one_and_half, %float_tail0 : i32
    %float_value = scf.select %is_first, %input_float_bits, %float_tail1 : i32
    %nested_value = scf.select %is_first, %nested_first, %c9 : i32
    %argument_index = index.add %argument_base, %lane : index
    %single_index = index.add %single_base, %lane : index
    %float_index = index.add %float_base, %lane : index
    %nested_index = index.add %nested_base, %lane : index
    view.store %return_value, %results[%lane] : i32, view<36xi32>
    view.store %argument_value, %results[%argument_index] : i32, view<36xi32>
    view.store %single_value, %results[%single_index] : i32, view<36xi32>
    view.store %float_value, %results[%float_index] : i32, view<36xi32>
    view.store %nested_value, %results[%nested_index] : i32, view<36xi32>
  }
  scf.for %lane = [%begin to %narrow_lane_count step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1 : i32
    %is_third = scalar.cmpi eq, %lane_i32, %c2 : i32
    %tail0 = scf.select %is_second, %c255, %c0 : i32
    %tail1 = scf.select %is_third, %c128, %tail0 : i32
    %value = scf.select %is_first, %narrow_input_wide, %tail1 : i32
    %index = index.add %narrow_base, %lane : index
    view.store %value, %results[%index] : i32, view<36xi32>
  }
  func.return
}

func.def @vector_initializers_oracle(%output: buffer, %input: i32) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %lane_count = index.constant 4 : index
  %step = index.constant 1 : index
  %argument_base = index.constant 4 : index
  %single_base = index.constant 8 : index
  %narrow_base = index.constant 12 : index
  %float_base = index.constant 16 : index
  %nested_base = index.constant 20 : index
  %sequence_base = index.constant 24 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c7 = scalar.constant 7 : i32
  %c9 = scalar.constant 9 : i32
  %narrow_mask = scalar.constant 8453888 : i32
  %float_sign_bit = scalar.constant -2147483648 : i32
  %one_and_half = scalar.constant 1069547520 : i32
  %trace = scalar.constant 1234 : i32
  %input_float = scalar.sitofp %input : i32 to f32
  %input_float_bits = scalar.bitcast %input_float : f32 to i32
  %narrow_input = scalar.trunci %input : i32 to i8
  %narrow_input_wide = scalar.extui %narrow_input : i8 to i32
  %narrow_word = scalar.ori %narrow_input_wide, %narrow_mask : i32
  %nested_first = scalar.addi %input, %c9 : i32
  %results = buffer.view %output[%origin] : buffer -> view<32xi32>
  scf.for %lane = [%begin to %lane_count step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1 : i32
    %is_third = scalar.cmpi eq, %lane_i32, %c2 : i32
    %return_value = scalar.addi %input, %lane_i32 : i32
    %argument_tail = scf.select %is_second, %c7, %c0 : i32
    %argument_value = scf.select %is_first, %input, %argument_tail : i32
    %single_value = scf.select %is_first, %input, %c0 : i32
    %narrow_value = scf.select %is_first, %narrow_word, %c0 : i32
    %float_tail0 = scf.select %is_second, %float_sign_bit, %c0 : i32
    %float_tail1 = scf.select %is_third, %one_and_half, %float_tail0 : i32
    %float_value = scf.select %is_first, %input_float_bits, %float_tail1 : i32
    %nested_value = scf.select %is_first, %nested_first, %c9 : i32
    %argument_index = index.add %argument_base, %lane : index
    %single_index = index.add %single_base, %lane : index
    %narrow_index = index.add %narrow_base, %lane : index
    %float_index = index.add %float_base, %lane : index
    %nested_index = index.add %nested_base, %lane : index
    %sequence_index = index.add %sequence_base, %lane : index
    view.store %return_value, %results[%lane] : i32, view<32xi32>
    view.store %argument_value, %results[%argument_index] : i32, view<32xi32>
    view.store %single_value, %results[%single_index] : i32, view<32xi32>
    view.store %narrow_value, %results[%narrow_index] : i32, view<32xi32>
    view.store %float_value, %results[%float_index] : i32, view<32xi32>
    view.store %nested_value, %results[%nested_index] : i32, view<32xi32>
    view.store %return_value, %results[%sequence_index] : i32, view<32xi32>
  }
  view.store %trace, %results[28] : i32, view<32xi32>
  view.store %c0, %results[29] : i32, view<32xi32>
  view.store %c0, %results[30] : i32, view<32xi32>
  view.store %c0, %results[31] : i32, view<32xi32>
  func.return
}

check.scenario @vector_initializers_functions {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@vector_initializer_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<36xi32>
    check.compare<@vector_initializer_observations, @vector_initializer_reference>(%input, %output) : (i32, tensor<36xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<36xi32>
    }
  }
  check.return
}

check.scenario @vector_initializer_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@vector_initializer_input>(%trial) : (index) -> (i32)
    %storage = check.generate.fill value(-123) : tensor<64xi32>
    %output = check.tensor.view %storage offset(64) : tensor<64xi32> -> tensor<32xi32>
    check.compare<@vector_initializers, @vector_initializers_oracle>(%output, %input) : (tensor<32xi32>, i32) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<64xi32>
    }
  }
  check.return
}
