// RUN: verify
#include <loomcxx/kernel.h>

struct Alias {
  float& value;
};

// ERROR@+1: LOWERING/059 "kernel record parameters cannot contain reference members or by-reference lambda captures"
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void alias_kernel(Alias alias) { alias.value = 1.0f; }

// ====
// RUN: verify
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>

struct Scale {
  float value;
};
struct Bias {
  float value;
};

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void scale_kernel(float* y, Scale scale) { y[0] *= scale.value; }

inline Bias make_bias() { return {2.0f}; }

LOOM_CHECK_CASE(mismatched_record) {
  const auto y = loom::check::fill<1, float>(1.0f);
  const auto bias = make_bias();
  // ERROR@+1: LOWERING/059 "kernel.launch record arguments must have the kernel parameter type"
  loom::check::launch<scale_kernel>(y, bias);
}
