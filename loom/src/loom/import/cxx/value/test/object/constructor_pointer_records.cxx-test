// RUN: pass canonicalize,cse,dce
// An iterator whose constructor stores the address of its const reference
// parameter (AMReX's Gpu::Range iterator) is built by value: its pointer
// field holds the address of the range's element, which lives in storage,
// and the iterator itself never does. A range-for statement, a hand-written
// loop and a directly initialized local construct it the same way.
struct Box { int lo, hi; };
static int at(Box const& b, long i) { return b.lo + static_cast<int>(i); }
template <class T> struct Range {
  struct iterator {
    iterator(T const& b, long i, long s) : mi_b(&b), mi_i(i), mi_s(s) {}
    void operator++() { mi_i += mi_s; }
    bool operator!=(iterator const& rhs) const { return mi_i < rhs.mi_i; }
    int operator*() const { return at(*mi_b, mi_i); }
   private:
    T const* mi_b;
    long mi_i;
    long mi_s;
  };
  explicit Range(T const& b) : m_b(b), m_n(b.hi - b.lo) {}
  iterator begin() const { return iterator(m_b, 0, 1); }
  iterator end() const { return iterator(m_b, m_n, 0); }
 private:
  T m_b;
  long m_n;
};
int range_for(Box box) {
  int sum = 0;
  for (auto const v : Range<Box>(box)) sum += v;
  return sum;
}
int hand_loop(Box box) {
  Range<Box> range(box);
  int sum = 0;
  for (auto it = range.begin(); it != range.end(); ++it) sum += *it;
  return sum;
}
int direct(Box box, long i) {
  Range<Box>::iterator it(box, i, 1);
  ++it;
  return *it;
}
