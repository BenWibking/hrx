// RUN: verify
// Taking the address of an iterator that stores its argument's address
// observes the iterator's identity, which needs its storage.
struct Box { int lo, hi; };
struct Iterator {
  Iterator(Box const& b, long i) : mi_b(&b), mi_i(i) {}
  int operator*() const { return mi_b->lo + static_cast<int>(mi_i); }
  Box const* mi_b;
  long mi_i;
};
int address(Box box, long i) {
  // ERROR@+1: LOWERING/059 "stored pointers and references require an object storage representation"
  Iterator it(box, i);
  const Iterator* pointer = &it;
  return **pointer;
}

// ====
// RUN: verify
// Storing such an iterator into a mutable array lets it escape into memory.
struct Box { int lo, hi; };
struct Iterator {
  Iterator(Box const& b, long i) : mi_b(&b), mi_i(i) {}
  Box const* mi_b;
  long mi_i;
};
int escape(Box box, long i) {
  // ERROR@+1: LOWERING/059 "stored pointers and references require an object storage representation"
  Iterator saved[2] = {Iterator(box, 0), Iterator(box, 1)};
  saved[i & 1] = Iterator(box, i);
  return saved[0].mi_b->lo + static_cast<int>(saved[1].mi_i);
}
