{
  "version": 1,
  "cases": [
    {
      "name": "preserves native emission diagnostic locations",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/feature_distinct_code_objects.loom",
          "--pipeline=none",
          "--format=amdgpu-hsaco",
          "--output={tmp}/feature-distinct.hsaco"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "feature_distinct_code_objects.loom:9:1",
          "AMDGPU/051",
          "first code-object target selected here",
          "feature_distinct_code_objects.loom:5:1"
        ]
      },
      "files": [
        {"path": "{tmp}/feature-distinct.hsaco", "exists": false}
      ]
    },
    {
      "name": "resumes explicit kernel roots from Low text and bytecode",
      "steps": [
        {
          "name": "compile-source",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/source.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/source.hsaco", "non_empty": true}]
        },
        {
          "name": "save-low-text",
          "run": {
            "tool": "loom-opt",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--pipeline=source-low",
              "--output={tmp}/prepared.loom"
            ]
          },
          "files": [{"path": "{tmp}/prepared.loom", "non_empty": true}]
        },
        {
          "name": "compile-low-text",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loom",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/text.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/text.hsaco", "non_empty": true}]
        },
        {
          "name": "save-low-bytecode",
          "run": {
            "tool": "loom-format",
            "args": [
              "{tmp}/prepared.loom",
              "--to=bc",
              "--output={tmp}/prepared.loombc"
            ]
          },
          "files": [{"path": "{tmp}/prepared.loombc", "non_empty": true}]
        },
        {
          "name": "compile-low-bytecode",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loombc",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/bytecode.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/bytecode.hsaco", "non_empty": true}]
        },
        {
          "name": "infer-low-kernel-root-and-format",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loom",
              "--output={tmp}/implicit.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/implicit.hsaco", "non_empty": true}]
        }
      ]
    },
    {
      "name": "routes compile report output to the suggestion tool",
      "steps": [
        {
          "name": "compile-generic-root-for-gfx1151",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--format=amdgpu-hsaco",
              "--root=@selected_store_i32",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/specialized_report.hsaco",
              "--compile-report=summary",
              "--compile-report-output={tmp}/specialized_report.json"
            ]
          },
          "files": [
            {
              "path": "{tmp}/specialized_report.hsaco",
              "non_empty": true
            },
            {
              "path": "{tmp}/specialized_report.json",
              "non_empty": true
            }
          ]
        },
        {
          "name": "suggest-for-effective-gfx1151-target",
          "run": {
            "tool": "loom-compile-report",
            "args": [
              "suggest",
              "{tmp}/specialized_report.json",
              "--format=json"
            ]
          },
          "stdout": {
            "non_empty": true
          }
        }
      ]
    },
    {
      "name": "surfaces retained math expansion costs through public report tools",
      "steps": [
        {
          "name": "capture-math-expansions",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--root=@targetless_math_f32",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/math.hsaco",
              "--compile-report=details",
              "--compile-report-output={tmp}/math.json"
            ]
          },
          "files": [{"path": "{tmp}/math.hsaco", "non_empty": true}]
        },
        {
          "name": "show-math-expansions",
          "run": {
            "tool": "loom-compile-report",
            "args": ["show", "{tmp}/math.json"]
          },
          "stdout": {
            "contains": [
              "Per-operation expansion warnings",
              {"regex": "WARNING: [^\\n]*scalar.roundf: up to 9 source IR operations per source operation via round-away"}
            ]
          }
        },
        {
          "name": "suggest-math-expansion-investigation",
          "run": {
            "tool": "loom-compile-report",
            "args": ["suggest", "{tmp}/math.json", "--format=json"]
          },
          "stdout": {
            "contains": {"unordered": [
              "\"id\":\"lowering.reduce_expansion\"",
              "scalar.roundf: up to 9 source IR operations per source operation via round-away",
              "preserves the source semantics"
            ]}
          }
        }
      ]
    },
    {
      "name": "excludes kernel roots before target specialization",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/selected_root_amdgpu.loom",
          "--exclude-root=configured_targetless_store_i32",
          "--target=amdgpu:gfx1151",
          "--format=amdgpu-hsaco",
          "--output={tmp}/excluded.hsaco",
          "--compile-report=summary",
          "--compile-report-output={tmp}/excluded.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/excluded.json",
          "contains": ["selected_store_i32", "targetless_math_f32"],
          "not_contains": ["configured_targetless_store_i32"]
        },
        {
          "path": "{tmp}/excluded.hsaco",
          "non_empty": true
        }
      ]
    }
  ]
}
