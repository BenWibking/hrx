  %383 = v_lshlrev_b32_src0_inline %382, 2
  %384 = v_lshrrev_b32_src0_inline %lane, 4
  %385 = v_lshl_add_u32_shift_imm %384, %383, 8
  %386 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %385, %386, %output_view
  %387 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %385, %387, %output_view {offset = 64}
  %388 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %385, %388, %output_view {offset = 128}
  %389 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %385, %389, %output_view {offset = 192}
  return
}
