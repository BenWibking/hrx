{
  "version": 1,
  "cases": [
    {
      "name": "selects Q8S32 providers from imported target and config facts",
      "steps": [
        {
          "name": "import-provider-library-once",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "{srcdir}/q8s32_specialization_providers.cxx",
              "--to=bc",
              "--output={tmp}/providers.loombc"
            ]
          },
          "files": [
            {"path": "{tmp}/providers.loombc", "non_empty": true}
          ]
        },
        {
          "name": "import-root-once",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "{srcdir}/q8s32_specialization.cxx",
              "--to=bc",
              "--output={tmp}/root.loombc"
            ]
          },
          "files": [{"path": "{tmp}/root.loombc", "non_empty": true}]
        },
        {
          "name": "select-wave32-values32",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx1151",
              "--config=model.q8s32.input_capacity=512",
              "--require-resolved-config",
              "--output={tmp}/gfx1151-values32.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx1151-values32.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 512",
                "func.def inline @q8s32_lane_dot_combined",
                "@q8s32_wave32_values32",
                "{cluster_size = 32}",
                "amdgpu.target<gfx1151>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_split",
                "@q8s32_wave32_values16",
                "@q8s32_wave64_values32",
                "@q8s32_wave64_values16",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "select-wave32-values16",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx1151",
              "--config=model.q8s32.input_capacity=768",
              "--require-resolved-config",
              "--output={tmp}/gfx1151-values16.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx1151-values16.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 768",
                "func.def inline @q8s32_lane_dot_combined",
                "@q8s32_wave32_values16",
                "{cluster_size = 16}",
                "amdgpu.target<gfx1151>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_split",
                "@q8s32_wave32_values32",
                "@q8s32_wave64_values32",
                "@q8s32_wave64_values16",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "select-wave64-values32",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx942",
              "--config=model.q8s32.input_capacity=512",
              "--require-resolved-config",
              "--output={tmp}/gfx942-values32.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx942-values32.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 512",
                "func.def inline @q8s32_lane_dot_split",
                "@q8s32_wave64_values32",
                "{cluster_size = 32}",
                "amdgpu.target<gfx942>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_combined",
                "@q8s32_wave32_values32",
                "@q8s32_wave32_values16",
                "@q8s32_wave64_values16",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "select-wave64-values16",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx942",
              "--config=model.q8s32.input_capacity=768",
              "--require-resolved-config",
              "--output={tmp}/gfx942-values16.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx942-values16.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 768",
                "func.def inline @q8s32_lane_dot_split",
                "@q8s32_wave64_values16",
                "{cluster_size = 16}",
                "amdgpu.target<gfx942>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_combined",
                "@q8s32_wave32_values32",
                "@q8s32_wave32_values16",
                "@q8s32_wave64_values32",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "compile-wave32-selection",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/gfx1151-values32.loom",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/gfx1151-values32.hsaco"
            ]
          },
          "files": [
            {"path": "{tmp}/gfx1151-values32.hsaco", "non_empty": true}
          ]
        },
        {
          "name": "compile-wave64-selection",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/gfx942-values16.loom",
              "--target=amdgpu:gfx942",
              "--output={tmp}/gfx942-values16.hsaco"
            ]
          },
          "files": [
            {"path": "{tmp}/gfx942-values16.hsaco", "non_empty": true}
          ]
        }
      ]
    }
  ]
}
