// Observe correctly rounded f64 results, including signed zero. NaN payloads
// and signs are unspecified; retain the quiet bit so signaling results fail.
// CDNA f64 sqrt requires reciprocal-root refinement; hardware SQRT is approximate.
// Execute on CDNA3; the build also qualifies the same program for CDNA4.
kernel.def @sqrt_float64() {
  %c1 = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<64xi64>
  %outputs = buffer.view %output[%base] : buffer -> view<64xi64>
  %bits = view.load %inputs[%lane] : view<64xi64> -> i64
  %value = scalar.bitcast %bits : i64 to f64
  %root = scalar.sqrtf %value : f64
  %bits_out = scalar.bitcast %root : f64 to i64
  %is_nan = scalar.cmpf uno, %root, %root : f64
  %quiet_bit = scalar.constant 2251799813685248 : i64
  %exponent = scalar.constant 9218868437227405312 : i64
  %quiet = scalar.andi %bits_out, %quiet_bit : i64
  %nan_tag = scalar.ori %quiet, %exponent : i64
  %observed = scf.select %is_nan, %nan_tag, %bits_out : i64
  view.store %observed, %outputs[%lane] : i64, view<64xi64>
  kernel.return
}

check.case @sqrt_float64_positive_zero {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna3.core"}
  %input = check.generate.fill value(0) : tensor<64xi64>
  %actual = check.generate.fill value(-1) : tensor<64xi64>
  kernel.launch @sqrt_float64(%input, %actual) : (tensor<64xi64>, tensor<64xi64>)
  %expected = check.generate.fill value(0) : tensor<64xi64>
  check.expect.equal actual(%actual) expected(%expected) : tensor<64xi64>
  check.return
}

