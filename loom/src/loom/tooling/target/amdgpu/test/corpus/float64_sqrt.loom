// Alternate scaling and special-value decisions within the same wave.
check.case @sqrt_float64_mixed_scaling {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna3.core"}
  %input = check.generate.iota offset(1) step(4607182418800017407) period(2) : tensor<64xi64>
  %actual = check.generate.fill value(-1) : tensor<64xi64>
  %expected = check.generate.iota offset(2188749418902061056) step(2418432999897956352) period(2) : tensor<64xi64>
  kernel.launch @sqrt_float64(%input, %actual) : (tensor<64xi64>, tensor<64xi64>)
  check.expect.equal actual(%actual) expected(%expected) : tensor<64xi64>
  check.return
}

