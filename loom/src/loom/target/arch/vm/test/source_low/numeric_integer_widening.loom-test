// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_integer_widening.loom
// RUN: emit source-low target=vm:core output=low

func.def @widen_signed_word(%value: i32) -> (i64) {
  %result = scalar.extsi %value : i32 to i64
  func.return %result : i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @widen_signed_word(%value: reg<vm.value : i32>) -> (reg<vm.value : i64>) asm {
  %result = conversion.integer %value, "s32.to.i64"
  return %result
}

// ====

func.def @widen_unsigned_word(%value: i32) -> (i64) {
  %result = scalar.extui %value : i32 to i64
  func.return %result : i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @widen_unsigned_word(%value: reg<vm.value : i32>) -> (reg<vm.value : i64>) asm {
  %result = conversion.integer %value, "u32.to.i64"
  return %result
}

// ====

func.def @add_signed_word(%base: i64, %delta: i32) -> (i64) {
  %wide_delta = scalar.extsi %delta : i32 to i64
  %result = scalar.addi %base, %wide_delta : i64
  func.return %result : i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @add_signed_word(%base: reg<vm.value : i64>, %delta: reg<vm.value : i32>) -> (reg<vm.value : i64>) asm {
  %wide_delta = conversion.integer %delta, "s32.to.i64"
  %result = integer.add.i64 %base, %wide_delta
  return %result
}

// ====

func.def @assemble_wide_word(%low: i32, %high: i32) -> (i64) {
  %low_word = scalar.extui %low : i32 to i64
  %high_word = scalar.extui %high : i32 to i64
  %word_bits = scalar.constant 32 : i64
  %high_half = scalar.shli %high_word, %word_bits : i64
  %result = scalar.ori %low_word, %high_half : i64
  func.return %result : i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @assemble_wide_word(%low: reg<vm.value : i32>, %high: reg<vm.value : i32>) -> (reg<vm.value : i64>) asm {
  %low_word = conversion.integer %low, "u32.to.i64"
  %high_word = conversion.integer %high, "u32.to.i64"
  %word_bits = constant.i64 32
  %high_half = integer.shift.left.i64 %high_word, %word_bits
  %result = integer.or.i64 %low_word, %high_half
  return %result
}

// ====

func.def @exchange_signed_position(%buffer: buffer, %position: i32, %replacement: i32) -> (i32) {
  %bounded_position = scalar.assume %position [range(%position, -4, 4)] : i32
  %wide_position = scalar.extsi %bounded_position : i32 to i64
  %element_bytes = scalar.constant 4 : i64
  %displacement = scalar.muli %wide_position, %element_bytes : i64
  %center = scalar.constant 16 : i64
  %wide_origin = scalar.addi %center, %displacement : i64
  %origin = index.cast %wide_origin : i64 to offset
  %view = buffer.view %buffer[%origin] : buffer -> view<1xi32>
  %previous = view.load %view[0] : view<1xi32> -> i32
  view.store %replacement, %view[0] : i32, view<1xi32>
  func.return %previous : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @exchange_signed_position(%view: reg<vm.ref : buffer>, %bounded_position: reg<vm.value : i32>, %replacement: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %20 = constant.i64 16
  %21 = conversion.integer %bounded_position, "s32.to.i64" : reg<vm.value>
  %22 = constant.i64 2 : reg<vm.value>
  %23 = integer.shift.left.i64 %21, %22 : reg<vm.value>
  %24 = integer.add.i64 %23, %20
  %previous = buffer.load %view, %24, %24, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store %view, %24, %24, %replacement, 0, "i32.x1"
  return %previous
}
