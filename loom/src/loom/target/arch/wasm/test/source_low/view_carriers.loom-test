// TEMPLATE: loom/src/loom/test/corpus/source_low/view_carriers.loom-test
// RUN: emit source-low target=wasm:simd128 output=low control-flow=structured-low

// Retain an output record as history and copy its pixels after a packet header.
func.def inline @restore_pixels(%previous: view<144xi32>, %packet: view<7168xi32>) {
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 16 : index
  %unroll = index.constant 8 : index
  scf.for %position = [%begin to %end step %step] unroll(%unroll) {
    %destination = index.add %position, %step : index
    %pixels = vector.load %previous[%position] : view<144xi32> -> vector<16xi32>
    vector.store %pixels, %packet[%destination] : vector<16xi32>, view<7168xi32>
  }
  func.return
}

func.def public @restore_selected(%history_input: buffer, %current_input: buffer, %packet_input: buffer, %use_history: i1) {
  %history_storage = buffer.assume.alignment %history_input {minimum_alignment = 64} : buffer
  %current_storage = buffer.assume.alignment %current_input {minimum_alignment = 64} : buffer
  %packet_storage = buffer.assume.alignment %packet_input {minimum_alignment = 64} : buffer
  %history_origin = index.constant 64 : offset
  %current_origin = index.constant 128 : offset
  %packet_origin = index.constant 192 : offset
  %history = buffer.view %history_storage[%history_origin] : buffer -> view<144xi32>
  %current = buffer.view %current_storage[%current_origin] : buffer -> view<144xi32>
  %packet = buffer.view %packet_storage[%packet_origin] : buffer -> view<7168xi32>
  %previous = scf.select %use_history, %history, %current : view<144xi32>
  func.call @restore_pixels(%previous, %packet) : (view<144xi32>, view<7168xi32>)
  func.return
}

// ----
low.func.def public target<wasm.core.simd128> abi(wasm_function) @restore_selected(%history_storage: reg<wasm.i32>, %current_storage: reg<wasm.i32>, %packet_storage: reg<wasm.i32>, %use_history: reg<wasm.i32>) asm {
  %history_origin = i32.const 64
  %current_origin = i32.const 128
  %previous_root, %previous_offset = low.scf.if %use_history -> (reg<wasm.i32>, reg<wasm.i32>) {
    low.scf.yield %history_storage, %history_origin : reg<wasm.i32>, reg<wasm.i32>
  } else {
    low.scf.yield %current_storage, %current_origin : reg<wasm.i32>, reg<wasm.i32>
  }
  %begin = i32.const 0
  %step = i32.const 16
  %unroll = i32.const 8
  low.scf.for signed [%begin to %current_origin step %step] unroll(%unroll) do(%position: reg<wasm.i32>) {
    %148 = i32.const 4
    %149 = i32.mul %position, %148
    %150 = i32.add %previous_offset, %149
    %151 = i32.add %previous_root, %150
    %152 = i32.load %151
    %157 = i32.load %151 {offset = 4}
    %162 = i32.load %151 {offset = 8}
    %167 = i32.load %151 {offset = 12}
    %172 = i32.load %151 {offset = 16}
    %177 = i32.load %151 {offset = 20}
    %182 = i32.load %151 {offset = 24}
    %187 = i32.load %151 {offset = 28}
    %192 = i32.load %151 {offset = 32}
    %197 = i32.load %151 {offset = 36}
    %202 = i32.load %151 {offset = 40}
    %207 = i32.load %151 {offset = 44}
    %212 = i32.load %151 {offset = 48}
    %217 = i32.load %151 {offset = 52}
    %222 = i32.load %151 {offset = 56}
    %227 = i32.load %151 {offset = 60}
    %230 = i32.add %packet_storage, %149
    i32.store %230, %152 {offset = 256}
    i32.store %230, %157 {offset = 260}
    i32.store %230, %162 {offset = 264}
    i32.store %230, %167 {offset = 268}
    i32.store %230, %172 {offset = 272}
    i32.store %230, %177 {offset = 276}
    i32.store %230, %182 {offset = 280}
    i32.store %230, %187 {offset = 284}
    i32.store %230, %192 {offset = 288}
    i32.store %230, %197 {offset = 292}
    i32.store %230, %202 {offset = 296}
    i32.store %230, %207 {offset = 300}
    i32.store %230, %212 {offset = 304}
    i32.store %230, %217 {offset = 308}
    i32.store %230, %222 {offset = 312}
    i32.store %230, %227 {offset = 316}
  }
  return
}

// ====

// Complete addresses survive rotation between distinct storage roots.
func.def public @rotate_distinct_views(%first: buffer, %second: buffer, %first_origin_input: offset, %second_origin_input: offset, %count_input: index, %seed: i32) -> (i32) {
  %first_origin = index.assume %first_origin_input [range(%first_origin_input, 0, 128), mul(%first_origin_input, 4)] : offset
  %second_origin = index.assume %second_origin_input [range(%second_origin_input, 0, 128), mul(%second_origin_input, 4)] : offset
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %first_storage = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_storage = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_storage[%first_origin] : buffer -> view<1xi32>
  %second_view = buffer.view %second_storage[%second_origin] : buffer -> view<1xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %last, %other = scf.for %position = [%begin to %count step %step](%current = %first_view : view<1xi32>, %next = %second_view : view<1xi32>) -> (view<1xi32>, view<1xi32>) {
    %ordinal = index.cast %position : index to i32
    %value = scalar.addi %seed, %ordinal : i32
    view.store %value, %current[0] : i32, view<1xi32>
    scf.yield %next, %current : view<1xi32>, view<1xi32>
  }
  %value = view.load %last[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def public target<wasm.core.simd128> abi(wasm_function) @rotate_distinct_views(%first_storage: reg<wasm.i32>, %second_storage: reg<wasm.i32>, %first_origin: reg<wasm.i32>, %second_origin: reg<wasm.i32>, %count: reg<wasm.i32>, %seed: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %31 = i32.const 0
  %32 = i32.add %31, %first_origin
  %first_view = i32.add %first_storage, %32
  %35 = i32.add %31, %second_origin
  %second_view = i32.add %second_storage, %35
  %step = i32.const 1
  %last, %other = low.scf.for signed [%31 to %count step %step] iter_args(%first_view: reg<wasm.i32>, %second_view: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) do(%ordinal: reg<wasm.i32>, %current: reg<wasm.i32>, %next: reg<wasm.i32>) {
    %value = i32.add %seed, %ordinal
    i32.store %current, %value
    low.scf.yield %next, %current : reg<wasm.i32>, reg<wasm.i32>
  }
  %value = i32.load %last
  return %value
}

// ====

// A returned view carries its complete origin, including nested subviews.
func.def public @return_subview(%input: buffer, %origin_input: offset, %position_input: index) -> (view<3xi32>) {
  %origin = index.assume %origin_input [range(%origin_input, 0, 4096), mul(%origin_input, 4)] : offset
  %position = index.assume %position_input [range(%position_input, 0, 3)] : index
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %whole = buffer.view %storage[%origin] : buffer -> view<8xi32>
  %outer = view.subview %whole[1] : view<8xi32> -> view<7xi32>
  %inner = view.subview %outer[%position] : view<7xi32> -> view<3xi32>
  %refined = view.refine %inner : view<3xi32> -> view<3xi32>
  func.return %refined : view<3xi32>
}

// ----
low.func.def public target<wasm.core.simd128> abi(wasm_function) @return_subview(%storage: reg<wasm.i32>, %origin: reg<wasm.i32>, %position: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %15 = i32.const 4
  %17 = i32.mul %position, %15
  %18 = i32.add %origin, %17
  %19 = i32.add %15, %18
  %refined = i32.add %storage, %19
  return %refined
}

// ====

func.def public @load_view_argument(%input: view<3xi32>) -> (i32) {
  %value = view.load %input[1] : view<3xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def public target<wasm.core.simd128> abi(wasm_function) @load_view_argument(%input: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %value = i32.load %input {offset = 4}
  return %value
}

// ====

func.def noinline @make_record_window(%input: buffer, %origin_input: offset) -> (view<3xi32>) {
  %origin = index.assume %origin_input [range(%origin_input, 0, 4096), mul(%origin_input, 4)] : offset
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %whole = buffer.view %storage[%origin] : buffer -> view<8xi32>
  %record = view.subview %whole[2] : view<8xi32> -> view<3xi32>
  func.return %record : view<3xi32>
}

func.def noinline @read_record_window(%record: view<3xi32>) -> (i32) {
  %value = view.load %record[1] : view<3xi32> -> i32
  func.return %value : i32
}

func.def public @read_called_view(%input: buffer, %origin: offset) -> (i32) {
  %record = func.call @make_record_window(%input, %origin) : (buffer, offset) -> (view<3xi32>)
  %value = func.call @read_record_window(%record) : (view<3xi32>) -> (i32)
  func.return %value : i32
}

// ----
low.func.def noinline target<wasm.core.simd128> @make_record_window(%storage: reg<wasm.i32>, %origin: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %18 = i32.const 8
  %19 = i32.add %18, %origin
  %record = i32.add %storage, %19
  return %record
}

low.func.def noinline target<wasm.core.simd128> @read_record_window(%record: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %value = i32.load %record {offset = 4}
  return %value
}

low.func.def public target<wasm.core.simd128> abi(wasm_function) @read_called_view(%input: reg<wasm.i32>, %origin: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %record = low.func.call pure @make_record_window(%input, %origin) : (reg<wasm.i32>, reg<wasm.i32>) -> (reg<wasm.i32>)
  %value = low.func.call @read_record_window(%record) : (reg<wasm.i32>) -> (reg<wasm.i32>)
  return %value
}
