// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_vector_bitwise.loom-test
// RUN: emit source-low target=wasm:simd128 output=low control-flow=structured-low

func.def @numeric_vector_bitwise_i32(%lhs: vector<4xi32>, %rhs: vector<4xi32>) -> (vector<4xi32>, vector<4xi32>, vector<4xi32>) {
  %and_result = vector.andi %lhs, %rhs : vector<4xi32>
  %or_result = vector.ori %lhs, %rhs : vector<4xi32>
  %xor_result = vector.xori %lhs, %rhs : vector<4xi32>
  func.return %and_result, %or_result, %xor_result : vector<4xi32>, vector<4xi32>, vector<4xi32>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @numeric_vector_bitwise_i32(%lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>) -> (reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>) asm {
  %and_result = v128.and %lhs, %rhs
  %or_result = v128.or %lhs, %rhs
  %xor_result = v128.xor %lhs, %rhs
  return %and_result, %or_result, %xor_result
}

