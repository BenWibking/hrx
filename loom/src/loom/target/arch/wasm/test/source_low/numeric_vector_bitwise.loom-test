}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @numeric_vector_bitwise_i64(%lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>) -> (reg<wasm.v128>, reg<wasm.v128>, reg<wasm.v128>) asm {
  %and_result = v128.and %lhs, %rhs
