// TEMPLATE: loom/src/loom/test/corpus/source_low/view_carriers.loom-test
// TEMPLATE-EXCLUDE: @read_called_view The x86 object-function policy requires inlined calls.
// RUN: emit source-low target=x86:avx2 output=low

// Retain an output record as history and copy its pixels after a packet header.
func.def inline @restore_pixels(%previous: view<144xi32>, %packet: view<7168xi32>) {
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 16 : index
  %unroll = index.constant 8 : index
  scf.for %position = [%begin to %end step %step] unroll(%unroll) {
    %destination = index.add %position, %step : index
    %pixels = vector.load %previous[%position] : view<144xi32> -> vector<16xi32>
    vector.store %pixels, %packet[%destination] : vector<16xi32>, view<7168xi32>
  }
  func.return
}

func.def public @restore_selected(%history_input: buffer, %current_input: buffer, %packet_input: buffer, %use_history: i1) {
  %history_storage = buffer.assume.alignment %history_input {minimum_alignment = 64} : buffer
  %current_storage = buffer.assume.alignment %current_input {minimum_alignment = 64} : buffer
  %packet_storage = buffer.assume.alignment %packet_input {minimum_alignment = 64} : buffer
  %history_origin = index.constant 64 : offset
  %current_origin = index.constant 128 : offset
  %packet_origin = index.constant 192 : offset
  %history = buffer.view %history_storage[%history_origin] : buffer -> view<144xi32>
  %current = buffer.view %current_storage[%current_origin] : buffer -> view<144xi32>
  %packet = buffer.view %packet_storage[%packet_origin] : buffer -> view<7168xi32>
  %previous = scf.select %use_history, %history, %current : view<144xi32>
  func.call @restore_pixels(%previous, %packet) : (view<144xi32>, view<7168xi32>)
  func.return
}

