// RUN: emit source-low target=x86:scalar output=module

// The query is ordinary Low code. Its version check and symbolic address stay
// visible to verification, optimization, allocation, and native relocation.
kernel.def export("empty") @empty() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  kernel.return
}

// ----
low.kernel.def target<x86.scalar.core>(@__loom_target_context_0_0) abi_layout({offsets = [], signature = () -> ()}) export("empty") workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @empty() asm {
  return
}

global.rodata.decl @iree_hal_executable_library_v0

low.func.def public retain target<x86.scalar.core>(@__loom_target_context_0_0) abi(object_function) @iree_hal_executable_library_query(%0: reg<x86.gpr32>, %1: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %2 = cmp.uge.imm.gpr32 %0, 8
  low.cond_br %2, ^_bb1, ^_bb2 : reg<x86.gpr32>
^_bb1:
  %3 = lea.symbol.gpr64 @iree_hal_executable_library_v0
  return %3
^_bb2:
  %4 = mov.imm64 0
  return %4
}

x86.target<scalar> @__loom_target_context_0_0
