// TEMPLATE: loom/src/loom/test/corpus/source_low/subgroup_shuffle_participation.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1151 output=low

// Three lanes per four participate; the last physical wave and last logical
// cluster are partial. A source must be in the cluster and actually participate
// before its payload is observed. Output pairs retain untouched payload slots
// for invalid sources and both slots for nonparticipating invocations.
kernel.def @subgroup_participation_index() {
  %unit = index.constant 1 : index
  %items = index.constant 54 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%distance: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%base] : buffer -> view<54xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<108xi32>
  %value = view.load %input_view[%item] : view<54xi32> -> i32
  %fields = index.constant 2 : index
  %position = index.mul %item, %fields : index
  %valid_field = index.constant 1 : index
  %valid_position = index.add %position, %valid_field : index
  %period = index.constant 4 : index
  %excluded_lane = index.constant 3 : index
  %relative = index.rem %item, %period : index
  %active = index.cmp ne, %relative, %excluded_lane : index
  %bounded = index.assume %distance [range(%distance, 0, 15)] : index
  %source = index.cast %bounded : index to i32
  %width = scalar.constant 16 : i32
  %invalid = scalar.constant 0 : i32
  %valid_value = scalar.constant 1 : i32
  scf.if %active {
    %shuffled, %valid = kernel.subgroup.shuffle<index> %value, %source, %width : i32, i32, i32
    view.store %invalid, %output_view[%valid_position] : i32, view<108xi32>
    scf.if %valid {
      view.store %shuffled, %output_view[%position] : i32, view<108xi32>
      view.store %valid_value, %output_view[%valid_position] : i32, view<108xi32>
    }
  }
  kernel.return
}

// ----
CHECK: %* = v_and_b32_src0_inline %item, 31
CHECK: %* = s_mov_b64_exec_read
CHECK: %* = v_lshrrev_b32 %*, %*
CHECK: %* = v_and_b32_src0_inline %*, 1
CHECK: %valid = v_cmp_ne_i32 %*, %*
CHECK: %shuffled = ds_bpermute_b32 %*, %value

// ====

