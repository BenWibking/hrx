  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%source: buffer, %destination: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %source[%base] : buffer -> view<2xf64>
  %output_view = buffer.view %destination[%base] : buffer -> view<2xf64>
  %input = vector.load %input_view[0] : view<2xf64> -> vector<2xf64>
  // ERROR@+1: LOWERING/036 {op_name="vector.softplusf", phase_name="legalize-math", math_op="softplusf", lane_domain="vector", element_type="f64", constraint_key="math.element.f32"}
  %result = vector.softplusf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %input : vector<2xf64>
  vector.store %result, %output_view[0] : vector<2xf64>, view<2xf64>
  kernel.return
}
