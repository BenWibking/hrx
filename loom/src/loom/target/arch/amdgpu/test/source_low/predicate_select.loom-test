// TEMPLATE: loom/src/loom/test/corpus/source_low/predicate_select.loom-test
// TEMPLATE-EXCLUDE: @predicate_select_crossing AMDGPU predicate vectors currently support at most 32 logical elements.
// TEMPLATE-EXCLUDE: @predicate_select_full AMDGPU predicate vectors currently support at most 32 logical elements.
// TEMPLATE-EXCLUDE: @predicate_select_full_matrix AMDGPU predicate vectors currently support at most 32 logical elements.
// RUN: emit source-low target=amdgpu:gfx1151 output=low

func.def @predicate_select_four(%mask: vector<4xi1>, %true_value: vector<4xi1>, %false_value: vector<4xi1>) -> (vector<4xi1>) {
  %selected = vector.select %mask, %true_value, %false_value : vector<4xi1>
  func.return %selected : vector<4xi1>
}

// ----
low.func.def target<amdgpu.rdna3_5.core> abi(hal_kernel) @predicate_select_four(%mask: reg<amdgpu.sgpr x8>, %true_value: reg<amdgpu.sgpr x8>, %false_value: reg<amdgpu.sgpr x8>) -> (reg<amdgpu.sgpr x8>) asm {
  %9 = slice %true_value[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %10 = slice %false_value[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %11 = s_xor_b64 %9, %10
  %12 = slice %true_value[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %13 = slice %false_value[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %14 = s_xor_b64 %12, %13
  %15 = slice %true_value[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %16 = slice %false_value[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %17 = s_xor_b64 %15, %16
  %18 = slice %true_value[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %19 = slice %false_value[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %20 = s_xor_b64 %18, %19
  %22 = slice %mask[0] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %24 = s_and_b64 %22, %11
  %25 = slice %mask[2] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %27 = s_and_b64 %25, %14
  %28 = slice %mask[4] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %30 = s_and_b64 %28, %17
  %31 = slice %mask[6] : reg<amdgpu.sgpr x8> -> reg<amdgpu.sgpr x2>
  %33 = s_and_b64 %31, %20
  %37 = s_xor_b64 %10, %24
  %40 = s_xor_b64 %13, %27
  %43 = s_xor_b64 %16, %30
  %46 = s_xor_b64 %19, %33
  %selected = concat(%37, %40, %43, %46) : (reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>, reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x8>
  return %selected
}

