// TEMPLATE: loom/src/loom/test/corpus/source_low/byte_memory_banks.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1151 output=low

// A byte load preserves its unsigned byte value in an i32 result.
kernel.def @aligned_byte_increment() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %aligned_input, %aligned_output = buffer.assume.alignment %input, %output {minimum_alignment = 4} : buffer, buffer
  %source, %destination = buffer.assume.noalias %aligned_input, %aligned_output : buffer, buffer
  %base = index.constant 0 : offset
  %c1 = scalar.constant 1 : i32
  %byte = buffer.load.i8.u %source[%base]
  %next = scalar.addi %byte, %c1 : i32
  %output_view = buffer.view %destination[%base] : buffer -> view<1xi32>
  view.store %next, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ----
CHECK: %byte = global_load_u8*
CHECK: %next = v_add_*

// ====

// An immutable byte input chooses the storage read on each iteration.
kernel.def @byte_selected_storage() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_a: buffer, %input_b: buffer, %control: buffer) {
  %a = buffer.assume.alignment %input_a {minimum_alignment = 16} : buffer
  %b = buffer.assume.alignment %input_b {minimum_alignment = 16} : buffer
  %start = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %c1 = scalar.constant 1 : i32
  %control_unique = buffer.assume.noalias %control : buffer
  scf.for %i = [%start to %end step %step] {
    %choice = buffer.load.i8.u %control_unique[%base]
    %middle = scalar.cmpi eq, %choice, %c1 : i32
    %read_buffer = scf.select %middle, %b, %a : buffer
    %write_buffer = scf.select %middle, %a, %b : buffer
    %read_unique, %write_unique = buffer.assume.noalias %read_buffer, %write_buffer : buffer, buffer
    %source = buffer.view %read_unique[%base] : buffer -> view<1xi32>
    %dest = buffer.view %write_unique[%base] : buffer -> view<1xi32>
    %value = view.load %source[0] : view<1xi32> -> i32
    %next = scalar.addi %value, %c1 : i32
    view.store %next, %dest[0] : i32, view<1xi32>
  }
  kernel.return
}

// ----
CHECK: %choice = global_load_u8*
CHECK: %value = global_load_b32*
CHECK: %next = v_add_*
CHECK-NOT: %value = s_load_dword *
