// RUN: emit source-low target=amdgpu:gfx942 output=low

func.def @half_fma(%factor: f16, %values: vector<8xf16>, %addend: f16) -> (vector<8xf16>) {
  %factors = vector.splat %factor : vector<8xf16>
  %addends = vector.splat %addend : vector<8xf16>
  %result = vector.fmaf %factors, %values, %addends : vector<8xf16>
  func.return %result : vector<8xf16>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @half_fma(%factor: reg<amdgpu.vgpr>, %values: reg<amdgpu.vgpr x4>, %addend: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %11 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %12 = v_pk_fma_f16 %factor, %11, %addend {op_sel_hi = 2}
  %13 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %14 = v_pk_fma_f16 %factor, %13, %addend {op_sel_hi = 2}
  %15 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = v_pk_fma_f16 %factor, %15, %addend {op_sel_hi = 2}
  %17 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = v_pk_fma_f16 %factor, %17, %addend {op_sel_hi = 2}
  %result = concat(%12, %14, %16, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

func.def @integer_mad(%factor: i16, %values: vector<8xi16>, %addend: i16) -> (vector<8xi16>) {
  %factors = vector.splat %factor : vector<8xi16>
  %addends = vector.splat %addend : vector<8xi16>
  %result = vector.fmai %factors, %values, %addends : vector<8xi16>
  func.return %result : vector<8xi16>
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @integer_mad(%factor: reg<amdgpu.vgpr>, %values: reg<amdgpu.vgpr x4>, %addend: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %11 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %12 = v_pk_mad_i16 %factor, %11, %addend {op_sel_hi = 2}
  %13 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %14 = v_pk_mad_i16 %factor, %13, %addend {op_sel_hi = 2}
  %15 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = v_pk_mad_i16 %factor, %15, %addend {op_sel_hi = 2}
  %17 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = v_pk_mad_i16 %factor, %17, %addend {op_sel_hi = 2}
  %result = concat(%12, %14, %16, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

