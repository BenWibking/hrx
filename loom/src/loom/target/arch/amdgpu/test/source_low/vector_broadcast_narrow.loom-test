// ----
low.func.def target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @brain_fma(%factor: reg<amdgpu.vgpr>, %values: reg<amdgpu.vgpr x4>, %addend: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x4>) asm {
  %11 = slice %values[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %12 = v_pk_fma_bf16 %factor, %11, %addend {op_sel_hi = 2}
  %13 = slice %values[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %14 = v_pk_fma_bf16 %factor, %13, %addend {op_sel_hi = 2}
  %15 = slice %values[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %16 = v_pk_fma_bf16 %factor, %15, %addend {op_sel_hi = 2}
  %17 = slice %values[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %18 = v_pk_fma_bf16 %factor, %17, %addend {op_sel_hi = 2}
  %result = concat(%12, %14, %16, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  return %result
}

// ====

// RUN: emit source-low target=amdgpu:gfx1200 output=low

func.def @half_literal(%values: vector<4xf16>, %addend: f16) -> (vector<4xf16>) {
  %factor = scalar.constant 0.333251953125 : f16
  %factors = vector.splat %factor : vector<4xf16>
  %addends = vector.splat %addend : vector<4xf16>
  %result = vector.fmaf %factors, %values, %addends : vector<4xf16>
  func.return %result : vector<4xf16>
}

// ----
low.func.def target<amdgpu.rdna4.core> abi(hal_kernel) @half_literal(%values: reg<amdgpu.vgpr x2>, %addend: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %11 = v_mov_b32 894776661
  %15 = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %16 = v_pk_fma_f16 %11, %15, %addend {op_sel_hi = 3}
  %18 = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %19 = v_pk_fma_f16 %11, %18, %addend {op_sel_hi = 3}
  %result = concat(%16, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}
