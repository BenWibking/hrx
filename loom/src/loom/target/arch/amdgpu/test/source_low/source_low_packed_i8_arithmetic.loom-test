// ----
low.func.def target<amdgpu.gfx11.generic.core> abi(hal_kernel) @i8x5_shli_7(%values: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %6 = slice %values[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %7 = v_lshlrev_b32_src0_inline %6, 7
  %8 = v_and_b32_lit %7, 2155905152
  %9 = slice %values[1] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %10 = v_lshlrev_b32_src0_inline %9, 7
  %11 = v_and_b32_lit %10, 2155905152
  %result = concat(%8, %11) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  return %result
}

