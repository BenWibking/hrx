  %79 = v_lshrrev_b32 %78, %77
  %80 = v_bfe_i32_offset_width_inline %values {offset = 16, width = 8}
  %81 = v_bfe_i32_offset_width_inline %amounts {offset = 16, width = 8}
  %82 = v_and_b32_lit %81, 255
  %83 = v_and_b32_src0_inline %82, 7
  %84 = v_and_b32_lit %80, 255
  %85 = v_and_b32_lit %83, 255
  %86 = v_lshrrev_b32 %85, %84
  %87 = v_ashrrev_i32_src0_inline %values, 24
  %88 = v_ashrrev_i32_src0_inline %amounts, 24
  %89 = v_and_b32_lit %88, 255
  %90 = v_and_b32_src0_inline %89, 7
  %91 = v_and_b32_lit %87, 255
  %92 = v_and_b32_lit %90, 255
  %93 = v_lshrrev_b32 %92, %91
  %94 = v_and_b32_lit %72, 255
  %95 = v_and_b32_lit %79, 255
  %96 = v_lshlrev_b32_src0_inline %95, 8
  %97 = v_or_b32 %94, %96
  %98 = v_and_b32_lit %86, 255
  %99 = v_lshlrev_b32_src0_inline %98, 16
  %100 = v_or_b32 %97, %99
  %101 = v_and_b32_lit %93, 255
  %102 = v_lshlrev_b32_src0_inline %101, 24
  %result = v_or_b32 %100, %102
