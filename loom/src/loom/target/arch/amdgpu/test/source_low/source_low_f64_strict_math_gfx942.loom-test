// RUN: with-checks emit source-low target=amdgpu:gfx942 output=low
// The strict sqrt classification mask is uniform and uses an SGPR.

kernel.def @f64_sqrtf() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: f64, %output_buffer: buffer) {
  %result = scalar.sqrtf %input : f64
  %c0 = index.constant 0 : offset
  %output_view = buffer.view %output_buffer[%c0] : buffer -> view<1xf64>
  view.store %result, %output_view[0] : f64, view<1xf64>
  kernel.return
}

// ----
CHECK: low.kernel.def* @f64_sqrtf*
CHECK: *s_mov_b32 608
CHECK: *v_cmp_class_f64*
CHECK: global_store_dwordx2*
