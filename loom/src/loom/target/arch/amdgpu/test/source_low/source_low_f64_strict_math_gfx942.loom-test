// RUN: with-checks emit source-low target=amdgpu:gfx942 output=low
// Strict f64 exp uses range reduction and a rational approximation.

kernel.def @f64_expf() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%input: f64, %output_buffer: buffer) {
  %result = scalar.expf %input : f64
  %zero = index.constant 0 : offset
  %output_view = buffer.view %output_buffer[%zero] : buffer -> view<1xf64>
  view.store %result, %output_view[0] : f64, view<1xf64>
  kernel.return
}

// ----
CHECK: low.kernel.def* @f64_expf*
CHECK: *v_div_fixup_f64*
CHECK: global_store_dwordx2*

// ====

// RUN: with-checks emit source-low target=amdgpu:gfx942 output=low
// Strict f64 log normalizes its exponent and evaluates a polynomial.

kernel.def @f64_logf() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%input: f64, %output_buffer: buffer) {
  %result = scalar.logf %input : f64
  %zero = index.constant 0 : offset
  %output_view = buffer.view %output_buffer[%zero] : buffer -> view<1xf64>
  view.store %result, %output_view[0] : f64, view<1xf64>
  kernel.return
}

// ----
CHECK: low.kernel.def* @f64_logf*
CHECK: *v_div_fixup_f64*
CHECK: global_store_dwordx2*

// ====

// RUN: with-checks emit source-low target=amdgpu:gfx942 output=low
// Strict f64 cbrt is normalized and refined without fast-math permissions.

kernel.def @f64_cbrtf() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%input: f64, %output_buffer: buffer) {
  %result = scalar.cbrtf %input : f64
  %zero = index.constant 0 : offset
  %output_view = buffer.view %output_buffer[%zero] : buffer -> view<1xf64>
  view.store %result, %output_view[0] : f64, view<1xf64>
  kernel.return
}

// ----
CHECK: low.kernel.def* @f64_cbrtf*
CHECK: *v_cvt_f64_i32*
CHECK: *v_mul_f64*
CHECK: *v_div_fixup_f64*
CHECK: global_store_dwordx2*
