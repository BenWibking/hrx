// TEMPLATE: loom/src/loom/test/corpus/source_low/subgroup_transport_carrier.loom-test
// RUN: with-checks emit source-low target=amdgpu:gfx1151 output=low

// Narrow carriers cross each exchange before signed and unsigned consumers.
// Input words include upper bits outside the declared payload width.
kernel.def @subgroup_carrier_i8() {
  %unit = index.constant 1 : index
  %items = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%selected: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%base] : buffer -> view<32xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<128xi32>
  %source = view.load %input_view[%item] : view<32xi32> -> i32
  %narrow = scalar.trunci %source : i32 to i8
  %bounded = index.assume %selected [range(%selected, 0, 31)] : index
  %lane = index.cast %bounded : index to i32
  %named = kernel.subgroup.broadcast %narrow from %lane : i8, i32
  %distance = scalar.constant 1 : i32
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<xor> %named, %distance, %width : i8, i32, i32
  %first = kernel.subgroup.broadcast.first %shuffled : i8
  %signed = scalar.extsi %first : i8 to i32
  %unsigned = scalar.extui %first : i8 to i32
  %signed_float = scalar.sitofp %first : i8 to f32
  %unsigned_float = scalar.uitofp %first : i8 to f32
  %signed_bits = scalar.bitcast %signed_float : f32 to i32
  %unsigned_bits = scalar.bitcast %unsigned_float : f32 to i32
  %plane = index.constant 32 : index
  %second = index.add %item, %plane : index
  %third = index.add %second, %plane : index
  %fourth = index.add %third, %plane : index
  view.store %signed, %output_view[%item] : i32, view<128xi32>
  view.store %unsigned, %output_view[%second] : i32, view<128xi32>
  view.store %signed_bits, %output_view[%third] : i32, view<128xi32>
  view.store %unsigned_bits, %output_view[%fourth] : i32, view<128xi32>
  kernel.return
}

// ----
CHECK: %narrow = v_bfe_i32_offset_width_inline %source {offset = 0, width = 8}
CHECK: %named = ds_bpermute_b32 %*, %narrow
CHECK: %shuffled = v_mov_b32_dpp16 %named {dpp_ctrl = 177}
CHECK: %* = v_readfirstlane_b32 %shuffled
CHECK: %unsigned = v_and_b32_lit %signed, 255
CHECK: %signed_bits = v_cvt_f32_i32 %signed
CHECK: %unsigned_bits = v_cvt_f32_u32 %unsigned

// ====

kernel.def @subgroup_carrier_i16() {
  %unit = index.constant 1 : index
  %items = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%selected: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%base] : buffer -> view<32xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<128xi32>
  %source = view.load %input_view[%item] : view<32xi32> -> i32
  %narrow = scalar.trunci %source : i32 to i16
  %bounded = index.assume %selected [range(%selected, 0, 31)] : index
  %lane = index.cast %bounded : index to i32
  %named = kernel.subgroup.broadcast %narrow from %lane : i16, i32
  %distance = scalar.constant 1 : i32
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<xor> %named, %distance, %width : i16, i32, i32
  %first = kernel.subgroup.broadcast.first %shuffled : i16
  %signed = scalar.extsi %first : i16 to i32
  %unsigned = scalar.extui %first : i16 to i32
  %signed_float = scalar.sitofp %first : i16 to f32
  %unsigned_float = scalar.uitofp %first : i16 to f32
  %signed_bits = scalar.bitcast %signed_float : f32 to i32
  %unsigned_bits = scalar.bitcast %unsigned_float : f32 to i32
  %plane = index.constant 32 : index
  %second = index.add %item, %plane : index
  %third = index.add %second, %plane : index
  %fourth = index.add %third, %plane : index
  view.store %signed, %output_view[%item] : i32, view<128xi32>
  view.store %unsigned, %output_view[%second] : i32, view<128xi32>
  view.store %signed_bits, %output_view[%third] : i32, view<128xi32>
  view.store %unsigned_bits, %output_view[%fourth] : i32, view<128xi32>
  kernel.return
}

// ----
CHECK: %narrow = v_bfe_i32_offset_width_inline %source {offset = 0, width = 16}
CHECK: %named = ds_bpermute_b32 %*, %narrow
CHECK: %shuffled = v_mov_b32_dpp16 %named {dpp_ctrl = 177}
CHECK: %* = v_readfirstlane_b32 %shuffled
CHECK: %unsigned = v_and_b32_lit %signed, 65535
CHECK: %signed_bits = v_cvt_f32_i32 %signed
CHECK: %unsigned_bits = v_cvt_f32_u32 %unsigned
