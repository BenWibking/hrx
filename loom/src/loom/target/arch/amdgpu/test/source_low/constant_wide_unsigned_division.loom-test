  %32 = s_mul_hi_u32 %10, %8
  %39, %40 = s_add_co_u32 %31, %24
  %41, %42 = s_addc_u32 %32, %14, %40
  %46 = s_mul_i32 %12, %8
  %47 = s_mul_hi_u32 %12, %8
  %54, %55 = s_add_co_u32 %46, %26
  %56, %57 = s_addc_u32 %47, %14, %55
  %64, %65 = s_add_co_u32 %54, %41
  %66, %67 = s_addc_u32 %56, %14, %65
  %68 = concat(%64, %66) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  %69 = s_mov_b32 1
  %70 = s_lshr_b64 %68, %69
  %71 = s_mov_b32 7
  %74 = slice %70[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %75 = slice %70[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %78 = s_mul_i32 %74, %71
  %79 = s_mul_hi_u32 %74, %71
  %80 = s_mul_i32 %74, %14
  %81 = s_mul_i32 %75, %71
  %82 = s_add_u32 %79, %80
  %83 = s_add_u32 %82, %81
  %89, %90 = s_sub_co_u32 %10, %78
  %91, %92 = s_subb_u32 %12, %83, %90
  %result = concat(%89, %91) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr x2>
  return %result
}

// ====

amdgpu.target<gfx942> @target

// Extension, multiplication and XOR keep the sign bit clear without an
// assumption on the division itself.
func.def target(@target) @bounded_varying_quotient(%values: vector<2xi32>) -> (i64) {
  %wide = vector.extui %values : vector<2xi32> to vector<2xi64>
  %lhs = vector.extract %wide[0] : vector<2xi64> -> i64
  %rhs = vector.extract %wide[1] : vector<2xi64> -> i64
  %multiplier = scalar.constant 2147483647 : i64
  %product = scalar.muli %lhs, %multiplier : i64
  %hash = scalar.xori %product, %rhs : i64
  %divisor = scalar.constant 7 : i64
  %result = scalar.divui %hash, %divisor : i64
  func.return %result : i64
}

