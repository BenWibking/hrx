  %54 = v_mul_hi_u32 %42, %44
  %61, %62 = v_add_co_u32 %53, %52
  %63, %64 = v_addc_co_u32 %54, %12, %62
  %68 = v_mul_lo_u32 %39, %45
  %69 = v_mul_hi_u32 %39, %45
  %76, %77 = v_add_co_u32 %68, %61
  %78, %79 = v_addc_co_u32 %69, %12, %77
