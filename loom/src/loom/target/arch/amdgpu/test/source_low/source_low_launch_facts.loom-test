  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %21 = v_mov_b32_copy %17
  %22 = v_lshlrev_b32_src0_inline %21, 6
  %linear = v_add_u32 %22, %18
  %24 = v_mov_b32 0
  %26 = slice %element_count[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %27 = v_mov_b32_copy %26
  %28 = slice %element_count[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %29 = v_mov_b32_copy %28
  %35 = v_cmp_lt_u32 %24, %29
  %36 = v_cmp_lt_u32 %linear, %27
  %37 = v_cmp_eq_i32 %24, %29
  %38 = s_and_b64 %37, %36
  %in_bounds = s_or_b64 %35, %38
  %40, %41 = s_and_saveexec_b64 %in_bounds
  low.cond_br %41, ^_bb1, ^_bb2 : reg<amdgpu.scc>
^_bb1:
  %42 = v_lshlrev_b32_src0_inline %linear, 2
  %43 = v_lshrrev_b32_src0_inline %linear, 30
  %44 = slice %input_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %45 = slice %input_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %46, %47 = v_add_co_u32 %44, %42
  %48 = v_mov_b32_copy %45
  %49, %50 = v_add_co_ci_u32 %48, %43, %47
  %51 = concat(%46, %49) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %loaded = global_load_b32_vaddr %51
  %55 = slice %output_view[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %56 = slice %output_view[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %57, %58 = v_add_co_u32 %55, %42
  %59 = v_mov_b32_copy %56
  %60, %61 = v_add_co_ci_u32 %59, %43, %58
  %62 = concat(%57, %60) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  global_store_b32_vaddr %62, %loaded
  low.br ^_bb2
^_bb2:
  s_mov_b64_exec %40
