low.kernel.def target<amdgpu.gfx11.generic.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(8, 4, 1) workgroup_count(1, 1, 1) @fixed_multidim_madd_global_b32() asm {
  %packed_tid = live_in<amdgpu.workitem_id.packed.xy> : reg<amdgpu.vgpr>
  %input_view = resource<hal_binding> {extent = 128, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output_view = resource<hal_binding> {extent = 128, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %x = v_and_b32_lit %packed_tid, 1023
  %17 = v_lshrrev_b32_src0_inline %packed_tid, 10
  %y = v_and_b32_lit %17, 1023
  %linear = v_lshl_add_u32_shift_imm %y, %x, 3
  %20 = v_lshlrev_b32_src0_inline %linear, 2
  %loaded = global_load_b32_saddr %20, %input_view
  global_store_b32_saddr %20, %loaded, %output_view
  return
}

// ====

amdgpu.target<gfx11-generic> @target

config.decl @launch_facts.workgroups : %value: index where [range(%value, 1, 1024)]

kernel.def target(@target) @config_bound_workgroup_vector_copy() {
  %unit = index.constant 1 : index
  %workgroups = config.get @launch_facts.workgroups : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %tile = index.constant 4 : index
  %workgroup = kernel.workgroup.id<x> : index
  %origin = index.mul %workgroup, %tile : index
  %workgroups = kernel.workgroup.count<x> : index
  %element_count = index.mul %workgroups, %tile : index
  %input_view = buffer.view %input[%base] : buffer -> view<[%element_count]xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<[%element_count]xf32>
  %loaded = vector.load %input_view[%origin] : view<[%element_count]xf32> -> vector<4xf32>
  vector.store %loaded, %output_view[%origin] : vector<4xf32>, view<[%element_count]xf32>
  kernel.return
}

