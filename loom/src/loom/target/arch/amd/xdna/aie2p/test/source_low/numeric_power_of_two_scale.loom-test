// ====
// RUN: compile-report target-legalize{mode=final},source-to-low,low-dce

aie2p.target<core> @target

func.def target(@target) @report_scale_selection(%value: vector<32xf32>, %lhs: f32, %rhs: f32) -> (vector<32xf32>, f32) {
  %factor = vector.constant 0.00390625 : vector<32xf32>
  %scaled = vector.mulf %value, %factor : vector<32xf32>
  %general = scalar.mulf %lhs, %rhs : f32
  func.return %scaled, %general : vector<32xf32>, f32
}

