// ====

// Communication and arithmetic share one tile without reserving a transfer
// core. Each grouped ingress must complete before publication. Both output
// acquisitions precede the grouped egress, so they cannot be deferred into
// descriptors past one another. The 63-slot channels also exercise initial
// reservation at the hardware credit limit without overflowing on release.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @pairwise_sum_difference() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 252 : offset
  %origin = index.constant 0 : offset
  %next_word = index.constant 4 : offset
