// RUN: emit source-low output=low

// Firmware initializes a runtime binding in owner memory while the worker
// reads it through the core's self-memory aperture. These are distinct address
// spaces even when the channel, DMA engine, and worker occupy one tile.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @copy_record() run(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 4} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %slots = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %records = buffer.view %storage[%origin] : buffer -> view<1x1xi32>
  %channel = channel.bind<fifo> %records, %slots : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_input = buffer.view %source[%origin] : buffer -> view<1xi32>
    %write, %record = channel.reserve %channel : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %ingress = kernel.async.copy %external_input to %record {cache_scope = cu, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %incoming = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1xi32>>
    %read, %ready = channel.acquire %channel : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %external_output = buffer.view %destination[%origin] : buffer -> view<1xi32>
    %egress = kernel.async.copy %ready to %external_output {cache_scope = cu, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %outgoing = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1xi32>>
  }
}

