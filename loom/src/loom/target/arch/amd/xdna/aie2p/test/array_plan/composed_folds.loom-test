// RUN: with-checks emit aie2p-array-plan @parallel_folded_composite_array

// Two folded outputs share record work but occupy distinct accumulator lanes
// and retain their own output rings and binding relocations.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

func.def target(@core_target) @parallel_folded_composite_array_worker_0(%shared: buffer, %left: buffer, %right: buffer, %left_output: buffer, %right_output: buffer) {
  %scratch_bytes = index.constant 4 : offset
  %scratch = buffer.alloca<private> align(64) %scratch_bytes : buffer
  %shared_aligned, %scratch_aligned = buffer.assume.alignment %shared, %scratch {minimum_alignment = 64} : buffer, buffer
  %scratch_offset = index.constant 0 : offset
  %shared_view = buffer.view %shared_aligned[%scratch_offset] : buffer -> view<1xf32>
  %scratch_view = buffer.view %scratch_aligned[%scratch_offset] : buffer -> view<1xf32>
  %shared_value = view.load %shared_view[0] : view<1xf32> -> f32
  view.store %shared_value, %scratch_view[0] : f32, view<1xf32>
  %left_aligned, %left_scratch_aligned, %left_output_aligned = buffer.assume.alignment %left, %scratch, %left_output {minimum_alignment = 64} : buffer, buffer, buffer
  %left_offset = index.constant 0 : offset
  %left_view = buffer.view %left_aligned[%left_offset] : buffer -> view<1xf32>
  %left_scratch_view = buffer.view %left_scratch_aligned[%left_offset] : buffer -> view<1xf32>
  %left_output_view = buffer.view %left_output_aligned[%left_offset] : buffer -> view<1xf32>
  %left_value = view.load %left_view[0] : view<1xf32> -> f32
  %left_shared_value = view.load %left_scratch_view[0] : view<1xf32> -> f32
  %left_sum = scalar.addf %left_value, %left_shared_value : f32
  view.store %left_sum, %left_output_view[0] : f32, view<1xf32>
  %right_aligned, %right_scratch_aligned, %right_output_aligned = buffer.assume.alignment %right, %scratch, %right_output {minimum_alignment = 64} : buffer, buffer, buffer
  %right_offset = index.constant 0 : offset
  %right_view = buffer.view %right_aligned[%right_offset] : buffer -> view<1xf32>
  %right_scratch_view = buffer.view %right_scratch_aligned[%right_offset] : buffer -> view<1xf32>
  %right_output_view = buffer.view %right_output_aligned[%right_offset] : buffer -> view<1xf32>
  %right_value = view.load %right_view[0] : view<1xf32> -> f32
  %right_shared_value = view.load %right_scratch_view[0] : view<1xf32> -> f32
  %right_sum = scalar.addf %right_value, %right_shared_value : f32
  view.store %right_sum, %right_output_view[0] : f32, view<1xf32>
  func.return
}

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 5}) @parallel_folded_composite_array() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %fold_records = constant.u32 2 : reg<aie2p.array.scalar : index>
  %worker = worker.fold %workers, %worker_lane, %fold_records, @parallel_folded_composite_array_worker_0, 3, 2, "addf", 0
  %left = binding 0, "read"
  %right = binding 1, "read"
  %shared = binding 2, "read"
  %left_output = binding 3, "write"
  %right_output = binding 4, "write"
  %shared_sender = sender %shared, 0 : reg<aie2p.array.sender : tile<2x1xf32>>
  %shared_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %shared_record_sender = view.sender %shared_sender, %shared_offset : reg<aie2p.array.sender : tile<1xf32>>
  %shared_receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xf32>>
  %shared_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %shared_records = constant.u32 2 : reg<aie2p.array.scalar : index>
  %shared_channel = channel %shared_record_sender, %shared_receiver, %shared_capacity, %shared_records : reg<aie2p.array.channel : tile<1xf32>>
  %left_sender = sender %left, 0 : reg<aie2p.array.sender : tile<2x1xf32>>
  %left_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %left_record_sender = view.sender %left_sender, %left_offset : reg<aie2p.array.sender : tile<1xf32>>
  %left_receiver = receiver %worker, 1 : reg<aie2p.array.receiver : tile<1xf32>>
  %left_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %left_records = constant.u32 2 : reg<aie2p.array.scalar : index>
  %left_channel = channel %left_record_sender, %left_receiver, %left_capacity, %left_records : reg<aie2p.array.channel : tile<1xf32>>
  %right_sender = sender %right, 0 : reg<aie2p.array.sender : tile<2x1xf32>>
  %right_offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %right_record_sender = view.sender %right_sender, %right_offset : reg<aie2p.array.sender : tile<1xf32>>
  %right_receiver = receiver %worker, 2 : reg<aie2p.array.receiver : tile<1xf32>>
  %right_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %right_records = constant.u32 2 : reg<aie2p.array.scalar : index>
  %right_channel = channel %right_record_sender, %right_receiver, %right_capacity, %right_records : reg<aie2p.array.channel : tile<1xf32>>
  %left_result_sender = sender %worker, 3 : reg<aie2p.array.sender : tile<1xf32>>
  %left_output_receiver = receiver %left_output, 0 : reg<aie2p.array.receiver : tile<1xf32>>
  %left_output_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %left_output_records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %left_output_channel = channel %left_result_sender, %left_output_receiver, %left_output_capacity, %left_output_records : reg<aie2p.array.channel : tile<1xf32>>
  %right_result_sender = sender %worker, 4 : reg<aie2p.array.sender : tile<1xf32>>
  %right_output_receiver = receiver %right_output, 0 : reg<aie2p.array.receiver : tile<1xf32>>
  %right_output_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %right_output_records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %right_output_channel = channel %right_result_sender, %right_output_receiver, %right_output_capacity, %right_output_records : reg<aie2p.array.channel : tile<1xf32>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

