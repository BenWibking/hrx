  binding 1: access=1 bytes=176 alignment=64 offset=[0,18446744073709551615]
  binding 2: access=0 bytes=0 alignment=0 offset=[0,0]
  binding 3: access=2 bytes=168 alignment=64 offset=[0,18446744073709551615]
  binding 4: access=0 bytes=0 alignment=0 offset=[0,0]
  relocation 0: binding=1 addend=0 maximum=281474976710480 alignment=4
  relocation 1: binding=3 addend=0 maximum=281474976710488 alignment=4
  relocation 2: binding=1 addend=0 maximum=281474976710480 alignment=4
  relocation 3: binding=3 addend=0 maximum=281474976710488 alignment=4
  invocation 0: bytes=3456 next=1
