// The unused neighboring source dword remains independently live.
// RUN: emit amdgpu-assembly @preserve_neighbor strategy=source waits=none fixed=%factor:physical_register:0:1 fixed=%neighbor:physical_register:1:1 fixed=%values:physical_register:2:2 fixed=%addends:physical_register:4:2

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @preserve_neighbor(%factor: reg<amdgpu.vgpr>, %neighbor: reg<amdgpu.vgpr>, %values: reg<amdgpu.vgpr x2>, %addends: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>, reg<amdgpu.vgpr>) asm {
  %result = v_pk_fma_f32.broadcast_a %factor, %values, %addends
  %first = slice %result[0] : reg<amdgpu.vgpr x2> -> reg<amdgpu.vgpr>
  %neighbor_result = v_add_f32 %neighbor, %first
  return %result, %neighbor_result
}

// ----
  v_pk_fma_f32 v[2:3], v[0:1], v[2:3], v[4:5] op_sel_hi:[0,1,1]
  v_add_f32 v0, v1, v2
  s_endpgm

// ====

// Packed assembly uses pair spelling even for one scalar register.
// RUN: emit amdgpu-assembly @scalar_register strategy=source waits=none fixed=%factor:physical_register:0:1 fixed=%values:physical_register:0:2 fixed=%addends:physical_register:2:2

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @scalar_register(%factor: reg<amdgpu.sgpr>, %values: reg<amdgpu.vgpr x2>, %addends: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %result = v_pk_fma_f32.broadcast_a %factor, %values, %addends
  return %result
}

// ----
  v_pk_fma_f32 v[0:1], s[0:1], v[0:1], v[2:3] op_sel_hi:[0,1,1]
  s_endpgm

// ====

// All three selector bits clear while the instruction retains pair outputs.
// RUN: emit amdgpu-native-words @fma strategy=source waits=none fixed=%multiplicand:physical_register:0:1 fixed=%multiplier:physical_register:2:1 fixed=%accumulator:physical_register:4:1

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @fma(%multiplicand: reg<amdgpu.vgpr>, %multiplier: reg<amdgpu.vgpr>, %accumulator: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr x2>) asm {
  %result = v_pk_fma_f32.broadcast_a_b_c %multiplicand, %multiplier, %accumulator
  return %result
}

// ----
0xD3B00000
0x04120500
0xBF810000
