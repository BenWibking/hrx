// RUN: emit amdgpu-kernel-assembly input=source-low

// Compile-only fixtures exercise the declared transfer effects. Raw descriptor
// words are placeholders and these kernels are not device execution tests.
amdgpu.target<gfx1250> @target

kernel.def target(@target) @independent_allocations() {
  %c1 = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer) {
  %c0 = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %d0 = vector.constant 0 : vector<4xi32>
  %d1 = vector.constant 0 : vector<8xi32>
  %descriptor = kernel.tensor.lds.descriptor dgroups(%d0, %d1) : vector<4xi32>, vector<8xi32> -> kernel.tensor.lds.descriptor
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%c0] : buffer -> view<64xf32>
  %first = buffer.alloca<workgroup> align(256) %bytes : buffer
  %second = buffer.alloca<workgroup> align(256) %bytes : buffer
  %dest_first = buffer.view %first[%c0] : buffer -> view<64xf32>
  %dest_second = buffer.view %second[%c0] : buffer -> view<64xf32>
  %copy_first = kernel.async.tensor.load.to.lds %source to %dest_first using %descriptor {cache_scope = cu, cache_temporal = regular} : view<64xf32> to view<64xf32>, kernel.tensor.lds.descriptor -> kernel.async.token
  %group_first = kernel.async.group %copy_first : kernel.async.token -> kernel.async.group
  %copy_second = kernel.async.tensor.load.to.lds %source to %dest_second using %descriptor {cache_scope = cu, cache_temporal = regular} : view<64xf32> to view<64xf32>, kernel.tensor.lds.descriptor -> kernel.async.token
  %group_second = kernel.async.group %copy_second : kernel.async.token -> kernel.async.group
  kernel.async.wait %group_first {newer_groups = 1} : kernel.async.group
  kernel.async.wait %group_second {newer_groups = 0} : kernel.async.group
  kernel.return
}

