// ====

// Equal SSA lane offsets do not mean equal addresses across participants.
// The store envelope overlaps the transfer even though one lane's views do not.
amdgpu.target<gfx1250> @target

kernel.def target(@target) @participant_varying_overlap() {
  %c1 = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer) {
  %c0 = index.constant 0 : offset
  %bytes = index.constant 768 : offset
  %d0 = vector.constant 0 : vector<4xi32>
  %d1 = vector.constant 0 : vector<8xi32>
  %descriptor = kernel.tensor.lds.descriptor dgroups(%d0, %d1) : vector<4xi32>, vector<8xi32> -> kernel.tensor.lds.descriptor
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%c0] : buffer -> view<64xf32>
  %scratch = buffer.alloca<workgroup> align(256) %bytes : buffer
  %lane = kernel.workitem.id<x> : index
  %stride = index.constant 4 : offset
  %lane_offset = index.scale %lane, %stride : index, offset -> offset
  %shift = index.constant 128 : offset
  %shifted_offset = index.add %lane_offset, %shift : offset
  %writes = buffer.view %scratch[%lane_offset] : buffer -> view<1xf32>
  %dest = buffer.view %scratch[%shifted_offset] : buffer -> view<64xf32>
  %value = scalar.constant 1.0 : f32
  view.store %value, %writes[0] : f32, view<1xf32>
  %copy = kernel.async.tensor.load.to.lds %source to %dest using %descriptor {cache_scope = cu, cache_temporal = regular} : view<64xf32> to view<64xf32>, kernel.tensor.lds.descriptor -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.return
}

