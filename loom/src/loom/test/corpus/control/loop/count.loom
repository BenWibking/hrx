// Unsigned -1 is above four, so no increment executes.
kernel.def @unsigned_empty_loop() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  func.call @compute_unsigned_empty_loop(%output) : (buffer)
  kernel.return
}

func.def device inline @compute_unsigned_empty_loop(%output: buffer) {
  %begin = index.constant -1 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %position = index.constant 0 : index
  %initial_count = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %output_view = buffer.view %aligned_output[%base] : buffer -> view<1xi32>
  cfg.br ^header(%begin: index, %initial_count: i32)
^header(%counter: index, %count: i32):
  %more = index.cmp ult, %counter, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  view.store %count, %output_view[%position] : i32, view<1xi32>
  %next = index.add %counter, %step : index
  %next_count = scalar.addi %count, %increment : i32
  cfg.br ^header(%next: index, %next_count: i32)
^exit:
  view.store %count, %output_view[%position] : i32, view<1xi32>
  func.return
}

// Signed -1 reaches four after five increments.
kernel.def @signed_negative_loop() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  func.call @compute_signed_negative_loop(%output) : (buffer)
  kernel.return
}

func.def device inline @compute_signed_negative_loop(%output: buffer) {
  %begin = index.constant -1 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %position = index.constant 0 : index
  %initial_count = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %output_view = buffer.view %aligned_output[%base] : buffer -> view<1xi32>
  cfg.br ^header(%begin: index, %initial_count: i32)
^header(%counter: index, %count: i32):
  %more = index.cmp slt, %counter, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  view.store %count, %output_view[%position] : i32, view<1xi32>
  %next = index.add %counter, %step : index
  %next_count = scalar.addi %count, %increment : i32
  cfg.br ^header(%next: index, %next_count: i32)
^exit:
  view.store %count, %output_view[%position] : i32, view<1xi32>
  func.return
}

// A fixed-width unsigned counter crosses its signed boundary without wrapping.
kernel.def @unsigned_sign_crossing_loop() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  func.call @compute_unsigned_sign_crossing_loop(%output) : (buffer)
  kernel.return
}

func.def device inline @compute_unsigned_sign_crossing_loop(%output: buffer) {
  %begin = scalar.constant 2147483646 : i32
  %end = scalar.constant -2147483645 : i32
  %step = scalar.constant 2 : i32
  %base = index.constant 0 : offset
  %position = index.constant 0 : index
  %initial_count = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %output_view = buffer.view %aligned_output[%base] : buffer -> view<1xi32>
  cfg.br ^header(%begin: i32, %initial_count: i32)
^header(%counter: i32, %count: i32):
  %more = scalar.cmpi ult, %counter, %end : i32
  cfg.cond_br %more, ^body, ^exit
^body:
  view.store %count, %output_view[%position] : i32, view<1xi32>
  %next = scalar.addi %counter, %step : i32
  %next_count = scalar.addi %count, %increment : i32
  cfg.br ^header(%next: i32, %next_count: i32)
^exit:
  view.store %count, %output_view[%position] : i32, view<1xi32>
  func.return
}

// A true guard exits immediately; the comparison is not a continuation test.
kernel.def @inverted_loop_guard() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  func.call @compute_inverted_loop_guard(%output) : (buffer)
  kernel.return
}

func.def device inline @compute_inverted_loop_guard(%output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %position = index.constant 0 : index
  %initial_count = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %output_view = buffer.view %aligned_output[%base] : buffer -> view<1xi32>
  cfg.br ^header(%begin: index, %initial_count: i32)
^header(%counter: index, %count: i32):
  %more = index.cmp ult, %counter, %end : index
  cfg.cond_br %more, ^exit, ^body
^body:
  view.store %count, %output_view[%position] : i32, view<1xi32>
  %next = index.add %counter, %step : index
  %next_count = scalar.addi %count, %increment : i32
  cfg.br ^header(%next: index, %next_count: i32)
^exit:
  view.store %count, %output_view[%position] : i32, view<1xi32>
  func.return
}

// A signed carried counter needs the initializer's lower bound as well as the
// guard's upper bound to establish every store's memory footprint.
kernel.def @carried_counter_store() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  func.call @compute_carried_counter_store(%output) : (buffer)
  kernel.return
}

func.def device inline @compute_carried_counter_store(%output: buffer) {
  %loop_begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<4xi32>
  cfg.br ^preheader
^preheader:
  cfg.br ^header(%loop_begin: index)
^header(%position: index):
  %more = index.cmp slt, %position, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %value = index.cast %position : index to i32
  view.store %value, %output_view[%position] : i32, view<4xi32>
  %next = index.add %position, %step : index
  cfg.br ^header(%next: index)
^exit:
  func.return
}

func.def @unsigned_empty_loop_oracle(%output: buffer) {
  func.call @compute_unsigned_empty_loop(%output) : (buffer)
  func.return
}

func.def @signed_negative_loop_oracle(%output: buffer) {
  func.call @compute_signed_negative_loop(%output) : (buffer)
  func.return
}

func.def @unsigned_sign_crossing_loop_oracle(%output: buffer) {
  func.call @compute_unsigned_sign_crossing_loop(%output) : (buffer)
  func.return
}

func.def @inverted_loop_guard_oracle(%output: buffer) {
  func.call @compute_inverted_loop_guard(%output) : (buffer)
  func.return
}

func.def @carried_counter_store_oracle(%output: buffer) {
  func.call @compute_carried_counter_store(%output) : (buffer)
  func.return
}

check.scenario @explicit_loop_count_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %unsigned_empty = check.generate.fill value(-1) : tensor<1xi32>
    check.compare<@unsigned_empty_loop, @unsigned_empty_loop_oracle>(%unsigned_empty) : (tensor<1xi32>) -> () {
      check.expect.bitwise actual(%unsigned_empty) expected(%unsigned_empty) : tensor<1xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %signed_negative = check.generate.fill value(-1) : tensor<1xi32>
    check.compare<@signed_negative_loop, @signed_negative_loop_oracle>(%signed_negative) : (tensor<1xi32>) -> () {
      check.expect.bitwise actual(%signed_negative) expected(%signed_negative) : tensor<1xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %unsigned_crossing = check.generate.fill value(-1) : tensor<1xi32>
    check.compare<@unsigned_sign_crossing_loop, @unsigned_sign_crossing_loop_oracle>(%unsigned_crossing) : (tensor<1xi32>) -> () {
      check.expect.bitwise actual(%unsigned_crossing) expected(%unsigned_crossing) : tensor<1xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %inverted_guard = check.generate.fill value(-1) : tensor<1xi32>
    check.compare<@inverted_loop_guard, @inverted_loop_guard_oracle>(%inverted_guard) : (tensor<1xi32>) -> () {
      check.expect.bitwise actual(%inverted_guard) expected(%inverted_guard) : tensor<1xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %carried_storage = check.generate.fill value(-1) : tensor<12xi32>
    %carried_output = check.tensor.view %carried_storage offset(16) : tensor<12xi32> -> tensor<4xi32>
    check.compare<@carried_counter_store, @carried_counter_store_oracle>(%carried_output) : (tensor<4xi32>) -> () {
      check.expect.bitwise actual(%carried_storage) expected(%carried_storage) : tensor<12xi32>
    }
  }
  check.return
}
