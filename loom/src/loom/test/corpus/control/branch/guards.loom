// Empty true arms preserve the guards around loads and nested loop effects.
func.def device inline @accumulate_nonnegative(%output: view<1xi32>, %value: i32) {
  %c0 = scalar.constant 0 : i32
  %skip = scalar.cmpi slt, %value, %c0 : i32
  scf.if %skip {
  } else {
    %previous = view.load %output[0] : view<1xi32> -> i32
    %next = scalar.addi %previous, %value : i32
    view.store %next, %output[0] : i32, view<1xi32>
  }
  func.return
}

kernel.def @conditional_guards() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %length: i32, %stop: i32, %iterations: index) {
  %lane = kernel.workitem.id<x> : index
  func.call @compute_conditional_guards(%input, %output, %length, %stop, %iterations, %lane) : (buffer, buffer, i32, i32, index, index)
  kernel.return
}

func.def device inline @compute_conditional_guards(%input: buffer, %output: buffer, %length: i32, %stop: i32, %iterations: index, %lane: index) {
  %c0 = scalar.constant 0 : i32
  %stopped = scalar.cmpi ne, %stop, %c0 : i32
  scf.if %stopped {
  } else {
    %lane_integer = index.cast %lane : index to i32
    %out_of_bounds = scalar.cmpi uge, %lane_integer, %length : i32
    scf.if %out_of_bounds {
    } else {
      %stride = index.constant 4 : offset
      %address = index.scale %lane, %stride : index, offset -> offset
      %input_view = buffer.view %input[%address] : buffer -> view<1xi32>
      %value = view.load %input_view[0] : view<1xi32> -> i32
      %output_view = buffer.view %output[%address] : buffer -> view<1xi32>
      %begin = index.constant 0 : index
      %step = index.constant 1 : index
      scf.for %iteration = [%begin to %iterations step %step] {
        func.call @accumulate_nonnegative(%output_view, %value) : (view<1xi32>, i32)
      }
    }
  }
  func.return
}

// A uniform stop suppresses loads even when length exceeds the input buffer.
// An empty active range performs no loads and leaves the output untouched.
// Cross-wave tails and negative inputs leave their output unchanged. Active
// nonnegative inputs contribute three additions to the initial value of -123.
// The reference is -123 plus three additions of each nonnegative input.
func.def @conditional_guards_oracle(%input: buffer, %output: buffer, %length: i32, %stop: i32, %iterations: index) {
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @compute_conditional_guards(%input, %output, %length, %stop, %iterations, %lane) : (buffer, buffer, i32, i32, index, index)
  }
  func.return
}

check.scenario @conditional_guard_values {
  // A uniform stop suppresses loads even when length exceeds the input buffer.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-18) step(1) : tensor<1xi32>
    %storage = check.generate.fill value(-123) : tensor<96xi32>
    %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %length = check.literal value(64) : i32
    %stop = check.literal value(1) : i32
    %iterations = check.literal value(3) : index
    check.compare<@conditional_guards, @conditional_guards_oracle>(%input, %output, %length, %stop, %iterations) : (tensor<1xi32>, tensor<64xi32>, i32, i32, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi32>
    }
  }
  // An empty active range performs no loads and leaves storage untouched.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-18) step(1) : tensor<1xi32>
    %storage = check.generate.fill value(-123) : tensor<96xi32>
    %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %length = check.literal value(0) : i32
    %stop = check.literal value(0) : i32
    %iterations = check.literal value(3) : index
    check.compare<@conditional_guards, @conditional_guards_oracle>(%input, %output, %length, %stop, %iterations) : (tensor<1xi32>, tensor<64xi32>, i32, i32, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi32>
    }
  }
  // Cross-wave tails and negative inputs exercise every nested guard.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-18) step(1) : tensor<37xi32>
    %storage = check.generate.fill value(-123) : tensor<96xi32>
    %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %length = check.literal value(37) : i32
    %stop = check.literal value(0) : i32
    %iterations = check.literal value(3) : index
    check.compare<@conditional_guards, @conditional_guards_oracle>(%input, %output, %length, %stop, %iterations) : (tensor<37xi32>, tensor<64xi32>, i32, i32, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<37xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-18) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-123) : tensor<96xi32>
    %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %length = check.literal value(64) : i32
    %stop = check.literal value(0) : i32
    %iterations = check.literal value(3) : index
    check.compare<@conditional_guards, @conditional_guards_oracle>(%input, %output, %length, %stop, %iterations) : (tensor<64xi32>, tensor<64xi32>, i32, i32, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi32>
    }
  }
  check.return
}

// The row guard excludes the final half-workgroup. Reconstructing a flat
// vector address must retain that bound on the original linear coordinate.
kernel.def @quotient_guarded_vector_transfer() {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  %blocks = index.constant 37 : index
  kernel.launch.config workgroups(%blocks, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %threads = index.constant 64 : index
  %rows = index.constant 73 : index
  %groups = index.constant 32 : index
  %width = index.constant 16 : index
  %block = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %linear = index.madd %block, %threads, %lane : index
  %row = index.div %linear, %groups : index
  %group = index.rem %linear, %groups : index
  %column = index.mul %group, %width : index
  %inside = index.cmp ult, %row, %rows : index
  %inputs = buffer.view %input[%base] : buffer -> view<73x512xf32>
  %outputs = buffer.view %output[%base] : buffer -> view<73x512xf32>
  scf.if %inside {
    %value = vector.load %inputs[%row, %column] : view<73x512xf32> -> vector<16xf32>
    vector.store %value, %outputs[%row, %column] : vector<16xf32>, view<73x512xf32>
  }
  kernel.return
}

// Copy exactly the valid elements without the kernel's quotient, remainder,
// vector addressing, workgroup topology, or conditional execution.
func.def @quotient_guarded_vector_transfer_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 37376 : index
  %step = index.constant 1 : index
  %inputs = buffer.view %input[%base] : buffer -> view<37376xf32>
  %outputs = buffer.view %output[%base] : buffer -> view<37376xf32>
  scf.for %element = [%begin to %end step %step] {
    %value = view.load %inputs[%element] : view<37376xf32> -> f32
    view.store %value, %outputs[%element] : f32, view<37376xf32>
  }
  func.return
}

check.scenario @quotient_guarded_vector_transfer_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<37408xf32>
    %input = check.tensor.view %input_storage offset(64) : tensor<37408xf32> -> tensor<37376xf32>
    %output_storage = check.generate.fill value(-11.0) : tensor<37408xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<37408xf32> -> tensor<37376xf32>
    check.compare<@quotient_guarded_vector_transfer, @quotient_guarded_vector_transfer_oracle>(%input, %output) : (tensor<37376xf32>, tensor<37376xf32>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<37408xf32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<37408xf32>
    }
  }
  check.return
}
