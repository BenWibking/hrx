  %base_right = index.constant 0 : offset
  %base_left = index.constant 512 : offset
  %base_constant_right = index.constant 1024 : offset
  %base_constant_left = index.constant 1536 : offset
  %outputs_right = buffer.view %output[%base_right] : buffer -> view<64xi64>
  %outputs_left = buffer.view %output[%base_left] : buffer -> view<64xi64>
  %outputs_constant_right = buffer.view %output[%base_constant_right] : buffer -> view<64xi64>
  %outputs_constant_left = buffer.view %output[%base_constant_left] : buffer -> view<64xi64>
  view.store %word_right, %outputs_right[%lane] : i64, view<64xi64>
  view.store %word_left, %outputs_left[%lane] : i64, view<64xi64>
  view.store %word_constant_right, %outputs_constant_right[%lane] : i64, view<64xi64>
  view.store %word_constant_left, %outputs_constant_left[%lane] : i64, view<64xi64>
  kernel.return
}

