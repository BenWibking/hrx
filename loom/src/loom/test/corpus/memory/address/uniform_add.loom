func.def device inline @compute_index_uniform_add(%step: index, %value: i32) -> (i32, i32, i32, i32) {
  %position = index.cast %value : i32 to index
  %increment = index.constant 64 : index
  %sum_right = index.add %position, %step : index
  %word_right = index.cast %sum_right : index to i32
  %sum_left = index.add %step, %position : index
  %word_left = index.cast %sum_left : index to i32
  %sum_constant_right = index.add %position, %increment : index
  %word_constant_right = index.cast %sum_constant_right : index to i32
  %sum_constant_left = index.add %increment, %position : index
  %word_constant_left = index.cast %sum_constant_left : index to i32
  func.return %word_right, %word_left, %word_constant_right, %word_constant_left : i32, i32, i32, i32
}

kernel.def @index_uniform_add() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%step: index, %input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<64xi32>
  %value = view.load %inputs[%lane] : view<64xi32> -> i32
  %word_right, %word_left, %word_constant_right, %word_constant_left = func.call pure @compute_index_uniform_add(%step, %value) : (index, i32) -> (i32, i32, i32, i32)
  %base_right = index.constant 0 : offset
  %base_left = index.constant 256 : offset
  %base_constant_right = index.constant 512 : offset
  %base_constant_left = index.constant 768 : offset
  %outputs_right = buffer.view %output[%base_right] : buffer -> view<64xi32>
  %outputs_left = buffer.view %output[%base_left] : buffer -> view<64xi32>
  %outputs_constant_right = buffer.view %output[%base_constant_right] : buffer -> view<64xi32>
  %outputs_constant_left = buffer.view %output[%base_constant_left] : buffer -> view<64xi32>
  view.store %word_right, %outputs_right[%lane] : i32, view<64xi32>
  view.store %word_left, %outputs_left[%lane] : i32, view<64xi32>
  view.store %word_constant_right, %outputs_constant_right[%lane] : i32, view<64xi32>
  view.store %word_constant_left, %outputs_constant_left[%lane] : i32, view<64xi32>
  kernel.return
}

func.def @index_uniform_add_oracle(%step: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<64xi32>
  %base_right = index.constant 0 : offset
  %base_left = index.constant 256 : offset
  %base_constant_right = index.constant 512 : offset
  %base_constant_left = index.constant 768 : offset
  %outputs_right = buffer.view %output[%base_right] : buffer -> view<64xi32>
  %outputs_left = buffer.view %output[%base_left] : buffer -> view<64xi32>
  %outputs_constant_right = buffer.view %output[%base_constant_right] : buffer -> view<64xi32>
  %outputs_constant_left = buffer.view %output[%base_constant_left] : buffer -> view<64xi32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %loop_step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %loop_step] {
    %value = view.load %inputs[%lane] : view<64xi32> -> i32
    %word_right, %word_left, %word_constant_right, %word_constant_left = func.call pure @compute_index_uniform_add(%step, %value) : (index, i32) -> (i32, i32, i32, i32)
    view.store %word_right, %outputs_right[%lane] : i32, view<64xi32>
    view.store %word_left, %outputs_left[%lane] : i32, view<64xi32>
    view.store %word_constant_right, %outputs_constant_right[%lane] : i32, view<64xi32>
    view.store %word_constant_left, %outputs_constant_left[%lane] : i32, view<64xi32>
  }
  func.return
}

check.scenario @index_uniform_add_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %step = check.literal value(-17) : index
    %input = check.generate.iota offset(100) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-123) : tensor<288xi32>
    %output = check.tensor.view %storage offset(64) : tensor<288xi32> -> tensor<256xi32>
    check.compare<@index_uniform_add, @index_uniform_add_oracle>(%step, %input, %output) : (index, tensor<64xi32>, tensor<256xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<288xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %step = check.literal value(37) : index
    %input = check.generate.iota offset(2147483500) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-123) : tensor<288xi32>
    %output = check.tensor.view %storage offset(64) : tensor<288xi32> -> tensor<256xi32>
    check.compare<@index_uniform_add, @index_uniform_add_oracle>(%step, %input, %output) : (index, tensor<64xi32>, tensor<256xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<288xi32>
    }
  }
  check.return
}

func.def device inline @compute_offset_uniform_add(%raw_step: offset, %value: i64) -> (i64, i64, i64, i64) {
  %raw_position = scalar.assume %value [range(%value, 0, 4294967040)] : i64
  %position = index.cast %raw_position : i64 to offset
  %step = index.assume %raw_step [range(%raw_step, 0, 255)] : offset
  %increment = index.constant 128 : offset
  %sum_right = index.add %position, %step : offset
  %word_right = index.cast %sum_right : offset to i64
  %sum_left = index.add %step, %position : offset
  %word_left = index.cast %sum_left : offset to i64
  %sum_constant_right = index.add %position, %increment : offset
  %word_constant_right = index.cast %sum_constant_right : offset to i64
  %sum_constant_left = index.add %increment, %position : offset
  %word_constant_left = index.cast %sum_constant_left : offset to i64
  func.return %word_right, %word_left, %word_constant_right, %word_constant_left : i64, i64, i64, i64
}

