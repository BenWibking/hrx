func.def @vector_bitwise_i32(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xi32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<12xi32>
  %lhs = vector.load %lhs_view[0] : view<4xi32> -> vector<4xi32>
  %rhs = vector.load %rhs_view[0] : view<4xi32> -> vector<4xi32>
  %and_result = vector.andi %lhs, %rhs : vector<4xi32>
  vector.store %and_result, %output_view[0] : vector<4xi32>, view<12xi32>
  %or_result = vector.ori %lhs, %rhs : vector<4xi32>
  vector.store %or_result, %output_view[4] : vector<4xi32>, view<12xi32>
  %xor_result = vector.xori %lhs, %rhs : vector<4xi32>
  vector.store %xor_result, %output_view[8] : vector<4xi32>, view<12xi32>
  func.return
}

func.def @vector_bitwise_i64(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<2xi64>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<2xi64>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<6xi64>
  %lhs = vector.load %lhs_view[0] : view<2xi64> -> vector<2xi64>
  %rhs = vector.load %rhs_view[0] : view<2xi64> -> vector<2xi64>
  %and_result = vector.andi %lhs, %rhs : vector<2xi64>
  vector.store %and_result, %output_view[0] : vector<2xi64>, view<6xi64>
  %or_result = vector.ori %lhs, %rhs : vector<2xi64>
  vector.store %or_result, %output_view[2] : vector<2xi64>, view<6xi64>
  %xor_result = vector.xori %lhs, %rhs : vector<2xi64>
  vector.store %xor_result, %output_view[4] : vector<2xi64>, view<6xi64>
  func.return
}
