// Every result reaches both vector payload selection and scalar extension.
func.def @predicate_bitwise_values(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer, %limit: i32, %true_payload: i32, %false_payload: i32) -> (i32, i32, i32, i32, i32, i32) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xi32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<12xi32>
  %lhs_words = vector.load %lhs_view[0] : view<4xi32> -> vector<4xi32>
  %rhs_words = vector.load %rhs_view[0] : view<4xi32> -> vector<4xi32>
  %limits = vector.splat %limit : vector<4xi32>
  %lhs = vector.cmpi ne, %lhs_words, %limits : vector<4xi32> -> vector<4xi1>
  %rhs = vector.cmpi ne, %rhs_words, %limits : vector<4xi32> -> vector<4xi1>
  %on_true = vector.splat %true_payload : vector<4xi32>
  %on_false = vector.splat %false_payload : vector<4xi32>
  %and_result = vector.andi %lhs, %rhs : vector<4xi1>
  %and_payload = vector.select %and_result, %on_true, %on_false : vector<4xi32>
  vector.store %and_payload, %output_view[0] : vector<4xi32>, view<12xi32>
  %and_first = vector.extract %and_result[0] : vector<4xi1> -> i1
  %and_last = vector.extract %and_result[3] : vector<4xi1> -> i1
  %and_signed = scalar.extsi %and_first : i1 to i32
  %and_unsigned = scalar.extui %and_last : i1 to i32
  %or_result = vector.ori %lhs, %rhs : vector<4xi1>
  %or_payload = vector.select %or_result, %on_true, %on_false : vector<4xi32>
  vector.store %or_payload, %output_view[4] : vector<4xi32>, view<12xi32>
  %or_first = vector.extract %or_result[0] : vector<4xi1> -> i1
  %or_last = vector.extract %or_result[3] : vector<4xi1> -> i1
  %or_signed = scalar.extsi %or_first : i1 to i32
  %or_unsigned = scalar.extui %or_last : i1 to i32
  %xor_result = vector.xori %lhs, %rhs : vector<4xi1>
  %xor_payload = vector.select %xor_result, %on_true, %on_false : vector<4xi32>
  vector.store %xor_payload, %output_view[8] : vector<4xi32>, view<12xi32>
  %xor_first = vector.extract %xor_result[0] : vector<4xi1> -> i1
  %xor_last = vector.extract %xor_result[3] : vector<4xi1> -> i1
  %xor_signed = scalar.extsi %xor_first : i1 to i32
  %xor_unsigned = scalar.extui %xor_last : i1 to i32
  func.return %and_signed, %and_unsigned, %or_signed, %or_unsigned, %xor_signed, %xor_unsigned : i32, i32, i32, i32, i32, i32
}
