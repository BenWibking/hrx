// Independently computed predicates reach both whole-vector and scalar uses.
func.def @predicate_select_values(%conditions: buffer, %true_values: buffer, %false_values: buffer, %output: buffer, %limit: i32, %true_payload: i32, %false_payload: i32) -> (i32, i32) {
  %base = index.constant 0 : offset
  %condition_view = buffer.view %conditions[%base] : buffer -> view<4xi32>
  %true_view = buffer.view %true_values[%base] : buffer -> view<4xi32>
  %false_view = buffer.view %false_values[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<4xi32>
  %condition_words = vector.load %condition_view[0] : view<4xi32> -> vector<4xi32>
  %true_words = vector.load %true_view[0] : view<4xi32> -> vector<4xi32>
  %false_words = vector.load %false_view[0] : view<4xi32> -> vector<4xi32>
  %limits = vector.splat %limit : vector<4xi32>
  %mask = vector.cmpi ne, %condition_words, %limits : vector<4xi32> -> vector<4xi1>
  %true_predicates = vector.cmpi ne, %true_words, %limits : vector<4xi32> -> vector<4xi1>
  %false_predicates = vector.cmpi ne, %false_words, %limits : vector<4xi32> -> vector<4xi1>
  %selected = vector.select %mask, %true_predicates, %false_predicates : vector<4xi1>
  %on_true = vector.splat %true_payload : vector<4xi32>
  %on_false = vector.splat %false_payload : vector<4xi32>
  %payload = vector.select %selected, %on_true, %on_false : vector<4xi32>
  vector.store %payload, %output_view[0] : vector<4xi32>, view<4xi32>
  %first = vector.extract %selected[0] : vector<4xi1> -> i1
  %last = vector.extract %selected[3] : vector<4xi1> -> i1
  %signed = scalar.extsi %first : i1 to i32
  %unsigned = scalar.extui %last : i1 to i32
  func.return %signed, %unsigned : i32, i32
}
