// Fixed-width numeric payloads retain every bit across named, indexed and
// first-active exchange. Packed tails cross scalar memory so padding is not
// part of the observable payload. The input repeats every 32 invocations,
// allowing the same exact native oracle for wave32 and wave64.
kernel.def @subgroup_transport_i64_1() {
  %unit = index.constant 1 : index
  %items = index.constant 96 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%selected: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %elements = index.constant 1 : index
  %position = index.mul %item, %elements : index
  %group = index.constant 96 : index
  %second = index.add %position, %group : index
  %third = index.add %second, %group : index
  %bounded = index.assume %selected [range(%selected, 0, 31)] : index
  %source_lane = index.cast %bounded : index to i32
  %input_view = buffer.view %input[%base] : buffer -> view<96xi64>
  %output_view = buffer.view %output[%base] : buffer -> view<288xi64>
  %value = view.load %input_view[%position] : view<96xi64> -> i64
  %named = kernel.subgroup.broadcast %value from %source_lane : i64, i32
  view.store %named, %output_view[%position] : i64, view<288xi64>
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<index> %value, %source_lane, %width : i64, i32, i32
  scf.if %valid {
    view.store %shuffled, %output_view[%second] : i64, view<288xi64>
  }
  %cluster = index.constant 32 : index
  %relative_lane = index.rem %item, %cluster : index
  %first_lane = index.constant 5 : index
  %end_lane = index.constant 10 : index
  %above = index.cmp uge, %relative_lane, %first_lane : index
  %below = index.cmp ult, %relative_lane, %end_lane : index
  %active = scalar.andi %above, %below : i1
  scf.if %active {
    %first = kernel.subgroup.broadcast.first %value : i64
    view.store %first, %output_view[%third] : i64, view<288xi64>
  }
  kernel.return
}

