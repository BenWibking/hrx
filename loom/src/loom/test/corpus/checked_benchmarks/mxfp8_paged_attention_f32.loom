// Cooperative decode attention over the DeepSeek V4.1 MXFP8 cache layout.
// Each physical K/V page stores sixteen 512-byte E4M3FN rows followed by
// sixteen 16-byte E8M0 scale rows. One scale byte owns 32 adjacent channels.
// K and V use separate caches, so their payload and scale identities remain
// independent across guarded pipeline read-ahead.
//
// One subgroup handles one 512-channel query. Each lane loads a contiguous
// fragment and selects the page-local scale byte for its 32-channel group.
// Raw payload fragments and scale words cross the pipeline boundary; decoding,
// QK reduction, online softmax, and PV accumulation remain ordered consumers.
// The serial and depth-three entry points share this template and unroll factor.
template.decl @mxfp8_paged_attention(%instance_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer, %depth: index, %factor: index)

template.def<@mxfp8_paged_attention> @mxfp8_paged_attention_impl(%instance_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer, %depth: index, %factor: index) {
  %instance_id = kernel.workgroup.id<x> : index
  %instance, %instances = index.assume %instance_id, %instance_count [range(%instance_count, 1, 256), lt(%instance_id, %instance_count)] : index, index
  %lane = kernel.subgroup.lane.id : index
  %width = kernel.subgroup.size : index
  %head_width = index.constant 512 : index
  %fragment_width = index.constant 8 : index
  %fragment_span = index.mul %width, %fragment_width : index
  %channel0 = index.mul %lane, %fragment_width : index
  %channel1 = index.add %channel0, %fragment_span : index
  %has_second_fragment = index.cmp ult, %fragment_span, %head_width : index
  %scale_group_width = index.constant 32 : index
  %scale_group0 = index.div %channel0, %scale_group_width : index
  %scale_group1 = index.div %channel1, %scale_group_width : index
  %begin = index.constant 0 : index
  %row_step = index.constant 1 : index
  %page_rows = index.constant 16 : index
  %page_bytes = index.constant 8448 : offset
  %data_row_bytes = index.constant 512 : offset
  %scale_plane_bytes = index.constant 8192 : offset
  %scale_row_bytes = index.constant 16 : offset
  %base = index.constant 0 : offset
  %first_page_id = scalar.constant 0 : i32
  %zero_scale = scalar.constant 0 : i32
  %zero_payload_element = scalar.constant 0.0 : f8E4M3
  %zero_payload = vector.splat %zero_payload_element : vector<8xf8E4M3>
  %initial_max = scalar.constant -1000000000.0 : f32
  %identity = scalar.constant 0.0 : f32
  %score_scale = scalar.constant 0.044194173824159223 : f32
  %initial_accumulator = vector.splat %identity : vector<8xf32>
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=8, scale_format=e8m0, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %lengths_aligned = buffer.assume.alignment %lengths {minimum_alignment = 4} : buffer
  %query_aligned = buffer.assume.alignment %query {minimum_alignment = 4} : buffer
  %table_aligned = buffer.assume.alignment %page_table {minimum_alignment = 4} : buffer
  %keys_aligned = buffer.assume.alignment %keys {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %values {minimum_alignment = 4} : buffer
  %state_aligned = buffer.assume.alignment %final_state {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %length_storage, %query_storage, %table_storage, %key_storage, %value_storage, %state_storage, %output_storage = buffer.assume.noalias %lengths_aligned, %query_aligned, %table_aligned, %keys_aligned, %values_aligned, %state_aligned, %output_aligned : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %length_view = buffer.view %length_storage[%base] : buffer -> view<[%instances]xi32>
  %query_view = buffer.view %query_storage[%base] : buffer -> view<[%instances]x512xf32>
  %table = buffer.view %table_storage[%base] : buffer -> view<[%instances]x64xi32>
  %state = buffer.view %state_storage[%base] : buffer -> view<[%instances]x2xf32>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<[%instances]x512xf32>
  %length = view.load %length_view[%instance] : view<[%instances]xi32> -> i32
  %length_index = index.cast %length : i32 to index
  %count = index.assume %length_index [range(%length_index, 0, 1024)] : index
  %query_fragment0 = vector.load %query_view[%instance, %channel0] : view<[%instances]x512xf32> -> vector<8xf32>
  %query_fragment1 = scf.if %has_second_fragment -> (vector<8xf32>) {
    %loaded_query = vector.load %query_view[%instance, %channel1] : view<[%instances]x512xf32> -> vector<8xf32>
    scf.yield %loaded_query : vector<8xf32>
  } else {
    scf.yield %initial_accumulator : vector<8xf32>
  }
  %maximum, %denominator, %numerator0, %numerator1 = scf.for %page_begin = [%begin to %count step %page_rows](%page_max = %initial_max : f32, %page_sum = %identity : f32, %page_accumulator0 = %initial_accumulator : vector<8xf32>, %page_accumulator1 = %initial_accumulator : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>) {
    %logical_page = index.div %page_begin, %page_rows : index
    %page_id = view.load %table[%instance, %logical_page] : view<[%instances]x64xi32> -> i32
    %present = scalar.cmpi sge, %page_id, %first_page_id : i32
    %next_page_max, %next_page_sum, %next_page_accumulator0, %next_page_accumulator1 = scf.if %present -> (f32, f32, vector<8xf32>, vector<8xf32>) {
      %page_index = index.cast %page_id : i32 to index
      %page = index.assume %page_index [range(%page_index, 0, 255)] : index
      %page_offset = index.scale %page, %page_bytes : index, offset -> offset
      %scale_page_offset = index.add %page_offset, %scale_plane_bytes : offset
      %rows_max, %rows_sum, %rows_accumulator0, %rows_accumulator1 = scf.for %row = [%begin to %page_rows step %row_step](%row_max = %page_max : f32, %row_sum = %page_sum : f32, %row_accumulator0 = %page_accumulator0 : vector<8xf32>, %row_accumulator1 = %page_accumulator1 : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>) pipeline(%depth) unroll(%factor) {
        %token = index.add %page_begin, %row : index
        %valid = index.cmp slt, %token, %count : index
        %key_payload0, %value_payload0, %key_scale0, %value_scale0, %key_payload1, %value_payload1, %key_scale1, %value_scale1 = scf.if %valid -> (vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32, vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32) {
          %data_row_offset = index.scale %row, %data_row_bytes : index, offset -> offset
          %data_offset_base = index.add %page_offset, %data_row_offset : offset
          %scale_row_offset = index.scale %row, %scale_row_bytes : index, offset -> offset
          %scale_offset_base = index.add %scale_page_offset, %scale_row_offset : offset
          %channel_offset0 = index.cast %channel0 : index to offset
          %data_offset0 = index.add %data_offset_base, %channel_offset0 : offset
          %scale_group_offset0 = index.cast %scale_group0 : index to offset
          %scale_offset0 = index.add %scale_offset_base, %scale_group_offset0 : offset
          %key_payload_view0 = buffer.view %key_storage[%data_offset0] : buffer -> view<8xf8E4M3>
          %value_payload_view0 = buffer.view %value_storage[%data_offset0] : buffer -> view<8xf8E4M3>
          %key_scale_view0 = buffer.view %key_storage[%scale_offset0] : buffer -> view<1xi8>
          %value_scale_view0 = buffer.view %value_storage[%scale_offset0] : buffer -> view<1xi8>
          %loaded_key_payload0 = vector.load %key_payload_view0[0] : view<8xf8E4M3> -> vector<8xf8E4M3>
          %loaded_value_payload0 = vector.load %value_payload_view0[0] : view<8xf8E4M3> -> vector<8xf8E4M3>
          %key_scale_byte0 = view.load %key_scale_view0[0] : view<1xi8> -> i8
          %value_scale_byte0 = view.load %value_scale_view0[0] : view<1xi8> -> i8
          %loaded_key_scale0 = scalar.extui %key_scale_byte0 : i8 to i32
          %loaded_value_scale0 = scalar.extui %value_scale_byte0 : i8 to i32
          %loaded_key_payload1, %loaded_value_payload1, %loaded_key_scale1, %loaded_value_scale1 = scf.if %has_second_fragment -> (vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32) {
            %channel_offset1 = index.cast %channel1 : index to offset
            %data_offset1 = index.add %data_offset_base, %channel_offset1 : offset
            %scale_group_offset1 = index.cast %scale_group1 : index to offset
            %scale_offset1 = index.add %scale_offset_base, %scale_group_offset1 : offset
            %key_payload_view1 = buffer.view %key_storage[%data_offset1] : buffer -> view<8xf8E4M3>
            %value_payload_view1 = buffer.view %value_storage[%data_offset1] : buffer -> view<8xf8E4M3>
            %key_scale_view1 = buffer.view %key_storage[%scale_offset1] : buffer -> view<1xi8>
            %value_scale_view1 = buffer.view %value_storage[%scale_offset1] : buffer -> view<1xi8>
            %second_key_payload = vector.load %key_payload_view1[0] : view<8xf8E4M3> -> vector<8xf8E4M3>
            %second_value_payload = vector.load %value_payload_view1[0] : view<8xf8E4M3> -> vector<8xf8E4M3>
            %key_scale_byte1 = view.load %key_scale_view1[0] : view<1xi8> -> i8
            %value_scale_byte1 = view.load %value_scale_view1[0] : view<1xi8> -> i8
            %second_key_scale = scalar.extui %key_scale_byte1 : i8 to i32
            %second_value_scale = scalar.extui %value_scale_byte1 : i8 to i32
            scf.yield %second_key_payload, %second_value_payload, %second_key_scale, %second_value_scale : vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32
          } else {
            scf.yield %zero_payload, %zero_payload, %zero_scale, %zero_scale : vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32
          }
          scf.yield %loaded_key_payload0, %loaded_value_payload0, %loaded_key_scale0, %loaded_value_scale0, %loaded_key_payload1, %loaded_value_payload1, %loaded_key_scale1, %loaded_value_scale1 : vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32, vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32
        } else {
          scf.yield %zero_payload, %zero_payload, %zero_scale, %zero_scale, %zero_payload, %zero_payload, %zero_scale, %zero_scale : vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32, vector<8xf8E4M3>, vector<8xf8E4M3>, i32, i32
        }
        %next_row_max, %next_row_sum, %next_row_accumulator0, %next_row_accumulator1 = scf.if %valid -> (f32, f32, vector<8xf32>, vector<8xf32>) {
          %key_scale_vector0 = vector.from_elements %key_scale0 : vector<1xi32>
          %value_scale_vector0 = vector.from_elements %value_scale0 : vector<1xi32>
          %key_scale_vector1 = vector.from_elements %key_scale1 : vector<1xi32>
          %value_scale_vector1 = vector.from_elements %value_scale1 : vector<1xi32>
          %key0 = vector.decode %key_payload0 using %schema {scale = %key_scale_vector0 : vector<1xi32>} : vector<8xf8E4M3>, encoding<schema> -> vector<8xf32>
          %value0 = vector.decode %value_payload0 using %schema {scale = %value_scale_vector0 : vector<1xi32>} : vector<8xf8E4M3>, encoding<schema> -> vector<8xf32>
          %key1 = vector.decode %key_payload1 using %schema {scale = %key_scale_vector1 : vector<1xi32>} : vector<8xf8E4M3>, encoding<schema> -> vector<8xf32>
          %value1 = vector.decode %value_payload1 using %schema {scale = %value_scale_vector1 : vector<1xi32>} : vector<8xf8E4M3>, encoding<schema> -> vector<8xf32>
          %partial_score0 = vector.dotf %query_fragment0, %key0, %identity : vector<8xf32>, vector<8xf32>, f32
          %partial_score1 = vector.dotf %query_fragment1, %key1, %identity : vector<8xf32>, vector<8xf32>, f32
          %partial_score = scalar.addf %partial_score0, %partial_score1 : f32
          %dot = kernel.subgroup.reduce<addf> %partial_score : f32
          %score = scalar.mulf %dot, %score_scale : f32
          %updated_max = scalar.maxnumf %row_max, %score : f32
          %old_delta = scalar.subf %row_max, %updated_max : f32
          %score_delta = scalar.subf %score, %updated_max : f32
          %old_scale = scalar.expf<afn> %old_delta : f32
          %weight = scalar.expf<afn> %score_delta : f32
          %rescaled_sum = scalar.mulf<contract> %row_sum, %old_scale : f32
          %updated_sum = scalar.addf<contract> %rescaled_sum, %weight : f32
          %old_scale_vector = vector.splat %old_scale : vector<8xf32>
          %weight_vector = vector.splat %weight : vector<8xf32>
          %rescaled_accumulator0 = vector.mulf<contract> %row_accumulator0, %old_scale_vector : vector<8xf32>
          %weighted_value0 = vector.mulf<contract> %value0, %weight_vector : vector<8xf32>
          %updated_accumulator0 = vector.addf<contract> %rescaled_accumulator0, %weighted_value0 : vector<8xf32>
          %rescaled_accumulator1 = vector.mulf<contract> %row_accumulator1, %old_scale_vector : vector<8xf32>
          %weighted_value1 = vector.mulf<contract> %value1, %weight_vector : vector<8xf32>
          %updated_accumulator1 = vector.addf<contract> %rescaled_accumulator1, %weighted_value1 : vector<8xf32>
          scf.yield %updated_max, %updated_sum, %updated_accumulator0, %updated_accumulator1 : f32, f32, vector<8xf32>, vector<8xf32>
        } else {
          scf.yield %row_max, %row_sum, %row_accumulator0, %row_accumulator1 : f32, f32, vector<8xf32>, vector<8xf32>
        }
        scf.yield %next_row_max, %next_row_sum, %next_row_accumulator0, %next_row_accumulator1 : f32, f32, vector<8xf32>, vector<8xf32>
      }
      scf.yield %rows_max, %rows_sum, %rows_accumulator0, %rows_accumulator1 : f32, f32, vector<8xf32>, vector<8xf32>
    } else {
      scf.yield %page_max, %page_sum, %page_accumulator0, %page_accumulator1 : f32, f32, vector<8xf32>, vector<8xf32>
    }
    scf.yield %next_page_max, %next_page_sum, %next_page_accumulator0, %next_page_accumulator1 : f32, f32, vector<8xf32>, vector<8xf32>
  }
  %nonempty = scalar.cmpf ogt, %denominator, %identity : f32
  %normalized0, %normalized1 = scf.if %nonempty -> (vector<8xf32>, vector<8xf32>) {
    %denominators = vector.splat %denominator : vector<8xf32>
    %result0 = vector.divf %numerator0, %denominators : vector<8xf32>
    %result1 = vector.divf %numerator1, %denominators : vector<8xf32>
    scf.yield %result0, %result1 : vector<8xf32>, vector<8xf32>
  } else {
    scf.yield %initial_accumulator, %initial_accumulator : vector<8xf32>, vector<8xf32>
  }
  %leader = index.cmp eq, %lane, %begin : index
  scf.if %leader {
    view.store %maximum, %state[%instance, %begin] : f32, view<[%instances]x2xf32>
    view.store %denominator, %state[%instance, %row_step] : f32, view<[%instances]x2xf32>
  }
  vector.store %normalized0, %output_view[%instance, %channel0] : vector<8xf32>, view<[%instances]x512xf32>
  scf.if %has_second_fragment {
    vector.store %normalized1, %output_view[%instance, %channel1] : vector<8xf32>, view<[%instances]x512xf32>
  }
  template.return
}

kernel.def @mxfp8_paged_attention_serial(%instance_count: index) {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  kernel.launch.config workgroups(%instance_count, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%instance_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %depth = index.constant 1 : index
  %factor = index.constant 2 : index
  template.apply<@mxfp8_paged_attention>(%instance_count, %lengths, %query, %page_table, %keys, %values, %final_state, %output, %depth, %factor) : (index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, index, index)
  kernel.return
}

kernel.def @mxfp8_paged_attention_pipelined(%instance_count: index) {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  kernel.launch.config workgroups(%instance_count, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%instance_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %depth = index.constant 3 : index
  %factor = index.constant 2 : index
  template.apply<@mxfp8_paged_attention>(%instance_count, %lengths, %query, %page_table, %keys, %values, %final_state, %output, %depth, %factor) : (index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, index, index)
  kernel.return
}

// An independent host oracle decodes raw payload and scale bits, computes QK
// and direct normalized exponentials in f64, then returns f32 state and output.
// Lengths cross page boundaries; the repeating table includes holes, reverse
// physical order, and repeated pages. Different K/V periods distinguish every
// page, row, scale group, and payload fragment.
check.case public @mxfp8_paged_attention_varied {
  %instances = check.param.choice values([1, 4]) name("instances") : index
  %seed = check.param.seed base(8600) count(2) : i64
  %lengths = check.generate.iota offset(1) step(33) : tensor<[%instances]xi32>
  %query = check.generate.random.uniform seed(%seed) range(-0.015625 to 0.015625) : tensor<[%instances]x512xf32>
  %pages = check.generate.iota offset(2) step(-1) period(4) : tensor<[%instances]x64xi32>
  %keys = check.generate.iota offset(112) step(1) period(15) : tensor<3x8448xi8>
  %values = check.generate.iota offset(96) step(1) period(29) : tensor<3x8448xi8>
  %serial_state = check.generate.fill value(-10000.0) : tensor<[%instances]x2xf32>
  %serial_output = check.generate.fill value(-20000.0) : tensor<[%instances]x512xf32>
  %pipeline_state = check.generate.fill value(-30000.0) : tensor<[%instances]x2xf32>
  %pipeline_output = check.generate.fill value(-40000.0) : tensor<[%instances]x512xf32>
  kernel.launch @mxfp8_paged_attention_serial[%instances](%instances, %lengths, %query, %pages, %keys, %values, %serial_state, %serial_output) : [index](index, tensor<[%instances]xi32>, tensor<[%instances]x512xf32>, tensor<[%instances]x64xi32>, tensor<3x8448xi8>, tensor<3x8448xi8>, tensor<[%instances]x2xf32>, tensor<[%instances]x512xf32>)
  kernel.launch @mxfp8_paged_attention_pipelined[%instances](%instances, %lengths, %query, %pages, %keys, %values, %pipeline_state, %pipeline_output) : [index](index, tensor<[%instances]xi32>, tensor<[%instances]x512xf32>, tensor<[%instances]x64xi32>, tensor<3x8448xi8>, tensor<3x8448xi8>, tensor<[%instances]x2xf32>, tensor<[%instances]x512xf32>)
  %expected_state, %expected_output = check.oracle.call<reference.mxfp8_paged_attention> callee(@mxfp8_paged_attention_serial) inputs(%lengths, %query, %pages, %keys, %values) : (tensor<[%instances]xi32>, tensor<[%instances]x512xf32>, tensor<[%instances]x64xi32>, tensor<3x8448xi8>, tensor<3x8448xi8>) -> (tensor<[%instances]x2xf32>, tensor<[%instances]x512xf32>)
  check.expect.close actual(%serial_state) expected(%expected_state) atol(0.01) rtol(0.002) nan(same) : tensor<[%instances]x2xf32>
  check.expect.close actual(%serial_output) expected(%expected_output) atol(0.01) rtol(0.002) nan(same) : tensor<[%instances]x512xf32>
  check.expect.close actual(%pipeline_state) expected(%expected_state) atol(0.01) rtol(0.002) nan(same) : tensor<[%instances]x2xf32>
  check.expect.close actual(%pipeline_output) expected(%expected_output) atol(0.01) rtol(0.002) nan(same) : tensor<[%instances]x512xf32>
  check.expect.close actual(%pipeline_state) expected(%serial_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x2xf32>
  check.expect.close actual(%pipeline_output) expected(%serial_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x512xf32>
  check.return
}

// Only two physical pages exist. The length consumes row zero of page one;
// later table entries point beyond the allocation and must remain untouched.
check.case public @mxfp8_paged_attention_cross_page_tail {
  %instances = check.literal value(1) : index
  %seed = check.literal value(8610) : i64
  %lengths = check.generate.fill value(17) : tensor<1xi32>
  %query = check.generate.random.uniform seed(%seed) range(-0.015625 to 0.015625) : tensor<1x512xf32>
  %pages = check.generate.iota offset(0) step(1) : tensor<1x64xi32>
  %keys = check.generate.iota offset(112) step(1) period(15) : tensor<2x8448xi8>
  %values = check.generate.iota offset(96) step(1) period(29) : tensor<2x8448xi8>
  %serial_state = check.generate.fill value(-10000.0) : tensor<1x2xf32>
  %serial_output = check.generate.fill value(-20000.0) : tensor<1x512xf32>
  %pipeline_state = check.generate.fill value(-30000.0) : tensor<1x2xf32>
  %pipeline_output = check.generate.fill value(-40000.0) : tensor<1x512xf32>
  kernel.launch @mxfp8_paged_attention_serial[%instances](%instances, %lengths, %query, %pages, %keys, %values, %serial_state, %serial_output) : [index](index, tensor<1xi32>, tensor<1x512xf32>, tensor<1x64xi32>, tensor<2x8448xi8>, tensor<2x8448xi8>, tensor<1x2xf32>, tensor<1x512xf32>)
  kernel.launch @mxfp8_paged_attention_pipelined[%instances](%instances, %lengths, %query, %pages, %keys, %values, %pipeline_state, %pipeline_output) : [index](index, tensor<1xi32>, tensor<1x512xf32>, tensor<1x64xi32>, tensor<2x8448xi8>, tensor<2x8448xi8>, tensor<1x2xf32>, tensor<1x512xf32>)
  %expected_state, %expected_output = check.oracle.call<reference.mxfp8_paged_attention> callee(@mxfp8_paged_attention_serial) inputs(%lengths, %query, %pages, %keys, %values) : (tensor<1xi32>, tensor<1x512xf32>, tensor<1x64xi32>, tensor<2x8448xi8>, tensor<2x8448xi8>) -> (tensor<1x2xf32>, tensor<1x512xf32>)
  check.expect.close actual(%serial_state) expected(%expected_state) atol(0.01) rtol(0.002) nan(same) : tensor<1x2xf32>
  check.expect.close actual(%serial_output) expected(%expected_output) atol(0.01) rtol(0.002) nan(same) : tensor<1x512xf32>
  check.expect.close actual(%pipeline_state) expected(%expected_state) atol(0.01) rtol(0.002) nan(same) : tensor<1x2xf32>
  check.expect.close actual(%pipeline_output) expected(%expected_output) atol(0.01) rtol(0.002) nan(same) : tensor<1x512xf32>
  check.return
}

// The first instance is empty; the second traverses a full logical range of
// absent pages. Poisoned backing detects speculative decode or payload reads.
check.case public @mxfp8_paged_attention_empty_and_absent {
  %instances = check.literal value(2) : index
  %lengths = check.generate.iota offset(0) step(1024) : tensor<2xi32>
  %query = check.generate.fill value(1.0) : tensor<2x512xf32>
  %pages = check.generate.fill value(-1) : tensor<2x64xi32>
  %keys = check.generate.fill value(127) : tensor<1x8448xi8>
  %values = check.generate.fill value(127) : tensor<1x8448xi8>
  %serial_state = check.generate.fill value(-10000.0) : tensor<2x2xf32>
  %serial_output = check.generate.fill value(-20000.0) : tensor<2x512xf32>
  %pipeline_state = check.generate.fill value(-30000.0) : tensor<2x2xf32>
  %pipeline_output = check.generate.fill value(-40000.0) : tensor<2x512xf32>
  kernel.launch @mxfp8_paged_attention_serial[%instances](%instances, %lengths, %query, %pages, %keys, %values, %serial_state, %serial_output) : [index](index, tensor<2xi32>, tensor<2x512xf32>, tensor<2x64xi32>, tensor<1x8448xi8>, tensor<1x8448xi8>, tensor<2x2xf32>, tensor<2x512xf32>)
  kernel.launch @mxfp8_paged_attention_pipelined[%instances](%instances, %lengths, %query, %pages, %keys, %values, %pipeline_state, %pipeline_output) : [index](index, tensor<2xi32>, tensor<2x512xf32>, tensor<2x64xi32>, tensor<1x8448xi8>, tensor<1x8448xi8>, tensor<2x2xf32>, tensor<2x512xf32>)
  %expected_state, %expected_output = check.oracle.call<reference.mxfp8_paged_attention> callee(@mxfp8_paged_attention_serial) inputs(%lengths, %query, %pages, %keys, %values) : (tensor<2xi32>, tensor<2x512xf32>, tensor<2x64xi32>, tensor<1x8448xi8>, tensor<1x8448xi8>) -> (tensor<2x2xf32>, tensor<2x512xf32>)
  check.expect.close actual(%serial_state) expected(%expected_state) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xf32>
  check.expect.close actual(%serial_output) expected(%expected_output) atol(0.0) rtol(0.0) nan(same) : tensor<2x512xf32>
  check.expect.close actual(%pipeline_state) expected(%expected_state) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xf32>
  check.expect.close actual(%pipeline_output) expected(%expected_output) atol(0.0) rtol(0.0) nan(same) : tensor<2x512xf32>
  check.return
}

// Timing cases use zero queries and a constant raw cache byte. E4M3FN byte 56
// is 1.0 and E8M0 byte 56 is 2^-71, so every present row has score zero and
// every output channel is exactly 2^-71. Correctness cases above retain varied
// payloads, scales, page identities, and an independent high-precision oracle.
check.case public @mxfp8_paged_attention_serial_n128 {
  %instances = check.param.choice values([1, 16, 256]) name("instances") : index
  %seed = check.literal value(8620) : i64
  %lengths = check.generate.fill value(128) : tensor<[%instances]xi32>
  %query = check.generate.fill value(0.0) : tensor<[%instances]x512xf32>
  %pages = check.generate.random.uniform seed(%seed) range(0 to 255) : tensor<[%instances]x64xi32>
  %keys = check.generate.fill value(56) : tensor<256x8448xi8>
  %values = check.generate.fill value(56) : tensor<256x8448xi8>
  %state = check.generate.fill value(-10000.0) : tensor<[%instances]x2xf32>
  %output = check.generate.fill value(-20000.0) : tensor<[%instances]x512xf32>
  %expected_state = check.generate.iota offset(0.0) step(128.0) period(2) : tensor<[%instances]x2xf32>
  %expected_output = check.generate.fill value(4.2351647362715017e-22) : tensor<[%instances]x512xf32>
  kernel.launch @mxfp8_paged_attention_serial[%instances](%instances, %lengths, %query, %pages, %keys, %values, %state, %output) : [index](index, tensor<[%instances]xi32>, tensor<[%instances]x512xf32>, tensor<[%instances]x64xi32>, tensor<256x8448xi8>, tensor<256x8448xi8>, tensor<[%instances]x2xf32>, tensor<[%instances]x512xf32>)
  check.expect.close actual(%state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x2xf32>
  check.expect.close actual(%output) expected(%expected_output) atol(0.0) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x512xf32>
  check.return
}

check.benchmark<@mxfp8_paged_attention_serial_n128> @mxfp8_paged_attention_serial_n128_i1 {instances = 1}

check.benchmark<@mxfp8_paged_attention_serial_n128> @mxfp8_paged_attention_serial_n128_i16 {instances = 16}

