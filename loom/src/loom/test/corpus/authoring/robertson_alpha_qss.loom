  check.expect.close actual(%output) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<64xf64>
  check.return
}

check.case public @robertson_alpha_qss_wavefront_adaptive_mass_case {
  %max_steps = check.literal value(512) : index
  %t_end = check.literal value(0.000001) : f64
  %dt_initial = check.literal value(0.0000001) : f64
  %pc_tol = check.literal value(0.01) : f64
  %tol_safety = check.literal value(10.0) : f64
  %atol_spec = check.literal value(0.00000001) : f64
  %species_tol = check.literal value(0.01) : f64
  %mass_output = check.generate.fill value(0.0) : tensor<64xf64>
  %accepted_output = check.generate.fill value(0) : tensor<64xi32>
  %rejected_output = check.generate.fill value(0) : tensor<64xi32>
  %expected_mass = check.generate.fill value(1.0) : tensor<64xf64>
  func.call @robertson_alpha_qss_wavefront_adaptive(%max_steps, %t_end, %dt_initial, %pc_tol, %tol_safety, %atol_spec, %species_tol, %mass_output, %accepted_output, %rejected_output) : (index, f64, f64, f64, f64, f64, f64, tensor<64xf64>, tensor<64xi32>, tensor<64xi32>)
  check.expect.close actual(%mass_output) expected(%expected_mass) atol(0.0001) rtol(0.0001) nan(same) : tensor<64xf64>
  check.return
}

