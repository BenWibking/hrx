kernel.decl @immutable_storage_switch() launch(%input_a: buffer, %input_b: buffer, %control: buffer, %scratch: buffer)

check.case public @immutable_storage_switch_0 {
  %a = check.generate.fill value(5) : tensor<1xi32>
  %b = check.generate.fill value(20) : tensor<1xi32>
  %control = check.generate.fill value(0) : tensor<1xi32>
  %scratch = check.generate.fill value(99) : tensor<1xi32>
  kernel.launch @immutable_storage_switch(%a, %b, %control, %scratch) : (tensor<1xi32>, tensor<1xi32>, tensor<1xi32>, tensor<1xi32>)
  %expected_a = check.generate.fill value(5) : tensor<1xi32>
  check.expect.bitwise actual(%a) expected(%expected_a) : tensor<1xi32>
  %expected_b = check.generate.fill value(6) : tensor<1xi32>
  check.expect.bitwise actual(%b) expected(%expected_b) : tensor<1xi32>
  %expected_control = check.generate.fill value(0) : tensor<1xi32>
  check.expect.bitwise actual(%control) expected(%expected_control) : tensor<1xi32>
  %expected_scratch = check.generate.fill value(1) : tensor<1xi32>
  check.expect.bitwise actual(%scratch) expected(%expected_scratch) : tensor<1xi32>
  check.return
}

