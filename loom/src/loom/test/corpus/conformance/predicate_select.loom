// Independent predicate vectors retain each logical element and workitem bit.
// Scalar consumers under divergence must leave inactive output slots intact.
kernel.def @predicate_select() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%width, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%conditions: buffer, %true_input: buffer, %false_input: buffer, %output: buffer) {
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %width = index.constant 64 : index
  %group_offset = index.mul %group, %width : index
  %item = index.add %group_offset, %lane : index
  %input_stride = index.constant 4 : index
  %output_stride = index.constant 8 : index
  %input_position = index.mul %item, %input_stride : index
  %output_position = index.mul %item, %output_stride : index
  %base = index.constant 0 : offset
  %condition_view = buffer.view %conditions[%base] : buffer -> view<16384xi32>
  %true_view = buffer.view %true_input[%base] : buffer -> view<16384xi32>
  %false_view = buffer.view %false_input[%base] : buffer -> view<16384xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<32768xi32>
  %condition_words = vector.load %condition_view[%input_position] : view<16384xi32> -> vector<4xi32>
  %true_words = vector.load %true_view[%input_position] : view<16384xi32> -> vector<4xi32>
  %false_words = vector.load %false_view[%input_position] : view<16384xi32> -> vector<4xi32>
  %threshold = vector.constant 0 : vector<4xi32>
  %mask = vector.cmpi ne, %condition_words, %threshold : vector<4xi32> -> vector<4xi1>
  %true_predicates = vector.cmpi ne, %true_words, %threshold : vector<4xi32> -> vector<4xi1>
  %false_predicates = vector.cmpi ne, %false_words, %threshold : vector<4xi32> -> vector<4xi1>
  %selected = vector.select %mask, %true_predicates, %false_predicates : vector<4xi1>
  %on_true = vector.constant 1362459069 : vector<4xi32>
  %on_false = vector.constant -19088743 : vector<4xi32>
  %payload = vector.select %selected, %on_true, %on_false : vector<4xi32>
  vector.store %payload, %output_view[%output_position] : vector<4xi32>, view<32768xi32>
  %first = vector.extract %selected[0] : vector<4xi1> -> i1
  %last = vector.extract %selected[3] : vector<4xi1> -> i1
  %signed = scalar.extsi %first : i1 to i32
  %unsigned = scalar.extui %last : i1 to i32
  %signed_position = index.add %output_position, %input_stride : index
  %scalar_stride = index.constant 1 : index
  %unsigned_position = index.add %signed_position, %scalar_stride : index
  view.store %signed, %output_view[%signed_position] : i32, view<32768xi32>
  view.store %unsigned, %output_view[%unsigned_position] : i32, view<32768xi32>
  %limit = index.constant 56 : index
  %active = index.cmp slt, %lane, %limit : index
  scf.if %active {
    %middle = vector.extract %selected[2] : vector<4xi1> -> i1
    %middle_value = scalar.extui %middle : i1 to i32
    %middle_position = index.add %unsigned_position, %scalar_stride : index
    view.store %middle_value, %output_view[%middle_position] : i32, view<32768xi32>
  }
  kernel.return
}
