kernel.decl @aligned_byte_increment() launch(%input: buffer, %output: buffer)

kernel.decl @byte_selected_storage() launch(%input_a: buffer, %input_b: buffer, %control: buffer)

check.case public @aligned_byte_increment_result {
  %input = check.generate.fill value(-1) : tensor<4xi8>
  %output = check.generate.fill value(0) : tensor<1xi32>
  kernel.launch @aligned_byte_increment(%input, %output) : (tensor<4xi8>, tensor<1xi32>)
  %expected = check.generate.fill value(256) : tensor<1xi32>
  check.expect.bitwise actual(%output) expected(%expected) : tensor<1xi32>
  check.return
}

check.case public @byte_selected_storage_reads_first {
  %a = check.generate.fill value(1) : tensor<1xi32>
  %b = check.generate.fill value(2) : tensor<1xi32>
  %control = check.generate.fill value(0) : tensor<1xi32>
  kernel.launch @byte_selected_storage(%a, %b, %control) : (tensor<1xi32>, tensor<1xi32>, tensor<1xi32>)
  %expected_a = check.generate.fill value(1) : tensor<1xi32>
  check.expect.bitwise actual(%a) expected(%expected_a) : tensor<1xi32>
  %expected_b = check.generate.fill value(2) : tensor<1xi32>
  check.expect.bitwise actual(%b) expected(%expected_b) : tensor<1xi32>
  %expected_control = check.generate.fill value(0) : tensor<1xi32>
  check.expect.bitwise actual(%control) expected(%expected_control) : tensor<1xi32>
  check.return
}

check.case public @byte_selected_storage_reads_second {
  %a = check.generate.fill value(1) : tensor<1xi32>
  %b = check.generate.fill value(2) : tensor<1xi32>
  %control = check.generate.fill value(1) : tensor<1xi32>
  kernel.launch @byte_selected_storage(%a, %b, %control) : (tensor<1xi32>, tensor<1xi32>, tensor<1xi32>)
  %expected_a = check.generate.fill value(3) : tensor<1xi32>
  check.expect.bitwise actual(%a) expected(%expected_a) : tensor<1xi32>
  %expected_b = check.generate.fill value(2) : tensor<1xi32>
  check.expect.bitwise actual(%b) expected(%expected_b) : tensor<1xi32>
  %expected_control = check.generate.fill value(1) : tensor<1xi32>
  check.expect.bitwise actual(%control) expected(%expected_control) : tensor<1xi32>
  check.return
}
