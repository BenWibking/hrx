  %a = check.generate.fill value(1) : tensor<1xi32>
  %b = check.generate.fill value(2) : tensor<1xi32>
  kernel.launch @rotating_storage(%a, %b) : (tensor<1xi32>, tensor<1xi32>)
  %expected_a = check.generate.fill value(3) : tensor<1xi32>
  check.expect.bitwise actual(%a) expected(%expected_a) : tensor<1xi32>
  %expected_b = check.generate.fill value(4) : tensor<1xi32>
  check.expect.bitwise actual(%b) expected(%expected_b) : tensor<1xi32>
  check.return
}

