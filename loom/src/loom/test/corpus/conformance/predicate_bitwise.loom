// Independent predicates exercise every logical element and workitem mask bit.
// Inactive scalar stores and each result group retain their output guards.
kernel.def @predicate_bitwise() {
  %unit = index.constant 1 : index
  %groups = index.constant 4 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%lhs_input: buffer, %rhs_input: buffer, %output: buffer) {
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %width = index.constant 64 : index
  %group_offset = index.mul %group, %width : index
  %item = index.add %group_offset, %lane : index
  %input_stride = index.constant 4 : index
  %output_stride = index.constant 24 : index
  %input_position = index.mul %item, %input_stride : index
  %output_position = index.mul %item, %output_stride : index
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_input[%base] : buffer -> view<1024xi32>
  %rhs_view = buffer.view %rhs_input[%base] : buffer -> view<1024xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<6144xi32>
  %lhs_words = vector.load %lhs_view[%input_position] : view<1024xi32> -> vector<4xi32>
  %rhs_words = vector.load %rhs_view[%input_position] : view<1024xi32> -> vector<4xi32>
  %threshold = vector.constant 0 : vector<4xi32>
  %lhs = vector.cmpi ne, %lhs_words, %threshold : vector<4xi32> -> vector<4xi1>
  %rhs = vector.cmpi ne, %rhs_words, %threshold : vector<4xi32> -> vector<4xi1>
  %on_true = vector.constant 1362459069 : vector<4xi32>
  %on_false = vector.constant -19088743 : vector<4xi32>
  %limit = index.constant 56 : index
  %active = index.cmp slt, %lane, %limit : index
  %and_result = vector.andi %lhs, %rhs : vector<4xi1>
  %and_payload = vector.select %and_result, %on_true, %on_false : vector<4xi32>
  %and_payload_offset = index.constant 0 : index
  %and_payload_position = index.add %output_position, %and_payload_offset : index
  %and_signed_offset = index.constant 4 : index
  %and_signed_position = index.add %output_position, %and_signed_offset : index
  %and_unsigned_offset = index.constant 5 : index
  %and_unsigned_position = index.add %output_position, %and_unsigned_offset : index
  %and_middle_offset = index.constant 6 : index
  %and_middle_position = index.add %output_position, %and_middle_offset : index
  vector.store %and_payload, %output_view[%and_payload_position] : vector<4xi32>, view<6144xi32>
  %and_first = vector.extract %and_result[0] : vector<4xi1> -> i1
  %and_last = vector.extract %and_result[3] : vector<4xi1> -> i1
  %and_signed = scalar.extsi %and_first : i1 to i32
  %and_unsigned = scalar.extui %and_last : i1 to i32
  view.store %and_signed, %output_view[%and_signed_position] : i32, view<6144xi32>
  view.store %and_unsigned, %output_view[%and_unsigned_position] : i32, view<6144xi32>
  scf.if %active {
    %and_middle = vector.extract %and_result[2] : vector<4xi1> -> i1
    %and_middle_value = scalar.extui %and_middle : i1 to i32
    view.store %and_middle_value, %output_view[%and_middle_position] : i32, view<6144xi32>
  }
  %or_result = vector.ori %lhs, %rhs : vector<4xi1>
  %or_payload = vector.select %or_result, %on_true, %on_false : vector<4xi32>
  %or_payload_offset = index.constant 8 : index
  %or_payload_position = index.add %output_position, %or_payload_offset : index
  %or_signed_offset = index.constant 12 : index
  %or_signed_position = index.add %output_position, %or_signed_offset : index
  %or_unsigned_offset = index.constant 13 : index
  %or_unsigned_position = index.add %output_position, %or_unsigned_offset : index
  %or_middle_offset = index.constant 14 : index
  %or_middle_position = index.add %output_position, %or_middle_offset : index
  vector.store %or_payload, %output_view[%or_payload_position] : vector<4xi32>, view<6144xi32>
  %or_first = vector.extract %or_result[0] : vector<4xi1> -> i1
  %or_last = vector.extract %or_result[3] : vector<4xi1> -> i1
  %or_signed = scalar.extsi %or_first : i1 to i32
  %or_unsigned = scalar.extui %or_last : i1 to i32
  view.store %or_signed, %output_view[%or_signed_position] : i32, view<6144xi32>
  view.store %or_unsigned, %output_view[%or_unsigned_position] : i32, view<6144xi32>
  scf.if %active {
    %or_middle = vector.extract %or_result[2] : vector<4xi1> -> i1
    %or_middle_value = scalar.extui %or_middle : i1 to i32
    view.store %or_middle_value, %output_view[%or_middle_position] : i32, view<6144xi32>
  }
  %xor_result = vector.xori %lhs, %rhs : vector<4xi1>
  %xor_payload = vector.select %xor_result, %on_true, %on_false : vector<4xi32>
  %xor_payload_offset = index.constant 16 : index
  %xor_payload_position = index.add %output_position, %xor_payload_offset : index
  %xor_signed_offset = index.constant 20 : index
  %xor_signed_position = index.add %output_position, %xor_signed_offset : index
  %xor_unsigned_offset = index.constant 21 : index
  %xor_unsigned_position = index.add %output_position, %xor_unsigned_offset : index
  %xor_middle_offset = index.constant 22 : index
  %xor_middle_position = index.add %output_position, %xor_middle_offset : index
  vector.store %xor_payload, %output_view[%xor_payload_position] : vector<4xi32>, view<6144xi32>
  %xor_first = vector.extract %xor_result[0] : vector<4xi1> -> i1
  %xor_last = vector.extract %xor_result[3] : vector<4xi1> -> i1
  %xor_signed = scalar.extsi %xor_first : i1 to i32
  %xor_unsigned = scalar.extui %xor_last : i1 to i32
  view.store %xor_signed, %output_view[%xor_signed_position] : i32, view<6144xi32>
  view.store %xor_unsigned, %output_view[%xor_unsigned_position] : i32, view<6144xi32>
  scf.if %active {
    %xor_middle = vector.extract %xor_result[2] : vector<4xi1> -> i1
    %xor_middle_value = scalar.extui %xor_middle : i1 to i32
    view.store %xor_middle_value, %output_view[%xor_middle_position] : i32, view<6144xi32>
  }
  kernel.return
}
