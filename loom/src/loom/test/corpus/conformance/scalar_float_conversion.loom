// Loaded lanes and uniform arguments cross the same floating-point width
// boundary. Separate output rows preserve both results for exact checks.
kernel.def @scalar_f32_to_f64() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %uniform: f32, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<2x64xf64>
  %input_value = view.load %input_view[%lane] : view<64xf32> -> f32
  %converted = scalar.extf %input_value : f32 to f64
  %converted_uniform = scalar.extf %uniform : f32 to f64
  view.store %converted, %output_view[0, %lane] : f64, view<2x64xf64>
  view.store %converted_uniform, %output_view[1, %lane] : f64, view<2x64xf64>
  kernel.return
}

kernel.def @scalar_f64_to_f32() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %uniform: f64, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xf64>
  %output_view = buffer.view %output[%base] : buffer -> view<2x64xf32>
  %input_value = view.load %input_view[%lane] : view<64xf64> -> f64
  %converted = scalar.fptrunc %input_value : f64 to f32
  %converted_uniform = scalar.fptrunc %uniform : f64 to f32
  view.store %converted, %output_view[0, %lane] : f32, view<2x64xf32>
  view.store %converted_uniform, %output_view[1, %lane] : f32, view<2x64xf32>
  kernel.return
}
