// The oracle computes one scalar recurrence at a time, independently of vector
// formation, broadcast selection, and loop-carried vector legalization.
func.def @scalar_scale_f16(%input: buffer, %factor_buffer: buffer, %output: buffer, %count: index) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<9xf16>
  %factors = buffer.view %factor_buffer[%base] : buffer -> view<1xf16>
  %results = buffer.view %output[%base] : buffer -> view<9xf16>
  %factor = view.load %factors[0] : view<1xf16> -> f16
  %replacement = scalar.constant 2.0 : f16
  view.store %replacement, %factors[0] : f16, view<1xf16>
  %begin = index.constant 0 : index
  %end = index.constant 9 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %initial = view.load %values[%lane] : view<9xf16> -> f16
    %result = scf.for %iteration = [%begin to %count step %step](%value = %initial : f16) -> (f16) {
      %next = scalar.mulf %value, %factor : f16
      scf.yield %next : f16
    }
    view.store %result, %results[%lane] : f16, view<9xf16>
  }
  func.return
}

