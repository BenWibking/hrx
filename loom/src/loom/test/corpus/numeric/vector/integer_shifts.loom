// Vector shifts preserve packed execution across every integer width. Each
// subject spans three complete SIMD128 packets and one maximal partial tail;
// scalar loops provide independent oracles for uniform and lane-varying counts
// in all three directions.

func.def @vector_i8_shifts(%input: buffer, %count_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values_view = buffer.view %input[%base] : buffer -> view<63xi8>
  %counts_view = buffer.view %count_input[%base] : buffer -> view<63xi8>
  %results = buffer.view %output[%base] : buffer -> view<6x63xi8>
  %values = vector.load %values_view[0] : view<63xi8> -> vector<63xi8>
  %raw_counts = vector.load %counts_view[0] : view<63xi8> -> vector<63xi8>
  %count_mask = vector.constant 7 : vector<63xi8>
  %counts = vector.andi %raw_counts, %count_mask : vector<63xi8>
  %left_count = vector.constant 1 : vector<63xi8>
  %logical_count = vector.constant 7 : vector<63xi8>
  %signed_count = vector.constant 4 : vector<63xi8>
  %uniform_left = vector.shli %values, %left_count : vector<63xi8>
  %uniform_logical = vector.shrui %values, %logical_count : vector<63xi8>
  %uniform_signed = vector.shrsi %values, %signed_count : vector<63xi8>
  %varying_left = vector.shli %values, %counts : vector<63xi8>
  %varying_logical = vector.shrui %values, %counts : vector<63xi8>
  %varying_signed = vector.shrsi %values, %counts : vector<63xi8>
  vector.store %uniform_left, %results[0, 0] : vector<63xi8>, view<6x63xi8>
  vector.store %uniform_logical, %results[1, 0] : vector<63xi8>, view<6x63xi8>
  vector.store %uniform_signed, %results[2, 0] : vector<63xi8>, view<6x63xi8>
  vector.store %varying_left, %results[3, 0] : vector<63xi8>, view<6x63xi8>
  vector.store %varying_logical, %results[4, 0] : vector<63xi8>, view<6x63xi8>
  vector.store %varying_signed, %results[5, 0] : vector<63xi8>, view<6x63xi8>
  func.return
}

func.def @vector_i8_shifts_oracle(%input: buffer, %count_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 63 : index
  %step = index.constant 1 : index
  %values = buffer.view %input[%base] : buffer -> view<63xi8>
  %raw_counts = buffer.view %count_input[%base] : buffer -> view<63xi8>
  %results = buffer.view %output[%base] : buffer -> view<6x63xi8>
  %count_mask = scalar.constant 7 : i8
  %left_count = scalar.constant 1 : i8
  %logical_count = scalar.constant 7 : i8
  %signed_count = scalar.constant 4 : i8
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %values[%i] : view<63xi8> -> i8
    %raw_count = view.load %raw_counts[%i] : view<63xi8> -> i8
    %count = scalar.andi %raw_count, %count_mask : i8
    %uniform_left = scalar.shli %value, %left_count : i8
    %uniform_logical = scalar.shrui %value, %logical_count : i8
    %uniform_signed = scalar.shrsi %value, %signed_count : i8
    %varying_left = scalar.shli %value, %count : i8
    %varying_logical = scalar.shrui %value, %count : i8
    %varying_signed = scalar.shrsi %value, %count : i8
    view.store %uniform_left, %results[0, %i] : i8, view<6x63xi8>
    view.store %uniform_logical, %results[1, %i] : i8, view<6x63xi8>
    view.store %uniform_signed, %results[2, %i] : i8, view<6x63xi8>
    view.store %varying_left, %results[3, %i] : i8, view<6x63xi8>
    view.store %varying_logical, %results[4, %i] : i8, view<6x63xi8>
    view.store %varying_signed, %results[5, %i] : i8, view<6x63xi8>
  }
  func.return
}

check.scenario @vector_i8_shift_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(85) period(4) : tensor<63xi8>
    %counts = check.generate.iota offset(0) step(1) : tensor<63xi8>
    %output = check.generate.fill value(91) : tensor<378xi8>
    check.compare<@vector_i8_shifts, @vector_i8_shifts_oracle>(%input, %counts, %output) : (tensor<63xi8>, tensor<63xi8>, tensor<378xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<378xi8>
    }
  }
  check.return
}

