check.scenario @vector_i16_shift_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(21845) period(4) : tensor<31xi16>
    %counts = check.generate.iota offset(0) step(1) : tensor<31xi16>
    %output = check.generate.fill value(-12345) : tensor<186xi16>
    check.compare<@vector_i16_shifts, @vector_i16_shifts_oracle>(%input, %counts, %output) : (tensor<31xi16>, tensor<31xi16>, tensor<186xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<186xi16>
    }
  }
  check.return
}

