  check.return
}

func.def public @f16_signed_bits(%input: f32) -> (i32) {
  %narrow = scalar.fptrunc %input : f32 to f16
  %bits = scalar.bitcast %narrow : f16 to i16
  %result = scalar.extsi %bits : i16 to i32
  func.return %result : i32
}

check.case @f16_signed_bits_positive {
  %input = check.literal value(1.0009765625) : f32
  %actual = func.call @f16_signed_bits(%input) : (f32) -> (i32)
  %expected = check.literal value(15361) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

check.case @f16_signed_bits_negative {
  %input = check.literal value(-1.0009765625) : f32
  %actual = func.call @f16_signed_bits(%input) : (f32) -> (i32)
  %expected = check.literal value(-17407) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

