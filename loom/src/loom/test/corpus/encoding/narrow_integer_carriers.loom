func.def public @f8e4m3_signed_bits(%input: f32) -> (i32) {
  %narrow = scalar.fptrunc %input : f32 to f8E4M3
  %bits = scalar.bitcast %narrow : f8E4M3 to i8
  %result = scalar.extsi %bits : i8 to i32
  func.return %result : i32
}

check.case @f8e4m3_signed_bits_positive {
  %input = check.literal value(1.125) : f32
  %actual = func.call @f8e4m3_signed_bits(%input) : (f32) -> (i32)
  %expected = check.literal value(57) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

check.case @f8e4m3_signed_bits_negative_zero {
  %input = check.literal value(-0.0) : f32
  %actual = func.call @f8e4m3_signed_bits(%input) : (f32) -> (i32)
  %expected = check.literal value(-128) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

