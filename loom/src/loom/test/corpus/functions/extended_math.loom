// Baseline approximate transcendental and number-preferring extrema behavior.
// Baseline SPIR-V permits implementation-selected subnormal handling, so this
// corpus stays in the normal range and leaves preservation to target profiles
// that advertise an explicit floating-point environment.

func.def public @extended_math_scalars(%input: f32) -> (f32, f32, f32, f32) {
  %exp = scalar.expf<afn> %input : f32
  %log = scalar.logf<afn> %input : f32
  %exp2 = scalar.exp2f<afn> %input : f32
  %log2 = scalar.log2f<afn> %input : f32
  func.return %exp, %log, %exp2, %log2 : f32, f32, f32, f32
}

check.case @extended_math_scalars_normal {
  %input = check.literal value(2.0) : f32
  %exp, %log, %exp2, %log2 = func.call @extended_math_scalars(%input) : (f32) -> (f32, f32, f32, f32)
  %expected_exp = check.literal value(7.3890560989306504) : f32
  %expected_log = check.literal value(0.69314718055994529) : f32
  %expected_exp2 = check.literal value(4.0) : f32
  %expected_log2 = check.literal value(1.0) : f32
  check.expect.close actual(%exp) expected(%expected_exp) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : f32
  check.expect.close actual(%log) expected(%expected_log) atol(4.76837158203125e-07) rtol(0.0) nan(same) : f32
  check.expect.close actual(%exp2) expected(%expected_exp2) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : f32
  check.expect.close actual(%log2) expected(%expected_log2) atol(4.76837158203125e-07) rtol(0.0) nan(same) : f32
  check.return
}

check.case @extended_math_scalars_negative_domain {
  %input = check.literal value(-1.0) : f32
  %exp, %log, %exp2, %log2 = func.call @extended_math_scalars(%input) : (f32) -> (f32, f32, f32, f32)
  %expected_exp = check.literal value(0.36787944117144233) : f32
  %expected_exp2 = check.literal value(0.5) : f32
  %expected_nan = check.literal value(nan) : f32
  check.expect.close actual(%exp) expected(%expected_exp) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : f32
  check.expect.close actual(%log) expected(%expected_nan) atol(0.0) rtol(0.0) nan(same) : f32
  check.expect.equal actual(%exp2) expected(%expected_exp2) : f32
  check.expect.close actual(%log2) expected(%expected_nan) atol(0.0) rtol(0.0) nan(same) : f32
  check.return
}

func.def public @extended_math_scalar_observations(%input_bits: i32) -> (i32, i32, i32, i32, i1, i1, i1, i1) {
  %input = scalar.bitcast %input_bits : i32 to f32
  %exp = scalar.expf<afn> %input : f32
  %log = scalar.logf<afn> %input : f32
  %exp2 = scalar.exp2f<afn> %input : f32
  %log2 = scalar.log2f<afn> %input : f32
  %exp_bits = scalar.bitcast %exp : f32 to i32
  %log_bits = scalar.bitcast %log : f32 to i32
  %exp2_bits = scalar.bitcast %exp2 : f32 to i32
  %log2_bits = scalar.bitcast %log2 : f32 to i32
  %exp_is_nan = scalar.isnanf %exp : f32
  %log_is_nan = scalar.isnanf %log : f32
  %exp2_is_nan = scalar.isnanf %exp2 : f32
  %log2_is_nan = scalar.isnanf %log2 : f32
  func.return %exp_bits, %log_bits, %exp2_bits, %log2_bits, %exp_is_nan, %log_is_nan, %exp2_is_nan, %log2_is_nan : i32, i32, i32, i32, i1, i1, i1, i1
}

check.case @extended_math_scalar_signed_zeros {
  %input = check.param.choice values([0, -2147483648]) : i32
  %exp, %log, %exp2, %log2, %exp_nan, %log_nan, %exp2_nan, %log2_nan = func.call @extended_math_scalar_observations(%input) : (i32) -> (i32, i32, i32, i32, i1, i1, i1, i1)
  %one = check.literal value(1065353216) : i32
  %negative_infinity = check.literal value(-8388608) : i32
  %false = check.literal value(false) : i1
  check.expect.equal actual(%exp) expected(%one) : i32
  check.expect.equal actual(%log) expected(%negative_infinity) : i32
  check.expect.equal actual(%exp2) expected(%one) : i32
  check.expect.equal actual(%log2) expected(%negative_infinity) : i32
  check.expect.equal actual(%exp_nan) expected(%false) : i1
  check.expect.equal actual(%log_nan) expected(%false) : i1
  check.expect.equal actual(%exp2_nan) expected(%false) : i1
  check.expect.equal actual(%log2_nan) expected(%false) : i1
  check.return
}

check.case @extended_math_scalar_positive_infinity {
  %input = check.literal value(2139095040) : i32
  %exp, %log, %exp2, %log2, %exp_nan, %log_nan, %exp2_nan, %log2_nan = func.call @extended_math_scalar_observations(%input) : (i32) -> (i32, i32, i32, i32, i1, i1, i1, i1)
  %false = check.literal value(false) : i1
  check.expect.equal actual(%exp) expected(%input) : i32
  check.expect.equal actual(%log) expected(%input) : i32
  check.expect.equal actual(%exp2) expected(%input) : i32
  check.expect.equal actual(%log2) expected(%input) : i32
  check.expect.equal actual(%exp_nan) expected(%false) : i1
  check.expect.equal actual(%log_nan) expected(%false) : i1
  check.expect.equal actual(%exp2_nan) expected(%false) : i1
  check.expect.equal actual(%log2_nan) expected(%false) : i1
  check.return
}

check.case @extended_math_scalar_negative_infinity {
  %input = check.literal value(-8388608) : i32
  %exp, %log, %exp2, %log2, %exp_nan, %log_nan, %exp2_nan, %log2_nan = func.call @extended_math_scalar_observations(%input) : (i32) -> (i32, i32, i32, i32, i1, i1, i1, i1)
  %zero = check.literal value(0) : i32
  %false = check.literal value(false) : i1
  %true = check.literal value(true) : i1
  check.expect.equal actual(%exp) expected(%zero) : i32
  check.expect.equal actual(%exp2) expected(%zero) : i32
  check.expect.equal actual(%exp_nan) expected(%false) : i1
  check.expect.equal actual(%log_nan) expected(%true) : i1
  check.expect.equal actual(%exp2_nan) expected(%false) : i1
  check.expect.equal actual(%log2_nan) expected(%true) : i1
  check.return
}

check.case @extended_math_scalar_nan {
  %input = check.param.choice values([2143289344, -4194304, 2139095041]) : i32
  %exp, %log, %exp2, %log2, %exp_nan, %log_nan, %exp2_nan, %log2_nan = func.call @extended_math_scalar_observations(%input) : (i32) -> (i32, i32, i32, i32, i1, i1, i1, i1)
  %true = check.literal value(true) : i1
  check.expect.equal actual(%exp_nan) expected(%true) : i1
  check.expect.equal actual(%log_nan) expected(%true) : i1
  check.expect.equal actual(%exp2_nan) expected(%true) : i1
  check.expect.equal actual(%log2_nan) expected(%true) : i1
  check.return
}

func.def public @extended_math_vectors(%first: f32, %second: f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
  %values = vector.from_elements %first, %second : vector<2xf32>
  %exp = vector.expf<afn> %values : vector<2xf32>
  %log = vector.logf<afn> %values : vector<2xf32>
  %exp2 = vector.exp2f<afn> %values : vector<2xf32>
  %log2 = vector.log2f<afn> %values : vector<2xf32>
  %exp_first = vector.extract %exp[0] : vector<2xf32> -> f32
  %exp_second = vector.extract %exp[1] : vector<2xf32> -> f32
  %log_first = vector.extract %log[0] : vector<2xf32> -> f32
  %log_second = vector.extract %log[1] : vector<2xf32> -> f32
  %exp2_first = vector.extract %exp2[0] : vector<2xf32> -> f32
  %exp2_second = vector.extract %exp2[1] : vector<2xf32> -> f32
  %log2_first = vector.extract %log2[0] : vector<2xf32> -> f32
  %log2_second = vector.extract %log2[1] : vector<2xf32> -> f32
  func.return %exp_first, %exp_second, %log_first, %log_second, %exp2_first, %exp2_second, %log2_first, %log2_second : f32, f32, f32, f32, f32, f32, f32, f32
}

check.case @extended_math_vectors_independent_lanes {
  %first = check.literal value(0.5) : f32
  %second = check.literal value(2.0) : f32
  %exp_first, %exp_second, %log_first, %log_second, %exp2_first, %exp2_second, %log2_first, %log2_second = func.call @extended_math_vectors(%first, %second) : (f32, f32) -> (f32, f32, f32, f32, f32, f32, f32, f32)
  %expected_exp_first = check.literal value(1.6487212707001282) : f32
  %expected_exp_second = check.literal value(7.3890560989306504) : f32
  %expected_log_first = check.literal value(-0.69314718055994529) : f32
  %expected_log_second = check.literal value(0.69314718055994529) : f32
  %expected_exp2_first = check.literal value(1.4142135623730951) : f32
  %expected_exp2_second = check.literal value(4.0) : f32
  %expected_log2_first = check.literal value(-1.0) : f32
  %expected_log2_second = check.literal value(1.0) : f32
  check.expect.close actual(%exp_first) expected(%expected_exp_first) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : f32
  check.expect.close actual(%exp_second) expected(%expected_exp_second) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : f32
  check.expect.close actual(%log_first) expected(%expected_log_first) atol(4.76837158203125e-07) rtol(0.0) nan(same) : f32
  check.expect.close actual(%log_second) expected(%expected_log_second) atol(4.76837158203125e-07) rtol(0.0) nan(same) : f32
  check.expect.close actual(%exp2_first) expected(%expected_exp2_first) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : f32
  check.expect.close actual(%exp2_second) expected(%expected_exp2_second) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : f32
  check.expect.close actual(%log2_first) expected(%expected_log2_first) atol(4.76837158203125e-07) rtol(0.0) nan(same) : f32
  check.expect.close actual(%log2_second) expected(%expected_log2_second) atol(4.76837158203125e-07) rtol(0.0) nan(same) : f32
  check.return
}

func.def public @extended_math_number_extrema(%lhs_bits: i32, %rhs_bits: i32) -> (f32, f32) {
  %lhs = scalar.bitcast %lhs_bits : i32 to f32
  %rhs = scalar.bitcast %rhs_bits : i32 to f32
  %min = scalar.minnumf<nsz> %lhs, %rhs : f32
  %max = scalar.maxnumf<nsz> %lhs, %rhs : f32
  func.return %min, %max : f32, f32
}

check.case @extended_math_number_extrema_finite {
  %lhs = check.literal value(-1082130432) : i32
  %rhs = check.literal value(1073741824) : i32
  %min, %max = func.call @extended_math_number_extrema(%lhs, %rhs) : (i32, i32) -> (f32, f32)
  %expected_min = check.literal value(-1.0) : f32
  %expected_max = check.literal value(2.0) : f32
  check.expect.equal actual(%min) expected(%expected_min) : f32
  check.expect.equal actual(%max) expected(%expected_max) : f32
  check.return
}

check.case @extended_math_number_extrema_nan_selection {
  %nan = check.literal value(2143289344) : i32
  %one = check.literal value(1065353216) : i32
  %lhs_min, %lhs_max = func.call @extended_math_number_extrema(%nan, %one) : (i32, i32) -> (f32, f32)
  %rhs_min, %rhs_max = func.call @extended_math_number_extrema(%one, %nan) : (i32, i32) -> (f32, f32)
  %expected = check.literal value(1.0) : f32
  check.expect.equal actual(%lhs_min) expected(%expected) : f32
  check.expect.equal actual(%lhs_max) expected(%expected) : f32
  check.expect.equal actual(%rhs_min) expected(%expected) : f32
  check.expect.equal actual(%rhs_max) expected(%expected) : f32
  check.return
}

check.case @extended_math_number_extrema_both_nan {
  %nan = check.literal value(2143289344) : i32
  %min, %max = func.call @extended_math_number_extrema(%nan, %nan) : (i32, i32) -> (f32, f32)
  %expected = check.literal value(nan) : f32
  check.expect.close actual(%min) expected(%expected) atol(0.0) rtol(0.0) nan(same) : f32
  check.expect.close actual(%max) expected(%expected) atol(0.0) rtol(0.0) nan(same) : f32
  check.return
}

func.def public @extended_math_vector_extrema(%nan_bits: i32) -> (f32, f32, f32, f32) {
  %nan = scalar.bitcast %nan_bits : i32 to f32
  %finite = scalar.constant 1.0 : f32
  %upper = scalar.constant 2.0 : f32
  %lower = scalar.constant -3.0 : f32
  %lhs = vector.from_elements %nan, %upper : vector<2xf32>
  %rhs = vector.from_elements %finite, %lower : vector<2xf32>
  %min = vector.minnumf<nsz> %lhs, %rhs : vector<2xf32>
  %max = vector.maxnumf<nsz> %lhs, %rhs : vector<2xf32>
  %min_first = vector.extract %min[0] : vector<2xf32> -> f32
  %min_second = vector.extract %min[1] : vector<2xf32> -> f32
  %max_first = vector.extract %max[0] : vector<2xf32> -> f32
  %max_second = vector.extract %max[1] : vector<2xf32> -> f32
  func.return %min_first, %min_second, %max_first, %max_second : f32, f32, f32, f32
}

check.case @extended_math_vector_extrema_independent_lanes {
  %nan = check.literal value(2143289344) : i32
  %min_first, %min_second, %max_first, %max_second = func.call @extended_math_vector_extrema(%nan) : (i32) -> (f32, f32, f32, f32)
  %one = check.literal value(1.0) : f32
  %negative_three = check.literal value(-3.0) : f32
  %two = check.literal value(2.0) : f32
  check.expect.equal actual(%min_first) expected(%one) : f32
  check.expect.equal actual(%min_second) expected(%negative_three) : f32
  check.expect.equal actual(%max_first) expected(%one) : f32
  check.expect.equal actual(%max_second) expected(%two) : f32
  check.return
}
