// Serially reduces the complete input span and broadcasts both integer and
// floating-point sums. The target kernels exercise partial workgroup trees;
// the oracle derives the logical extent from the invocation buffers.
func.def @workgroup_reduce_partial_oracle(%input: buffer, %integer_output: buffer, %float_output: buffer) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 0, 9223372036854775807)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %element_bytes = index.constant 4 : index
  %element_count = index.div %input_bytes, %element_bytes : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<[%element_count]xi32>
  %integer_view = buffer.view %integer_output[%base] : buffer -> view<[%element_count]xi32>
  %float_view = buffer.view %float_output[%base] : buffer -> view<[%element_count]xf32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %zero_integer = scalar.constant 0 : i32
  %zero_float = scalar.constant 0.0 : f32
  %integer_sum, %float_sum = scf.for %position = [%begin to %element_count step %step](%integer_accumulator = %zero_integer : i32, %float_accumulator = %zero_float : f32) -> (i32, f32) {
    %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807)] : index
    %value = view.load %input_view[%bounded_position] : view<[%element_count]xi32> -> i32
    %float_value = scalar.sitofp %value : i32 to f32
    %next_integer = scalar.addi %integer_accumulator, %value : i32
    %next_float = scalar.addf %float_accumulator, %float_value : f32
    scf.yield %next_integer, %next_float : i32, f32
  }
  scf.for %position = [%begin to %element_count step %step] {
    %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807)] : index
    view.store %integer_sum, %integer_view[%bounded_position] : i32, view<[%element_count]xi32>
    view.store %float_sum, %float_view[%bounded_position] : f32, view<[%element_count]xf32>
  }
  func.return
}

// Every workitem observes the sum, including lanes in a short tail subgroup.
// Adjacent sizes exercise tails on either side of replicated-tree capacity.
kernel.def @workgroup_reduce_partial_33() {
  %unit = index.constant 1 : index
  %size = index.constant 33 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %integer_output: buffer, %float_output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %input_view = buffer.view %input[%start] : buffer -> view<33xi32>
  %integer_view = buffer.view %integer_output[%start] : buffer -> view<33xi32>
  %float_view = buffer.view %float_output[%start] : buffer -> view<33xf32>
  %value = view.load %input_view[%tid] : view<33xi32> -> i32
  %float_value = scalar.sitofp %value : i32 to f32
  %integer_sum = kernel.workgroup.reduce<addi> %value : i32
  %float_sum = kernel.workgroup.reduce<addf> %float_value : f32
  view.store %integer_sum, %integer_view[%tid] : i32, view<33xi32>
  view.store %float_sum, %float_view[%tid] : f32, view<33xf32>
  kernel.return
}

check.scenario @workgroup_reduce_partial_33_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1) step(1) : tensor<33xi32>
    %integer_output = check.generate.fill value(-1) : tensor<33xi32>
    %float_output = check.generate.fill value(-1.0) : tensor<33xf32>
    check.compare<@workgroup_reduce_partial_33, @workgroup_reduce_partial_oracle>(%input, %integer_output, %float_output) : (tensor<33xi32>, tensor<33xi32>, tensor<33xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<33xi32>
      check.expect.bitwise actual(%integer_output) expected(%integer_output) : tensor<33xi32>
      check.expect.bitwise actual(%float_output) expected(%float_output) : tensor<33xf32>
    }
  }
  check.return
}

