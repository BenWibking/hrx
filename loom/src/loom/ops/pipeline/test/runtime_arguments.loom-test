// RUN: with-checks pass scf-to-cfg,ownership-lifetime

// The arithmetic leaf borrows payloads; it has no channel capability.
func.decl @add_partial(%partial: view<256xf32>, %accumulator: view<256xf32>)

func.def noinline @accumulate(%partials: channel<tile<256xf32>>, %write: write<tile<256xf32>>, %accumulator: view<256xf32>) -> (write<tile<256xf32>>) {
  %read, %partial = channel.acquire %partials : channel<tile<256xf32>> -> (read<tile<256xf32>>, view<256xf32>)
  func.call @add_partial(%partial, %accumulator) : (view<256xf32>, view<256xf32>)
  channel.release %read : read<tile<256xf32>>
  func.return %write : write<tile<256xf32>>
}

// The caller supplies an initialized accumulator and its unpublished write.
// A runtime number of contributions updates it before one final publication.
// The write crosses both a loop recurrence and a retained function boundary.
pipeline.def @reduce_partials() run(%partials: channel<tile<256xf32>>, %output_write: write<tile<256xf32>>, %accumulator: view<256xf32>, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %finished = scf.for %i = [%c0 to %count step %c1](%write = %output_write : write<tile<256xf32>>) -> (write<tile<256xf32>>) {
    %updated = func.call @accumulate(%partials, %write, %accumulator) : (channel<tile<256xf32>>, write<tile<256xf32>>, view<256xf32>) -> (write<tile<256xf32>>)
    scf.yield %updated : write<tile<256xf32>>
  }
  channel.publish %finished : write<tile<256xf32>>
  pipeline.finish
}

// ----
CHECK: func.def noinline @accumulate(*) -> (write<tile<256xf32>>) {
CHECK: channel.release %read : read<tile<256xf32>>
CHECK: func.return %write : write<tile<256xf32>>
CHECK: pipeline.def @reduce_partials() run(*) {
CHECK: %updated = func.call @accumulate(*)
CHECK: channel.publish %finished : write<tile<256xf32>>
CHECK: pipeline.finish
CHECK-NOT: *scf.*

// ====

// RUN: with-checks pass scf-to-cfg,ownership-lifetime

// Admission need not wait for payload readiness. The pending input is passed
// around the loop; copy owns its read while transport waits and forwards it.
// The zero-iteration path releases the supplied read without forwarding.
pipeline.def @forward_records() run(%initial: read<tile<256xf32>>, %incoming: channel<tile<256xf32>>, %outgoing: channel<tile<256xf32>>, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %last = scf.for %i = [%c0 to %count step %c1](%pending = %initial : read<tile<256xf32>>) -> (read<tile<256xf32>>) {
    %write, %destination = channel.reserve %outgoing : channel<tile<256xf32>> -> (write<tile<256xf32>>, view<256xf32>)
    channel.copy %pending -> %write : read<tile<256xf32>>, write<tile<256xf32>>
    %next = channel.accept %incoming : channel<tile<256xf32>> -> read<tile<256xf32>>
    scf.yield %next : read<tile<256xf32>>
  }
  channel.release %last : read<tile<256xf32>>
  pipeline.finish
}

// ----
CHECK: pipeline.def @forward_records() run(*) {
CHECK: channel.copy %pending -> %write : read<tile<256xf32>>, write<tile<256xf32>>
CHECK: %next = channel.accept %incoming : channel<tile<256xf32>> -> read<tile<256xf32>>
CHECK: channel.release %last : read<tile<256xf32>>
CHECK: pipeline.finish
CHECK-NOT: *scf.*

// ====

// RUN: pass ownership-lifetime

// Finishing a pipeline does not silently discard an invocation-owned read.
pipeline.def @unreleased_input() run(%read: read<tile<256xf32>>) {
  // ERROR@+1: DOMINANCE/014 {phase_name="ownership-lifetime", value_name="read"}
  pipeline.finish
}

// ====

// RUN: pass ownership-lifetime

pipeline.def @retired_input() run(%read: read<tile<256xf32>>) {
  channel.release %read : read<tile<256xf32>>
  // ERROR@+1: DOMINANCE/012 {phase_name="ownership-lifetime", value_name="read", op_name="channel.wait"}
  %payload = channel.wait %read : read<tile<256xf32>> -> view<256xf32>
  pipeline.finish
}
