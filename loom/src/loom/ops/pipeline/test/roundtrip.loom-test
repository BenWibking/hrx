// RUN: roundtrip

func.def @product(%lhs: buffer, %rhs: buffer, %partial: buffer) {
  func.return
}

func.def @reduce(%partial0: buffer, %partial1: buffer, %bias: buffer, %output: buffer) {
  func.return
}

pipeline.def<kernel> public @split_k() run(%lhs: buffer, %rhs: buffer, %bias: buffer, %output: buffer) {
  %product_lanes = index.constant 2 : index
  %reducer_lanes = index.constant 1 : index
  %ring_capacity = index.constant 2 : index
  %base = index.constant 0 : offset
  %products = group.create %product_lanes : index -> group<[%product_lanes]>
  %reducers = group.create %reducer_lanes : index -> group<[%reducer_lanes]>
  %lhs_view = buffer.view %lhs[%base] : buffer -> view<2x4x8x8xi8>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<2x4x8x8xi8>
  %bias_view = buffer.view %bias[%base] : buffer -> view<8x8xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<8x8xi32>
  %lhs_tiles = pipeline.scatter %lhs_view across %products : view<2x4x8x8xi8>, group<[%product_lanes]> -> pipeline.flow<tile<8x8xi8>>
  %rhs_tiles = pipeline.scatter %rhs_view across %products : view<2x4x8x8xi8>, group<[%product_lanes]> -> pipeline.flow<tile<8x8xi8>>
  %bias_tiles = pipeline.read %bias_view on %reducers : view<8x8xi32>, group<[%reducer_lanes]> -> pipeline.flow<tile<8x8xi32>>
  %partials = pipeline.stage @product on %products(%lhs_tiles, %rhs_tiles) : (group<[%product_lanes]>, pipeline.flow<tile<8x8xi8>>, pipeline.flow<tile<8x8xi8>>) -> (pipeline.flow<tile<8x8xi32>>)
  %folded = pipeline.fold<addi> %partials : pipeline.flow<tile<8x8xi32>>
  %buffered = pipeline.buffer %folded capacity %ring_capacity : (pipeline.flow<tile<8x8xi32>>, index) -> pipeline.flow<tile<8x8xi32>>
  %result = pipeline.reduce @reduce from %products(%buffered) to %reducers(%bias_tiles) : (group<[%product_lanes]>, pipeline.flow<tile<8x8xi32>>) to (group<[%reducer_lanes]>, pipeline.flow<tile<8x8xi32>>) -> (pipeline.flow<tile<8x8xi32>>)
  pipeline.write %result to %output_view : pipeline.flow<tile<8x8xi32>>, view<8x8xi32>
}

// ====

// Specialization fixes record tiling independently of runtime work count.
pipeline.def @stream(%width: index) run(%input: channel<tile<[%width]xf32>>, %output: channel<tile<[%width]xf32>>, %scratch: view<[%width]xf32>, %count: index) {
}

// ====

// Owned invocation arguments are capabilities, not encoded buffer pointers.
pipeline.def @transfer() run(%source: read<tile<256xf32>>, %destination: write<tile<256xf32>>) {
  channel.copy %source -> %destination : read<tile<256xf32>>, write<tile<256xf32>>
}

// ====

// Dependent capture types retain the lexical width. No synthesized rank or
// duplicate capture signature is needed at the strand boundary.
func.decl @process(%width: index, %input: channel<tile<[%width]xi32>>, %count: index)

pipeline.def @placed(%column: index, %width: index) run(%input: channel<tile<[%width]xi32>>, %count: index) {
  pipeline.strand workers([%column, 2], [1, 1], [1, 1]) {
    func.call @process(%width, %input, %count) : (index, channel<tile<[%width]xi32>>, index)
  }
}

// ====

// Composition carries specialization operands separately from invocation
// bindings while retaining dependent channel types across text and bytecode.
pipeline.def @consume(%width: index) run(%input: channel<tile<[%width]xi32>>) {
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %read, %payload = channel.acquire %input : channel<tile<[%width]xi32>> -> (read<tile<[%width]xi32>>, view<[%width]xi32>)
    channel.release %read : read<tile<[%width]xi32>>
  }
}

pipeline.def @parent(%width: index) run(%input: channel<tile<[%width]xi32>>) {
  pipeline.compose @consume[%width](%input) : [index](channel<tile<[%width]xi32>>)
}

// ====

// Pool selection belongs to one invocation and uses mixed static/SSA worker
// coordinates. The allocation and its channel retain independent identities.
pipeline.def<kernel> @local_storage(%column: index) run() {
  %memory = pipeline.memory<workgroup>[%column, 3] : pool
  %bytes = index.constant 128 : offset
  %buffer = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %offset = index.constant 0 : offset
  %slots = buffer.view %buffer[%offset] : buffer -> view<2x16xi32>
  %capacity = index.constant 2 : index
  %channel = channel.bind<fifo> %slots, %capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([%column, 2], [1, 1], [1, 1]) {
    %write, %payload = channel.reserve %channel : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    channel.publish %write : write<tile<16xi32>>
  }
}
