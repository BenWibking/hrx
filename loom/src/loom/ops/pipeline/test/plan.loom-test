// RUN: emit pipeline-plan @matching_records max-instances=2

func.decl @copy(%input: buffer, %output: buffer)

pipeline.def<kernel> @matching_records() run(%input: buffer, %output: buffer) {
  %lanes = index.constant 2 : index
  %base = index.constant 0 : offset
  %workers = group.create %lanes : index -> group<[%lanes]>
  %input_view = buffer.view %input[%base] : buffer -> view<2x1x3x4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<2x1x3x4xi32>
  %input_flow = pipeline.scatter %input_view across %workers : view<2x1x3x4xi32>, group<[%lanes]> -> pipeline.flow<tile<4xi32>>
  %output_flow = pipeline.stage @copy on %workers(%input_flow) : (group<[%lanes]>, pipeline.flow<tile<4xi32>>) -> (pipeline.flow<tile<4xi32>>)
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<4xi32>>, view<2x1x3x4xi32>
  pipeline.finish
}

// ====

// RUN: emit pipeline-plan @non_buffer_binding max-instances=2

// The source signature is valid. This flow-graph realization requires buffer
// endpoints and cannot reinterpret a typed argument as a runtime buffer.

// ERROR@+1: TYPE/003 {operand_name="run argument 0", actual_type="i32", expected_constraint="buffer for the flow-graph ABI"}
pipeline.def @non_buffer_binding() run(%binding: i32) {
  pipeline.finish
}

