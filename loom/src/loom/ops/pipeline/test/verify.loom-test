}

// ====

func.def @one_buffer(%input: buffer) {
  func.return
}

pipeline.def @stage_wrong_arity() run(%input: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group<[%worker_lanes]>
  %input_view = buffer.view %input[%base] : buffer -> view<8xi8>
  %input_tiles = pipeline.read %input_view on %workers : view<8xi8>, group<[%worker_lanes]> -> pipeline.flow<tile<8xi8>>
  // ERROR@+1: STRUCTURE/013 "entry argument" "1" "stage flow" "2"
  %output_tiles = pipeline.stage @one_buffer on %workers(%input_tiles) : (group<[%worker_lanes]>, pipeline.flow<tile<8xi8>>) -> (pipeline.flow<tile<8xi8>>)
  pipeline.finish
}

// ====

pipeline.def @write_wrong_shape() run(%input: buffer, %output: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group<[%worker_lanes]>
  %input_view = buffer.view %input[%base] : buffer -> view<8xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<4xi8>
  %tiles = pipeline.read %input_view on %workers : view<8xi8>, group<[%worker_lanes]> -> pipeline.flow<tile<8xi8>>
  // ERROR@+1: TYPE/003 {operand_name="source", actual_type="pipeline.flow<tile<8xi8>>", expected_constraint="pipeline.flow tile matching a target view suffix"}
  pipeline.write %tiles to %output_view : pipeline.flow<tile<8xi8>>, view<4xi8>
  pipeline.finish
}

// ====

pipeline.def @fold_wrong_combining_domain() run(%input: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group<[%worker_lanes]>
  %input_view = buffer.view %input[%base] : buffer -> view<4x8xi8>
  %tiles = pipeline.read %input_view on %workers : view<4x8xi8>, group<[%worker_lanes]> -> pipeline.flow<tile<8xi8>>
  // ERROR@+1: TYPE/003 {operand_name="source", actual_type="pipeline.flow<tile<8xi8>>", expected_constraint="floating-point tile element type for fold kind"}
  %folded = pipeline.fold<addf> %tiles : pipeline.flow<tile<8xi8>>
  pipeline.finish
}

// ====

pipeline.def @fold_integer_fastmath() run(%input: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group<[%worker_lanes]>
  %input_view = buffer.view %input[%base] : buffer -> view<4x8xi8>
  %tiles = pipeline.read %input_view on %workers : view<4x8xi8>, group<[%worker_lanes]> -> pipeline.flow<tile<8xi8>>
  // ERROR@+1: TYPE/003 {operand_name="source", actual_type="pipeline.flow<tile<8xi8>>", expected_constraint="floating-point tile element type when float flags are present"}
  %folded = pipeline.fold<addi, reassoc> %tiles : pipeline.flow<tile<8xi8>>
  pipeline.finish
}

// ====

// A reusable command product is authored with command.program.def; pipeline
// scope names the directly loadable kernel artifact boundary.
// ERROR@+1: PARSE/017 "scope" "command"
pipeline.def<command> @unsupported_command_scope() run() {
  pipeline.finish
}

// ====

pipeline.def @place_requires_groups(%columns: index, %tiles: group<4>) run() {
  // ERROR@+1: TYPE/003 {operand_name="logical_group", actual_type="index", expected_constraint="group"}
  %placement = pipeline.place<cyclic> %columns, %tiles : index, group<4> -> pipeline.placement<index, group<4>>
  pipeline.finish
}

// ====

pipeline.def @place_result_matches_groups(%columns: group<8>, %tiles: group<4>) run() {
  // ERROR@+1: TYPE/004 {result_name="result", actual_type="pipeline.placement<group<4>, group<8>>", expected_constraint="pipeline.placement whose group parameters match its operands"}
  %placement = pipeline.place<cyclic> %columns, %tiles : group<8>, group<4> -> pipeline.placement<group<4>, group<8>>
  pipeline.finish
}

// ====

pipeline.def @execute_requires_assignment(%not_assignment: index) run() {
  // ERROR@+1: TYPE/003 {operand_name="assignment", actual_type="index", expected_constraint="pipeline.placement<group<...>, group<...>>"}
  pipeline.execute %not_assignment() do(%rank: index) {
    pipeline.yield
  }
  pipeline.finish
}

// ====

pipeline.def @execute_requires_rank(%columns: group<8>, %tiles: group<4>) run(%input: channel<tile<16xi32>>) {
  %placement = pipeline.place<cyclic> %columns, %tiles : group<8>, group<4> -> pipeline.placement<group<8>, group<4>>
  // ERROR@+1: TYPE/013 {arg_index="0", arg_type="i32", expected_type="index"}
  pipeline.execute %placement(%input) do(%rank: i32, %endpoint: channel<tile<16xi32>>) {
    pipeline.yield
  }
  pipeline.finish
}

// ====

pipeline.def @execute_matches_captures(%columns: group<8>, %tiles: group<4>) run(%input: channel<tile<16xi32>>) {
  %placement = pipeline.place<cyclic> %columns, %tiles : group<8>, group<4> -> pipeline.placement<group<8>, group<4>>
  // ERROR@+1: TYPE/013 {arg_index="1", arg_type="channel<tile<8xi32>>", expected_type="channel<tile<16xi32>>"}
  pipeline.execute %placement(%input) do(%rank: index, %endpoint: channel<tile<8xi32>>) {
    pipeline.yield
  }
  pipeline.finish
}
