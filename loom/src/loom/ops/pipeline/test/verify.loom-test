  func.return
}

pipeline.def @stage_wrong_arity() run(%input: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group<[%worker_lanes]>
  %input_view = buffer.view %input[%base] : buffer -> view<8xi8>
  %input_tiles = pipeline.read %input_view on %workers : view<8xi8>, group<[%worker_lanes]> -> pipeline.flow<tile<8xi8>>
  // ERROR@+1: STRUCTURE/013 "entry argument" "1" "stage flow" "2"
  %output_tiles = pipeline.stage @one_buffer on %workers(%input_tiles) : (group<[%worker_lanes]>, pipeline.flow<tile<8xi8>>) -> (pipeline.flow<tile<8xi8>>)
  pipeline.finish
}

