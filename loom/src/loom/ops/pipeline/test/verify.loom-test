}

// ====

func.def @copy(%input: buffer, %output: buffer) {
  func.return
}

pipeline.def<kernel> @valid() run(%input: buffer, %output: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group<[%worker_lanes]>
  %input_view = buffer.view %input[%base] : buffer -> view<4x8x8xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<8x8xi8>
  %input_tiles = pipeline.read %input_view on %workers : view<4x8x8xi8>, group<[%worker_lanes]> -> pipeline.flow<tile<8x8xi8>>
  %output_tiles = pipeline.stage @copy on %workers(%input_tiles) : (group<[%worker_lanes]>, pipeline.flow<tile<8x8xi8>>) -> (pipeline.flow<tile<8x8xi8>>)
  %folded = pipeline.fold<addi> %output_tiles : pipeline.flow<tile<8x8xi8>>
  pipeline.write %folded to %output_view : pipeline.flow<tile<8x8xi8>>, view<8x8xi8>
}

// ====

pipeline.def @typed_arguments(%width: index) run(%input: channel<tile<[%width]xf32>>, %scratch: view<[%width]xf32>, %count: index) {
}

// ====

func.def @wrong_group(%input: buffer) {
  func.return
}

pipeline.def @scatter_wrong_group() run(%input: buffer) {
  %base = index.constant 0 : offset
  %not_group = index.constant 1 : index
  %input_view = buffer.view %input[%base] : buffer -> view<1x8xi8>
  // ERROR@+1: TYPE/003 {operand_name="group", actual_type="index", expected_constraint="group"}
  %tiles = pipeline.scatter %input_view across %not_group : view<1x8xi8>, index -> pipeline.flow<tile<8xi8>>
  pipeline.finish
}

// ====

pipeline.def @scatter_wrong_shape() run(%input: buffer) {
  %worker_lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %worker_lanes : index -> group<[%worker_lanes]>
  %input_view = buffer.view %input[%base] : buffer -> view<1x8xi8>
  // ERROR@+1: TYPE/004 {result_name="result", actual_type="pipeline.flow<tile<4xi8>>", expected_constraint="pipeline.flow tile matching the source view suffix"}
  %tiles = pipeline.scatter %input_view across %workers : view<1x8xi8>, group<[%worker_lanes]> -> pipeline.flow<tile<4xi8>>
  pipeline.finish
}

