  %c1 = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %stride = index.add %lane, %c1 : index
  %initial_layout = encoding.layout.strided [%stride, 1] : encoding<layout>
  %result_layout_stride_0 = scf.for %i = [%c0 to %c1 step %c1](%layout_stride_0 = %stride : index) -> (index) {
    %layout = encoding.layout.strided [%layout_stride_0, 1] : encoding<layout>
    scf.yield %layout_stride_0 : index
  }
  %result_layout = encoding.layout.strided [%result_layout_stride_0, 1] : encoding<layout>
  test.use %result_layout : encoding<layout>
  kernel.return
}

