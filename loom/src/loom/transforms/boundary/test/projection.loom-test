    %26 = scalar.constant 0 : i32
    %outer_flag = scalar.cmpi ne, %outer_flag_word, %26 : i32
    scf.condition %outer_flag, %outer_flag_word : i1, i32
  } do(%outer_body_flag_word: i32) {
    %28 = scalar.constant 0 : i32
