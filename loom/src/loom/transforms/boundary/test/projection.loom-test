  %24 = scalar.constant 0 : i32
  %first_result = scalar.cmpi ne, %first_result_word, %24 : i32
  %second_result_word = scf.while(%second_flag_word = %first_result_word : i32) -> (i32) {
    %26 = scalar.constant 0 : i32
    %second_flag = scalar.cmpi ne, %second_flag_word, %26 : i32
    scf.condition %second_flag, %second_flag_word : i1, i32
  } do(%second_body_flag_word: i32) {
    %28 = scalar.constant 0 : i32
    %second_body_flag = scalar.cmpi ne, %second_body_flag_word, %28 : i32
    scf.yield %second_body_flag_word : i32
  }
  %30 = scalar.constant 0 : i32
  %second_result = scalar.cmpi ne, %second_result_word, %30 : i32
  test.use %second_result : i1
  kernel.return
}

// ====

// A uniform result of the first loop stays direct while its divergent sibling
// column is projected. The later loop's divergent flag starts from that uniform
// result, so its initial conversion must read the first loop's replacement
// result rather than the retired original.
// RUN: pass specialize-target-callgraph,project-loop-boundary-representations

test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @replaced_uniform_source() {
  %one = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %divergent = index.cmp ne, %lane, %zero : index
  %enter = scalar.constant true : i1
  %stop = scalar.constant false : i1
  %lane_flag, %uniform_flag = scf.while(%first_lane = %divergent : i1, %first_uniform = %enter : i1) -> (i1, i1) {
    scf.condition %first_uniform, %first_lane, %first_uniform : i1, i1, i1
  } do(%body_lane: i1, %body_uniform: i1) {
    scf.yield %body_lane, %stop : i1, i1
  }
  %second_result = scf.while(%second_flag = %uniform_flag : i1) -> (i1) {
    scf.condition %second_flag, %second_flag : i1, i1
  } do(%second_body_flag: i1) {
    %next = index.cmp ne, %lane, %zero : index
    scf.yield %next : i1
  }
  test.use %lane_flag, %second_result : i1, i1
  kernel.return
}

// ----
test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @replaced_uniform_source() {
  %one = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %divergent = index.cmp ne, %lane, %zero : index
  %enter = scalar.constant true : i1
  %stop = scalar.constant false : i1
  %26 = scalar.constant 1 : i32
  %27 = scalar.constant 0 : i32
  %28 = scf.select %divergent, %26, %27 : i32
  %lane_flag_word, %uniform_flag = scf.while(%first_lane_word = %28 : i32, %first_uniform = %enter : i1) -> (i32, i1) {
    %29 = scalar.constant 0 : i32
    %first_lane = scalar.cmpi ne, %first_lane_word, %29 : i32
    scf.condition %first_uniform, %first_lane_word, %first_uniform : i1, i32, i1
  } do(%body_lane_word: i32, %body_uniform: i1) {
    %31 = scalar.constant 0 : i32
    %body_lane = scalar.cmpi ne, %body_lane_word, %31 : i32
    scf.yield %body_lane_word, %stop : i32, i1
  }
  %33 = scalar.constant 0 : i32
  %lane_flag = scalar.cmpi ne, %lane_flag_word, %33 : i32
  %35 = scalar.constant 1 : i32
  %36 = scalar.constant 0 : i32
  %37 = scf.select %uniform_flag, %35, %36 : i32
  %second_result_word = scf.while(%second_flag_word = %37 : i32) -> (i32) {
    %41 = scalar.constant 0 : i32
    %second_flag = scalar.cmpi ne, %second_flag_word, %41 : i32
    scf.condition %second_flag, %second_flag_word : i1, i32
  } do(%second_body_flag_word: i32) {
    %43 = scalar.constant 0 : i32
    %second_body_flag = scalar.cmpi ne, %second_body_flag_word, %43 : i32
    %next = index.cmp ne, %lane, %zero : index
    %38 = scalar.constant 1 : i32
    %39 = scalar.constant 0 : i32
    %40 = scf.select %next, %38, %39 : i32
    scf.yield %40 : i32
  }
  %45 = scalar.constant 0 : i32
  %second_result = scalar.cmpi ne, %second_result_word, %45 : i32
  test.use %lane_flag, %second_result : i1, i1
  kernel.return
}

// ====

// Projected predicate state and unprojected index state cross both nested
// transport edges together. The condition header and result tuples differ in
// order, so header and result offsets are mapped independently.
// RUN: pass specialize-target-callgraph,project-loop-boundary-representations

test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @mixed_nested_state() {
  %one = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %step = index.constant 1 : index
  %initial = index.cmp ne, %lane, %zero : index
  %outer_count, %outer_result = scf.while(%outer_flag = %initial : i1, %outer_i = %zero : index) -> (index, i1) {
    scf.condition %outer_flag, %outer_i, %outer_flag : i1, index, i1
  } do(%outer_body_i: index, %outer_body_flag: i1) {
    %inner_count, %inner_result = scf.while(%inner_flag = %outer_body_flag : i1, %inner_i = %outer_body_i : index) -> (index, i1) {
      scf.condition %inner_flag, %inner_i, %inner_flag : i1, index, i1
    } do(%inner_body_i: index, %inner_body_flag: i1) {
      %inner_next = index.add %inner_body_i, %step : index
      scf.yield %inner_body_flag, %inner_next : i1, index
    }
    scf.yield %inner_result, %inner_count : i1, index
  }
  test.use %outer_count, %outer_result : index, i1
  kernel.return
}

// ----
test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @mixed_nested_state() {
  %one = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %step = index.constant 1 : index
  %initial = index.cmp ne, %lane, %zero : index
  %37 = scalar.constant 1 : i32
  %38 = scalar.constant 0 : i32
  %39 = scf.select %initial, %37, %38 : i32
  %outer_count, %outer_result_word = scf.while(%outer_flag_word = %39 : i32, %outer_i = %zero : index) -> (index, i32) {
    %40 = scalar.constant 0 : i32
    %outer_flag = scalar.cmpi ne, %outer_flag_word, %40 : i32
    scf.condition %outer_flag, %outer_i, %outer_flag_word : i1, index, i32
  } do(%outer_body_i: index, %outer_body_flag_word: i32) {
    %42 = scalar.constant 0 : i32
    %outer_body_flag = scalar.cmpi ne, %outer_body_flag_word, %42 : i32
    %inner_count, %inner_result_word = scf.while(%inner_flag_word = %outer_body_flag_word : i32, %inner_i = %outer_body_i : index) -> (index, i32) {
      %31 = scalar.constant 0 : i32
      %inner_flag = scalar.cmpi ne, %inner_flag_word, %31 : i32
      scf.condition %inner_flag, %inner_i, %inner_flag_word : i1, index, i32
    } do(%inner_body_i: index, %inner_body_flag_word: i32) {
      %33 = scalar.constant 0 : i32
      %inner_body_flag = scalar.cmpi ne, %inner_body_flag_word, %33 : i32
      %inner_next = index.add %inner_body_i, %step : index
      scf.yield %inner_body_flag_word, %inner_next : i32, index
    }
    %35 = scalar.constant 0 : i32
    %inner_result = scalar.cmpi ne, %inner_result_word, %35 : i32
    scf.yield %inner_result_word, %inner_count : i32, index
  }
  %44 = scalar.constant 0 : i32
  %outer_result = scalar.cmpi ne, %outer_result_word, %44 : i32
  test.use %outer_count, %outer_result : index, i1
  kernel.return
}

// ====

// Counted loops carry the same nested predicate recurrence through positional
// header, body, and result tuples.
// RUN: pass specialize-target-callgraph,project-loop-boundary-representations

test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @nested_counted_predicate() {
  %one = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %steps = index.constant 4 : index
  %initial = index.cmp ne, %lane, %zero : index
  %outer_result = scf.for %outer = [%zero to %steps step %one](%outer_flag = %initial : i1) -> (i1) {
    %inner_result = scf.for %inner = [%zero to %steps step %one](%inner_flag = %outer_flag : i1) -> (i1) {
      %next = index.cmp ult, %inner, %lane : index
      %merged = scalar.xori %inner_flag, %next : i1
      scf.yield %merged : i1
    }
    scf.yield %inner_result : i1
  }
  test.use %outer_result : i1
  kernel.return
}

// ----
test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @nested_counted_predicate() {
  %one = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %steps = index.constant 4 : index
  %initial = index.cmp ne, %lane, %zero : index
  %28 = scalar.constant 1 : i32
  %29 = scalar.constant 0 : i32
  %30 = scf.select %initial, %28, %29 : i32
  %outer_result_word = scf.for %outer = [%zero to %steps step %one](%outer_flag_word = %30 : i32) -> (i32) {
    %31 = scalar.constant 0 : i32
    %outer_flag = scalar.cmpi ne, %outer_flag_word, %31 : i32
    %inner_result_word = scf.for %inner = [%zero to %steps step %one](%inner_flag_word = %outer_flag_word : i32) -> (i32) {
      %24 = scalar.constant 0 : i32
      %inner_flag = scalar.cmpi ne, %inner_flag_word, %24 : i32
      %next = index.cmp ult, %inner, %lane : index
      %merged = scalar.xori %inner_flag, %next : i1
      %21 = scalar.constant 1 : i32
      %22 = scalar.constant 0 : i32
      %23 = scf.select %merged, %21, %22 : i32
      scf.yield %23 : i32
    }
    %26 = scalar.constant 0 : i32
    %inner_result = scalar.cmpi ne, %inner_result_word, %26 : i32
    scf.yield %inner_result_word : i32
  }
  %33 = scalar.constant 0 : i32
  %outer_result = scalar.cmpi ne, %outer_result_word, %33 : i32
  test.use %outer_result : i1
  kernel.return
}
