// ====

// The integrator's rejection flag: an outer counted loop hands its carried
// flag unchanged to an inner retry loop, and no loop condition reads it.
// RUN: pass specialize-target-callgraph,project-loop-boundary-representations

test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @carried_rejection_flag() {
  %one = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %steps = index.constant 4 : index
  %accepted = scalar.constant false : i1
  %retry_first = scalar.constant true : i1
  %last = scf.for %step = [%zero to %steps step %one](%reject = %accepted : i1) -> (i1) {
    %attempt_reject, %attempt_retry = scf.while(%current_reject = %reject : i1, %retry = %retry_first : i1) -> (i1, i1) {
      scf.condition %retry, %current_reject, %retry : i1, i1, i1
    } do(%body_reject: i1, %body_retry: i1) {
      test.use %body_reject : i1
      %again = index.cmp ult, %step, %lane : index
      scf.yield %again, %again : i1, i1
    }
    scf.yield %attempt_reject : i1
  }
  test.use %last : i1
  kernel.return
}

