// ====

// An inner loop starts from the outer loop's projected body argument and the
// outer backedge yields the inner loop's projected result. Both carriers must
// exist before either transport edge is built, so each edge forwards the other
// loop's word directly.
// RUN: pass specialize-target-callgraph,project-loop-boundary-representations

test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @nested_predicate() {
  %one = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%size, %one, %one) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %initial = index.cmp ne, %lane, %zero : index
  %outer_result = scf.while(%outer_flag = %initial : i1) -> (i1) {
    scf.condition %outer_flag, %outer_flag : i1, i1
  } do(%outer_body_flag: i1) {
    %inner_result = scf.while(%inner_flag = %outer_body_flag : i1) -> (i1) {
      scf.condition %inner_flag, %inner_flag : i1, i1
    } do(%inner_body_flag: i1) {
      scf.yield %inner_body_flag : i1
    }
    scf.yield %inner_result : i1
  }
  test.use %outer_result : i1
  kernel.return
}

