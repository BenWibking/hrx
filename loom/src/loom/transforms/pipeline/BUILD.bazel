load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "channel_materialization",
    srcs = ["channel_materialization.c"],
    hdrs = ["channel_materialization.h"],
    deps = [
        "//loom/src/loom/analysis:channel_plan",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/cfg",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/rewrite:rewriter",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "outline",
    srcs = ["outline.c"],
    hdrs = ["outline.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:symbol_map",
        "//loom/src/loom/ops/cfg",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/ops/pipeline",
        "//loom/src/loom/pass:types",
        "//loom/src/loom/rewrite:materialize",
        "//loom/src/loom/rewrite:remap",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/util:walk",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)
