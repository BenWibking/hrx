load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_corpus",
    "loom_target_profile",
    "loom_target_set",
)

package(default_visibility = ["//visibility:public"])

loom_target_profile(
    name = "profile_a",
    family = "fake",
    selector = "a",
)

loom_target_profile(
    name = "profile_b",
    family = "fake",
    selector = "b",
)

loom_target_profile(
    name = "profile_c",
    family = "fake",
    selector = "c",
)

loom_target_set(
    name = "primary_profiles",
    targets = [
        ":profile_a",
        ":profile_b",
    ],
)

loom_target_set(
    name = "all",
    targets = [
        ":primary_profiles",
        ":profile_c",
    ],
)

loom_corpus(
    name = "corpus",
    srcs = [
        "fixture.loom",
        "other.loom",
    ],
    excludes = {
        ":profile_c": {
            "fixture.loom": "Profile C deliberately exercises whole-file exclusion.",
            "other.loom": "Profile C deliberately exercises whole-file exclusion.",
        },
    },
    products = {
        "fixture.loom": "module",
        "other.loom": "module",
    },
    tags = ["manual"],
    targets = [":all"],
    xfails = {
        ":profile_b": {
            "fixture.loom:@unsupported": "TARGET/072",
        },
    },
)

loom_corpus(
    name = "unsupported",
    srcs = [
        "fixture.loom",
        "other.loom",
    ],
    products = {
        "fixture.loom": "kernel",
        "other.loom": "kernel",
    },
    tags = [
        "manual",
        "skip-bazel_to_cmake",
    ],
    targets = [":profile_a"],
)
