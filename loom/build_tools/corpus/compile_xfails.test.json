{
  "version": 1,
  "cases": [
    {
      "name": "accepts all declared diagnostics",
      "run": {
        "tool": "loom-corpus-compile-xfails",
        "args": [
          "--compiler={tool:loom-compile}",
          "--expected-root=@uninlined_call",
          "--expected-diagnostic=TARGET/072",
          "--expected-root=@second_uninlined_call",
          "--expected-diagnostic=TARGET/072",
          "--stamp-output={tmp}/expected.stamp",
          "{srcdir}/testdata/diagnostic_xfails.loom",
          "--pipeline=none",
          "--product=kernel"
        ]
      },
      "stdout": {"empty": true},
      "stderr": {"empty": true},
      "files": [
        {
          "path": "{tmp}/expected.stamp",
          "contains": [
            "@uninlined_call TARGET/072",
            "@second_uninlined_call TARGET/072"
          ]
        }
      ]
    },
    {
      "name": "rejects the wrong diagnostic",
      "run": {
        "tool": "loom-corpus-compile-xfails",
        "args": [
          "--compiler={tool:loom-compile}",
          "--expected-root=@uninlined_call",
          "--expected-diagnostic=TYPE/001",
          "--stamp-output={tmp}/wrong.stamp",
          "{srcdir}/testdata/diagnostic_xfails.loom",
          "--pipeline=none",
          "--product=kernel"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "loom-compile stderr:",
          "TARGET/072",
          "wrong diagnostic: expected TYPE/001, received TARGET/072"
        ]
      },
      "files": [{"path": "{tmp}/wrong.stamp", "exists": false}]
    },
    {
      "name": "detects xpass after an expected failure",
      "run": {
        "tool": "loom-corpus-compile-xfails",
        "args": [
          "--compiler={tool:loom-compile}",
          "--expected-root=@uninlined_call",
          "--expected-diagnostic=TARGET/072",
          "--expected-root=@valid_array",
          "--expected-diagnostic=TARGET/072",
          "--stamp-output={tmp}/xpass.stamp",
          "{srcdir}/testdata/diagnostic_xfails.loom",
          "--pipeline=none",
          "--product=kernel",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11"
        ]
      },
      "exit": 1,
      "stderr": {"contains": ["XPASS", "TARGET/072"]},
      "files": [{"path": "{tmp}/xpass.stamp", "exists": false}]
    },
    {
      "name": "distinguishes a missing root",
      "run": {
        "tool": "loom-corpus-compile-xfails",
        "args": [
          "--compiler={tool:loom-compile}",
          "--expected-root=@renamed",
          "--expected-diagnostic=TARGET/072",
          "--stamp-output={tmp}/missing.stamp",
          "{srcdir}/testdata/diagnostic_xfails.loom",
          "--pipeline=none",
          "--product=kernel"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "loom-compile stderr:",
          "renamed",
          "missing diagnostic:"
        ]
      },
      "files": [{"path": "{tmp}/missing.stamp", "exists": false}]
    }
  ]
}
