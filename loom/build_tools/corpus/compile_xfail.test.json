{
  "version": 1,
  "cases": [
    {
      "name": "accepts the declared diagnostic",
      "run": {
        "tool": "loom-corpus-compile-xfail",
        "args": [
          "--compiler={tool:loom-compile}",
          "--expected-diagnostic=TARGET/072",
          "--stamp-output={tmp}/expected.stamp",
          "{srcdir}/testdata/diagnostic_xfail.loom",
          "--pipeline=none",
          "--product=kernel",
          "--root=uninlined_call"
        ]
      },
      "stdout": {"empty": true},
      "stderr": {"empty": true},
      "files": [
        {
          "path": "{tmp}/expected.stamp",
          "contains": ["TARGET/072"]
        }
      ]
    },
    {
      "name": "rejects the wrong diagnostic",
      "run": {
        "tool": "loom-corpus-compile-xfail",
        "args": [
          "--compiler={tool:loom-compile}",
          "--expected-diagnostic=TYPE/001",
          "--stamp-output={tmp}/wrong.stamp",
          "{srcdir}/testdata/diagnostic_xfail.loom",
          "--pipeline=none",
          "--product=kernel",
          "--root=uninlined_call"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "loom-compile stderr:",
          "TARGET/072",
          "wrong diagnostic: expected TYPE/001, received TARGET/072"
        ]
      },
      "files": [{"path": "{tmp}/wrong.stamp", "exists": false}]
    },
    {
      "name": "detects xpass",
      "run": {
        "tool": "loom-corpus-compile-xfail",
        "args": [
          "--compiler={tool:loom-compile}",
          "--expected-diagnostic=TARGET/072",
          "--stamp-output={tmp}/xpass.stamp",
          "{srcdir}/testdata/diagnostic_xfail.loom",
          "--pipeline=none",
          "--product=kernel",
          "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
          "--root=valid_array"
        ]
      },
      "exit": 1,
      "stderr": {"contains": ["XPASS", "TARGET/072"]},
      "files": [{"path": "{tmp}/xpass.stamp", "exists": false}]
    },
    {
      "name": "distinguishes a missing root",
      "run": {
        "tool": "loom-corpus-compile-xfail",
        "args": [
          "--compiler={tool:loom-compile}",
          "--expected-diagnostic=TARGET/072",
          "--stamp-output={tmp}/missing.stamp",
          "{srcdir}/testdata/diagnostic_xfail.loom",
          "--pipeline=none",
          "--product=kernel",
          "--root=renamed"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "loom-compile stderr:",
          "renamed",
          "missing diagnostic:"
        ]
      },
      "files": [{"path": "{tmp}/missing.stamp", "exists": false}]
    }
  ]
}
