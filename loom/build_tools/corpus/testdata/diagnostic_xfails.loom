low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @valid_array() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %workers = group %one
  %worker = worker %workers, %zero, @valid_core
  %input_binding = binding 0, "read"
  %input_sender = sender %input_binding, 0 : reg<aie2p.array.sender : tile<16xi32>>
  %input_receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %input_channel = channel %input_sender, %input_receiver, %capacity, %records : reg<aie2p.array.channel : tile<16xi32>>
  constrain.location %worker, %zero, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @valid_core() asm {
  return
}
