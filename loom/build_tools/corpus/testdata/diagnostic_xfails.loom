low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @uninlined_call() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @caller
  return
}

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @second_uninlined_call() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @caller
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @caller() asm {
