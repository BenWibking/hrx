load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

RDMA_COMPATIBILITY = ["@platforms//os:linux"] + select({
    "//runtime/config/net:rdma_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

iree_runtime_cc_test(
    name = "transfer_trial_tests",
    srcs = ["backend.cc"],
    target_compatible_with = RDMA_COMPATIBILITY,
    deps = [
        "//runtime/src/iree/async/cts/util:platform_backends",
        "//runtime/src/iree/async/cts/util:test_main",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net/carrier/rdma:factory",
        "//runtime/src/iree/net/cts:transfer_trial_tests",
        "//runtime/src/iree/net/cts:transport_backend",
        "//runtime/src/iree/net/rdma:context",
    ],
)

iree_runtime_cc_test(
    name = "transport_tests",
    srcs = ["backend.cc"],
    target_compatible_with = RDMA_COMPATIBILITY,
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/net/carrier/rdma:factory",
        "//runtime/src/iree/net/cts:transport_backend",
        "//runtime/src/iree/net/cts:transport_tests",
        "//runtime/src/iree/net/rdma:context",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
